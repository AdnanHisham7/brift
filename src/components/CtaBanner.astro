---
---

<section class="relative overflow-hidden bg-navy py-16 sm:py-24 text-on-dark border-t border-navy-line">
  <!-- Subtle background glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(58,70,225,0.25),rgba(255,255,255,0))] pointer-events-none"></div>

  <div class="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8 space-y-8">
    <div class="space-y-4 max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Ready to see your company on Brift?
      </h2>
      <p class="text-base sm:text-lg text-on-dark-muted leading-relaxed">
        Book a walkthrough. We will show your day-to-day workflow — purchases, attendance, approvals and reports — in the product itself.
      </p>
    </div>

    <!-- Single CTA Button -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
      <a
        href="/book-a-demo"
        class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-blue px-8 py-4 text-base font-semibold text-white shadow-lg hover:bg-blue-hover focus-visible:outline-none transition-all active:scale-[0.98]"
      >
        Book a Demo Walkthrough
      </a>
    </div>

    <!-- Direct contact line beneath -->
    <div class="pt-6 border-t border-navy-line/60 flex flex-wrap items-center justify-center gap-6 text-xs text-on-dark-muted">
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4 text-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <a href="tel:+919037532036" class="hover:text-white transition-colors">+91 9037532036</a>
      </span>
      <span class="text-navy-line">•</span>
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4 text-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <a href="mailto:brift.official@gmail.com" class="hover:text-white transition-colors">brift.official@gmail.com</a>
      </span>
    </div>
  </div>
</section>
