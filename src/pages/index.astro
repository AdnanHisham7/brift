      const actSections = acts.map(id => document.getElementById(id)).filter(Boolean);
      if (!actSections.length) return;

      const navItems = document.querySelectorAll('.act-nav-item');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const currentId = entry.target.id;
            navItems.forEach(item => {
              const itemAct = item.getAttribute('data-act-nav');
              const dot = item.querySelector('.act-dot');
              const label = item.querySelector('.act-label');
              if (itemAct === currentId) {
                item.classList.add('text-blue');
                item.classList.remove('text-slate-500');
                if (dot) {
                  dot.className = 'act-dot w-2.5 h-2.5 rounded-full bg-blue ring-4 ring-blue-100 transition-all duration-300 scale-125';
                }
                if (label) {
                  label.classList.remove('hidden');
                }
              } else {
                item.classList.remove('text-blue');
                item.classList.add('text-slate-500');
                if (dot) {
                  dot.className = 'act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300';
                }
                if (label) {
                  label.classList.add('hidden');
                }
              }
            });
          }
        });
      }, {
        rootMargin: '-20% 0px -40% 0px',
        threshold: 0.15
      });

      actSections.forEach(section => observer.observe(section));
    }

    // 8. Lead Demo Form Submission & Startup
    function initializeApp() {
      initMotionAnimations();
      initCounters();
      initStoryNavigator();
      initContinuousMovieAutoPlay();

      const form = document.getElementById('lead-demo-form');
      const successBox = document.getElementById('demo-success-box');
      if (form && successBox) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeApp);
    } else {
      initializeApp();
    }
  </script>
</Layout>
