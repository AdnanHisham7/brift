              (isToday ? 'border border-blue/40 text-blue font-bold bg-blue/5' : 'text-slate-800 bg-slate-50/70 hover:bg-slate-100');
            btn.onclick = (function(dObj) {
              return function() {
                selectedDate = dObj;
                renderCalendar();
                updateSlotDisplay();
              };
            })(cellDate);
          }

          daysGrid.appendChild(btn);
        }
      }

      if (prevMonthBtn) {
        prevMonthBtn.onclick = function() {
          if (browseMonth === 0) {
            browseMonth = 11;
            browseYear--;
          } else {
            browseMonth--;
          }
          renderCalendar();
        };
      }

      if (nextMonthBtn) {
        nextMonthBtn.onclick = function() {
          if (browseMonth === 11) {
            browseMonth = 0;
            browseYear++;
          } else {
            browseMonth++;
          }
          renderCalendar();
        };
      }

      renderCalendar();
      renderSlots();
      updateSlotDisplay();

      // Form Submit Handler
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        if (errorBox) errorBox.classList.add('hidden');

        const nameInput = document.getElementById('demo-name');
        const phoneInput = document.getElementById('demo-phone');
        const emailInput = document.getElementById('demo-email');
        const companyInput = document.getElementById('demo-company');
        const sitesInput = document.getElementById('demo-sites');
        const messageInput = document.getElementById('demo-message');

