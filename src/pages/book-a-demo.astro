---
import Layout from '../layouts/Layout.astro';
import DemoForm from '../components/DemoForm.astro';
---

<Layout
  title="Book a Demo — Brift"
  description="Schedule a 30-minute live walkthrough of Brift. See how purchases, attendance, contractor advances, and reports work live on your active sites."
>
  <div class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28 bg-bg">
    <!-- Subtle gradient moment -->
    <div class="hero-gradient-blob" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left: Context & What to Expect -->
        <div class="lg:col-span-5 space-y-8 pt-4 reveal">
          <div class="space-y-4">
            <span class="inline-block text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3.5 py-1 rounded-full">
              LIVE WALKTHROUGH
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-ink leading-tight">
              See Brift built around your company.
            </h1>
            <p class="text-base sm:text-lg text-muted leading-relaxed">
              We don't do pre-recorded video tours or automated slide shows. In 30 minutes, we will walk you through your exact day-to-day workflow in the live software.
            </p>
          </div>

          <!-- What we'll cover -->
          <div class="rounded-card border border-line bg-white/80 p-6 space-y-4 backdrop-blur-xs shadow-2xs">
            <h2 class="text-xs font-bold uppercase tracking-wider text-ink-2">
              WHAT HAPPENS ON THE CALL
            </h2>
            <ul class="space-y-3.5 text-sm text-ink-2">
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue text-xs font-bold text-white">1</span>
                <span><strong>Your active sites:</strong> We see how many projects you run and how site supervisors currently send data.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue text-xs font-bold text-white">2</span>
                <span><strong>Live purchase & wage flow:</strong> How a site manager uploads a bill or logs daily attendance without internet.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue text-xs font-bold text-white">3</span>
                <span><strong>Verification & statements:</strong> How you approve bills, deduct funds, and export contractor & client statements.</span>
              </li>
            </ul>
          </div>

          <!-- Direct Contact Option -->
          <div class="rounded-card border border-line bg-white/80 p-6 space-y-3 backdrop-blur-xs shadow-2xs">
            <h2 class="text-xs font-bold uppercase tracking-wider text-muted">
              PREFER TO CALL DIRECTLY?
            </h2>
            <p class="text-sm text-ink-2">
              Speak directly with founder Adnan Hisham:
            </p>
            <div class="flex flex-col sm:flex-row gap-4 pt-1">
              <a
                href="tel:+919037532036"
                class="inline-flex items-center gap-2 text-sm font-semibold text-blue hover:text-blue-hover"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>+91 9037532036</span>
              </a>
              <a
                href="mailto:brift.official@gmail.com"
                class="inline-flex items-center gap-2 text-sm font-semibold text-blue hover:text-blue-hover"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>brift.official@gmail.com</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Lead Capture Form -->
        <div class="lg:col-span-7 reveal delay-100">
          <DemoForm />
        </div>
      </div>
    </div>
  </div>
</Layout>
