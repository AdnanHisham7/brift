---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="The Cost of Inaction — Why Fragmented Sites Lose Money | Brift"
  description="Calculate how much money unrecorded contractor advances, untracked material transfers, and spreadsheet drift quietly cost your construction firm."
>
  <!-- Hero Section -->
  <section class="relative pt-16 pb-14 sm:pt-24 sm:pb-20 bg-bg border-b border-line overflow-hidden">
    <div class="hero-gradient-blob" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-amber-700 bg-yellow/30 border border-yellow px-3.5 py-1 rounded-full">
        FINANCIAL LEAKAGE AUDIT
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-tight">
        The hidden cost of running sites on memory.
      </h1>
      <p class="text-lg sm:text-xl text-muted max-w-2xl mx-auto leading-relaxed">
        In construction, profit doesn't disappear in dramatic collapses. It quietly bleeds away in untracked ₹500 bills, remembered advances, and unverified transfers every week.
      </p>
    </div>
  </section>

  <!-- Interactive Financial Leakage Calculator Section -->
  <section class="py-16 sm:py-24 bg-white border-b border-line">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-card-lg border-2 border-line bg-bg p-6 sm:p-12 shadow-elevated reveal">
        <div class="max-w-2xl mx-auto text-center space-y-3 mb-10">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
            Interactive Construction Leakage Calculator
          </h2>
          <p class="text-sm text-muted">
            Select your number of active construction projects to estimate your monthly unrecovered leakage:
          </p>

          <!-- Site Selector Buttons -->
          <div class="pt-4 flex flex-wrap items-center justify-center gap-2.5" id="site-selector-container">
            <button type="button" data-sites="2" class="site-btn px-4 py-2 rounded-xl text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer">2 Sites</button>
            <button type="button" data-sites="4" class="site-btn px-4 py-2 rounded-xl text-sm font-semibold border-2 border-blue bg-blue text-white shadow-xs transition-all cursor-pointer">4 Sites</button>
            <button type="button" data-sites="6" class="site-btn px-4 py-2 rounded-xl text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer">6 Sites</button>
            <button type="button" data-sites="8" class="site-btn px-4 py-2 rounded-xl text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer">8 Sites</button>
            <button type="button" data-sites="12" class="site-btn px-4 py-2 rounded-xl text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer">12+ Sites</button>
          </div>
        </div>

        <!-- Leakage Calculation Breakdown Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
          <!-- Leak 1: Contractor Advances -->
          <div class="rounded-2xl border border-line bg-white p-5 space-y-2 shadow-2xs">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">Contractor Advances & Overpayments</h3>
              <span class="text-xs font-bold text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full" id="loss-contractors">₹60,000 / mo</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Advances given on site without immediate ledger entry. When settlements happen weeks later, claims are based on memory, resulting in double payouts or forgotten deductions.
            </p>
          </div>

          <!-- Leak 2: Material Slippage -->
          <div class="rounded-2xl border border-line bg-white p-5 space-y-2 shadow-2xs">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">Material Slippage & Untracked Moves</h3>
              <span class="text-xs font-bold text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full" id="loss-materials">₹70,000 / mo</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Cement or steel transferred between sites without approval. Stock numbers remain guesswork, leading to surprise shortages and urgent retail-price reorders.
            </p>
          </div>

          <!-- Leak 3: Labor Rounding -->
          <div class="rounded-2xl border border-line bg-white p-5 space-y-2 shadow-2xs">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">Notebook Attendance & Wage Rounding</h3>
              <span class="text-xs font-bold text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full" id="loss-labor">₹36,000 / mo</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Paper muster rolls marked hours after shifts end. Half-days counted as full days, duplicate entries across contractors, and wage creep added to site overheads.
            </p>
          </div>

          <!-- Leak 4: Unbilled Extras -->
          <div class="rounded-2xl border border-line bg-white p-5 space-y-2 shadow-2xs">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">Unbilled Extras & Late Client Billing</h3>
              <span class="text-xs font-bold text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full" id="loss-client">₹80,000 / mo</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Modifications and additional work executed on site without formal client signoff or clear statements. Costs are incurred, but never collected from the client.
            </p>
          </div>
        </div>

        <!-- Total Comparison Banner -->
        <div class="mt-8 rounded-2xl border border-navy-line bg-navy p-6 sm:p-8 text-on-dark shadow-md">
          <div class="flex flex-col lg:flex-row items-center justify-between gap-6 text-center lg:text-left">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-yellow">ESTIMATED QUIET MONEY LEAKAGE</span>
              <div class="mt-2 flex items-baseline justify-center lg:justify-start gap-2">
                <span class="text-4xl sm:text-5xl font-black text-white" id="total-monthly-loss">₹2,46,000</span>
                <span class="text-sm text-on-dark-muted font-medium">/ month</span>
              </div>
              <p class="text-xs text-on-dark-muted mt-1">
                That is <strong class="text-yellow" id="total-annual-loss">~₹29.5 Lakhs every single year</strong> lost to fragmented records across your active sites.
              </p>
            </div>

            <div class="lg:border-l lg:border-navy-line/80 lg:pl-8 space-y-3">
              <div class="text-sm text-on-dark-muted">
                Your one-time Brift investment: <span class="text-white font-bold">Fraction of 1 month's leakage (Quote via Demo)</span>
              </div>
              <div class="inline-block rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-yellow border border-yellow/30">
                ⚡ Recovers its entire investment within the first 14 days of live use.
              </div>
              <div>
                <a
                  href="/book-a-demo"
                  class="inline-flex items-center justify-center w-full rounded-xl bg-blue py-3 px-6 text-sm font-semibold text-white hover:bg-blue-hover transition-all shadow-sm"
                >
                  Plug The Leaks — Book a Walkthrough
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Anatomy of a Site Leak -->
  <section class="py-16 sm:py-24 bg-bg border-b border-line">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <h2 class="text-3xl font-extrabold tracking-tight text-ink">
          Where does the money actually go?
        </h2>
        <p class="text-sm text-muted">
          Real examples from construction firms before they deployed Brift:
        </p>
      </div>

      <div class="space-y-6">
        <div class="rounded-card border border-line bg-white p-6 sm:p-8 space-y-3 reveal">
          <div class="flex items-center gap-2">
            <span class="text-red-500 font-bold text-base">Case #1:</span>
            <h3 class="text-lg font-bold text-ink">The forgotten ₹25,000 contractor advance</h3>
          </div>
          <p class="text-sm text-muted leading-relaxed">
            A site supervisor hands ₹25,000 cash to an electrical subcontractor on site and scribbles it on a paper pad. Three weeks later, the contractor submits their final bill of ₹1,80,000 to the office. The supervisor forgot to notify the accountant. The full ₹1,80,000 is settled via bank transfer. That ₹25,000 cash advance is permanently absorbed by the company.
          </p>
          <div class="rounded-lg bg-blue-soft/50 border border-blue/20 p-3 text-xs text-ink-2 font-medium">
            <strong>How Brift stops this:</strong> Supervisors can only disburse advances from their assigned app wallet. Every cash payout posts instantly to the contractor ledger, automatically deducting from their final bill settlement.
          </div>
        </div>

        <div class="rounded-card border border-line bg-white p-6 sm:p-8 space-y-3 reveal">
          <div class="flex items-center gap-2">
            <span class="text-red-500 font-bold text-base">Case #2:</span>
            <h3 class="text-lg font-bold text-ink">The phantom cement transfer</h3>
          </div>
          <p class="text-sm text-muted leading-relaxed">
            Site A needs 50 bags of cement urgently. A truck collects 50 bags from Site B. Site B's manager remembers, but never records it on paper. When Site B closes its foundation stage, its expenses look ₹20,000 higher than budget. Meanwhile, Site A's bills never reflect the transfer. At audit time, the owner assumes 50 bags were stolen.
          </p>
          <div class="rounded-lg bg-blue-soft/50 border border-blue/20 p-3 text-xs text-ink-2 font-medium">
            <strong>How Brift stops this:</strong> Inter-site transfers require an approval handshake in the app. The moment Site B transfers stock, its monetary value deducts from Site B and posts to Site A.
          </div>
        </div>

        <div class="rounded-card border border-line bg-white p-6 sm:p-8 space-y-3 reveal">
          <div class="flex items-center gap-2">
            <span class="text-red-500 font-bold text-base">Case #3:</span>
            <h3 class="text-lg font-bold text-ink">The uncollected client extra</h3>
          </div>
          <p class="text-sm text-muted leading-relaxed">
            A client visits the site and requests extra concealed plumbing and upgraded electrical points. The site team executes it. Two months later at handover, the owner bills the client for ₹65,000 in extras. The client disputes it: "You never sent me an estimate or a formal approval." With no signed record, the owner gives a 50% discount just to get paid.
          </p>
          <div class="rounded-lg bg-blue-soft/50 border border-blue/20 p-3 text-xs text-ink-2 font-medium">
            <strong>How Brift stops this:</strong> Clients have their own dedicated portal. Expense variations and stage signoffs are approved and e-signed in real time before work proceeds.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CtaBanner />
</Layout>

<script>
  // Dynamic Calculator Logic
  const buttons = document.querySelectorAll('.site-btn');
  const lossContractors = document.getElementById('loss-contractors');
  const lossMaterials = document.getElementById('loss-materials');
  const lossLabor = document.getElementById('loss-labor');
  const lossClient = document.getElementById('loss-client');
  const totalMonthlyLoss = document.getElementById('total-monthly-loss');
  const totalAnnualLoss = document.getElementById('total-annual-loss');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Update button styling
      buttons.forEach((b) => {
        b.classList.remove('border-2', 'border-blue', 'bg-blue', 'text-white', 'shadow-xs');
        b.classList.add('border', 'border-line', 'bg-white', 'text-ink');
      });
      btn.classList.remove('border', 'border-line', 'bg-white', 'text-ink');
      btn.classList.add('border-2', 'border-blue', 'bg-blue', 'text-white', 'shadow-xs');

      const sites = parseInt(btn.getAttribute('data-sites') || '4', 10);

      // Calculations per active site
      const cLoss = sites * 15000;
      const mLoss = sites * 17500;
      const lLoss = sites * 9000;
      const clLoss = sites * 20000;
      const totalMonth = cLoss + mLoss + lLoss + clLoss;
      const totalYearLakhs = (totalMonth * 12) / 100000;

      if (lossContractors) lossContractors.textContent = '₹' + cLoss.toLocaleString('en-IN') + ' / mo';
      if (lossMaterials) lossMaterials.textContent = '₹' + mLoss.toLocaleString('en-IN') + ' / mo';
      if (lossLabor) lossLabor.textContent = '₹' + lLoss.toLocaleString('en-IN') + ' / mo';
      if (lossClient) lossClient.textContent = '₹' + clLoss.toLocaleString('en-IN') + ' / mo';
      if (totalMonthlyLoss) totalMonthlyLoss.textContent = '₹' + totalMonth.toLocaleString('en-IN');
      if (totalAnnualLoss) totalAnnualLoss.textContent = '~₹' + totalYearLakhs.toFixed(1) + ' Lakhs every single year';
    });
  });
</script>
