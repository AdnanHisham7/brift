---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Import all real product screenshots
import spendAnalyticsImg from '../assets/spend-analytics.png';
import materialsStockImg from '../assets/materials-stock.png';
import contractorReportImg from '../assets/contractor-report.png';
import reportsOverviewImg from '../assets/reports-overview.png';
import auditLogImg from '../assets/audit-log.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import receivablesTableImg from '../assets/receivables-table.png';
import storiesUpdatesImg from '../assets/stories-site-updates.png';
import clientPortalImg from '../assets/client-portal.png';

const imageMap: Record<string, ImageMetadata> = {
  'spend-analytics': spendAnalyticsImg,
  'materials-stock': materialsStockImg,
  'contractor-report': contractorReportImg,
  'reports-overview': reportsOverviewImg,
  'audit-log': auditLogImg,
  'admin-dashboard': adminDashboardImg,
  'receivables-table': receivablesTableImg,
  'stories-site-updates': storiesUpdatesImg,
  'client-portal': clientPortalImg,
};

export interface Props {
  eyebrow: string;
  headline: string;
  subhead?: string;
  description: string;
  steps?: Array<{ number: number; title: string; text: string }>;
  bulletPoints?: string[];
  imageKey: string;
  reverse?: boolean;
}

const {
  eyebrow,
  headline,
  subhead,
  description,
  steps = [],
  bulletPoints = [],
  imageKey,
  reverse = false,
} = Astro.props;

const selectedImage = imageMap[imageKey] || spendAnalyticsImg;
---

<div class="py-12 sm:py-16">
  <div class:list={[
    'grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center',
    reverse ? 'lg:flex-row-reverse' : ''
  ]}>
    <!-- Content Column -->
    <div class:list={[
      'lg:col-span-6 space-y-6',
      reverse ? 'lg:order-2' : 'lg:order-1'
    ]}>
      <div>
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full mb-3">
          {eyebrow}
        </span>
        <h3 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
          {headline}
        </h3>
        {subhead && (
          <p class="mt-3 text-lg font-medium text-ink-2">
            {subhead}
          </p>
        )}
      </div>

      <p class="text-base text-muted leading-relaxed">
        {description}
      </p>

      <!-- Steps List (if provided) -->
      {steps.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          {steps.map((step) => (
            <div class="flex items-start gap-3 rounded-xl border border-line bg-white p-3.5 shadow-xs">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue text-xs font-bold text-white">
                {step.number}
              </span>
              <div>
                <h4 class="text-sm font-semibold text-ink">{step.title}</h4>
                <p class="text-xs text-muted mt-0.5 leading-relaxed">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- Bullet Points List (if provided) -->
      {bulletPoints.length > 0 && (
        <ul class="space-y-3 pt-2">
          {bulletPoints.map((point) => (
            <li class="flex items-start gap-3 text-sm text-ink-2 leading-relaxed">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-soft text-blue text-xs mt-0.5">
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Real Screenshot Column -->
    <div class:list={[
      'lg:col-span-6',
      reverse ? 'lg:order-1' : 'lg:order-2'
    ]}>
      <div class="relative overflow-hidden rounded-card-lg border border-line bg-white p-2 shadow-elevated transition-transform hover:-translate-y-1 duration-300">
        <Image
          src={selectedImage}
          alt={`${headline} — Real Brift platform interface`}
          class="w-full h-auto rounded-card object-cover"
          format="webp"
          quality={90}
          loading="lazy"
        />
      </div>
    </div>
  </div>
</div>
