---
import Layout from '../layouts/Layout.astro';
import {
  ArrowRight,
  ArrowDown,
  Check,
  CheckCircle2,
  Clock,
  ShieldCheck,
  Building,
  BarChart3,
  Calendar,
  Lock,
  MessageSquare,
  Mail,
  ChevronLeft,
  ChevronRight,
  ShoppingCart,
  FileCheck2,
  FolderTree,
  Coins,
  Package,
  Users,
  MapPin,
  AlertCircle,
  FileText,
  UserCheck,
  HelpCircle,
  PhoneCall
} from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Brift — Construction Operations Platform Built for Owners"
  description="Connect purchase, verification, site cost, and funds. Brift replaces scattered WhatsApp messages and paper registers with one traceable operational record across all your active sites."
  schemaType="home"
>
  <!-- Background Grid Accent -->
  <div class="fixed inset-0 blueprint-grid opacity-30 pointer-events-none -z-20" aria-hidden="true"></div>

  <!-- SILKY LOAD FADE-IN WRAPPER -->
  <div class="app-load-fade relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-16 sm:pb-24 space-y-24 sm:space-y-32 lg:space-y-40">

    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION: "YOUR CONSTRUCTION COMPANY IS NOT A WHATSAPP GROUP"       -->
    <!-- ========================================================================= -->
    <section id="hero" class="relative pt-4 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left: Value Proposition & Clear Editorial Copy -->
        <div class="lg:col-span-6 space-y-5 sm:space-y-6 text-left">
          
          <div data-motion="fade-up" data-delay="100" class="inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue/10 px-3.5 py-1 text-xs font-semibold text-blue">
            <span class="w-2 h-2 rounded-full bg-blue"></span>
            <span>CONSTRUCTION OPERATIONS BUILT FOR OWNERS</span>
          </div>

          <h1 data-motion="fade-up" data-delay="150" class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-[1.1]">
            Your construction company is <span class="text-blue">not a WhatsApp group.</span>
          </h1>

          <p data-motion="fade-up" data-delay="200" class="text-base sm:text-lg text-muted max-w-xl leading-relaxed">
            Bills, attendance, stock updates, payments and site questions often end up scattered in messages, calls and paper notebooks. Brift connects the site to the office with clarity, accountability, and financial discipline.
          </p>

          <!-- Primary Actions -->
          <div data-motion="fade-up" data-delay="250" class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a
              href="#book-demo"
              class="inline-flex items-center justify-center rounded-xl bg-blue hover:bg-blue-hover text-white px-7 py-3.5 sm:py-4 text-sm sm:text-base font-bold shadow-sm hover:shadow-md transition-all active:scale-98 group cursor-pointer"
            >
              <span>Schedule a Live Demo</span>
              <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
            </a>
            <a
              href="#connected-trail"
              class="inline-flex items-center justify-center rounded-xl bg-white hover:bg-slate-50 border border-line shadow-xs px-5 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-sm font-semibold text-ink transition-all gap-2"
            >
              <span>See How It Works</span>
              <ArrowDown class="w-4 h-4 text-muted animate-bounce" />
            </a>
          </div>

          <!-- Editorial Brand Pillows -->
          <div data-motion="fade-up" data-delay="300" class="pt-4 flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-mono text-muted">
            <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-line bg-white">
              <Check class="w-3.5 h-3.5 text-blue" />
              <span>Multi-Site Visibility</span>
            </span>
            <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-line bg-white">
              <Check class="w-3.5 h-3.5 text-emerald-600" />
              <span>100% Offline Resilience</span>
            </span>
            <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-line bg-white">
              <Check class="w-3.5 h-3.5 text-blue" />
              <span>Zero Jargon</span>
            </span>
          </div>

        </div>

        <!-- Right: Editorial "Before vs After" Comparison UI (Direct from Poster 2 & 3) -->
        <div data-motion="zoom-in" data-delay="200" class="lg:col-span-6 relative">
          <div class="relative rounded-2xl sm:rounded-3xl border border-line bg-white p-5 sm:p-7 shadow-[0_15px_40px_-10px_rgba(14,17,22,0.08)] space-y-6">
            
            <!-- BEFORE vs AFTER Header -->
            <div class="grid grid-cols-2 gap-3 pb-3 border-b border-line">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-slate-100 text-muted">
                  BEFORE
                </span>
                <span class="text-xs text-muted hidden sm:inline">Scattered in messages & calls</span>
              </div>
              <div class="flex items-center justify-end gap-2">
                <span class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-blue/10 text-blue font-bold">
                  AFTER
                </span>
                <span class="text-xs font-semibold text-ink hidden sm:inline">Organized in Brift</span>
              </div>
            </div>

            <!-- BEFORE BLOCK: Realistic WhatsApp & Paper Diary Chaos -->
            <div class="space-y-3 p-3.5 sm:p-4 rounded-xl bg-slate-50 border border-slate-200/80">
              
              <!-- WhatsApp Message Bubble -->
              <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/70 p-3 text-xs space-y-1.5">
                <div class="flex items-center justify-between text-[11px] text-emerald-800 font-medium">
                  <span class="font-bold flex items-center gap-1">
                    <MessageSquare class="w-3 h-3 text-emerald-600" />
                    <span>Site - Kumar</span>
                  </span>
                  <span class="font-mono text-[10px] text-emerald-700/80">10:24 AM</span>
                </div>
                <p class="text-ink font-medium">
                  Cement — 50 bags. Bill attached. Please confirm payment.
                </p>
                <div class="inline-flex items-center gap-2 bg-white/90 border border-emerald-200 px-2 py-1 rounded text-[11px] text-slate-700">
                  <FileText class="w-3.5 h-3.5 text-slate-500" />
                  <span>IMG_4828.jpg (2.4 MB)</span>
                </div>
              </div>

              <!-- Unconnected Slip & Call Log -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 px-1 text-[11px] text-muted">
                <div class="flex items-center gap-1.5">
                  <PhoneCall class="w-3 h-3 text-rose-500" />
                  <span>Missed call: Subcontractor Electrical</span>
                </div>
                <div class="font-mono text-slate-400">
                  Spreadsheet updated 4 days ago
                </div>
              </div>
            </div>

            <!-- TRANSITION ARROW -->
            <div class="flex items-center justify-center -my-2 relative z-10">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-blue text-white shadow-sm font-bold text-xs">
                &darr;
              </span>
            </div>

            <!-- AFTER BLOCK: Clean Brift Traceable Purchase Record (Direct from Poster 2) -->
            <div class="rounded-xl border border-blue/20 bg-blue-soft/30 p-4 sm:p-5 space-y-3.5">
              
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="p-1 rounded-md bg-blue text-white">
                    <ShoppingCart class="w-3.5 h-3.5" />
                  </span>
                  <strong class="text-sm font-bold text-ink">Purchase Record #PR-2026-0143</strong>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold bg-amber-100 text-amber-800 border border-amber-200">
                  Pending Verification
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="p-2.5 rounded-lg bg-white border border-line">
                  <span class="text-muted block text-[10px] font-mono uppercase">Vendor</span>
                  <strong class="text-ink font-semibold block pt-0.5">Sri Laxmi Traders</strong>
                </div>
                <div class="p-2.5 rounded-lg bg-white border border-line">
                  <span class="text-muted block text-[10px] font-mono uppercase">Site Allocated</span>
                  <strong class="text-ink font-semibold block pt-0.5">Greenfield Villas</strong>
                </div>
                <div class="p-2.5 rounded-lg bg-white border border-line">
                  <span class="text-muted block text-[10px] font-mono uppercase">Material & Qty</span>
                  <strong class="text-ink font-semibold block pt-0.5">Cement (50 bags)</strong>
                </div>
                <div class="p-2.5 rounded-lg bg-white border border-line">
                  <span class="text-muted block text-[10px] font-mono uppercase">Total Bill Amount</span>
                  <strong class="text-blue font-bold block pt-0.5">₹18,000.00</strong>
                </div>
              </div>

              <div class="flex items-center justify-between pt-1 border-t border-blue/10 text-[11px] text-muted">
                <span class="flex items-center gap-1.5">
                  <UserCheck class="w-3.5 h-3.5 text-blue" />
                  <span>Recorded by <strong>Rameez K</strong> (Site Supervisor)</span>
                </span>
                <span class="font-mono text-slate-500">10:24 AM Timestamped</span>
              </div>

            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. "WHERE DID THE MONEY GO?" — THE CONNECTED OPERATIONAL TRAIL (POSTER 1)  -->
    <!-- ========================================================================= -->
    <section id="connected-trail" class="relative">
      
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-12 sm:mb-16 space-y-3">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-blue bg-blue/10 border border-blue/20 px-3.5 py-1 rounded-full">
          THE OPERATIONAL TRAIL
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink leading-tight">
          WHERE DID THE MONEY GO?
        </h2>
        <p class="text-base sm:text-lg text-muted leading-relaxed">
          Site expenses are easy to record. Keeping the trail connected is harder. Brift connects purchase, verification, site cost, and funds in one clear flow.
        </p>
      </div>

      <!-- 4 Connected Pipeline Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 relative">
        
        <!-- Step 1: Purchase -->
        <div data-motion="fade-up" data-delay="100" class="rounded-2xl border border-line bg-white p-6 shadow-xs space-y-3 relative">
          <div class="flex items-center justify-between">
            <span class="h-9 w-9 rounded-xl bg-blue/10 text-blue flex items-center justify-center font-bold">
              <ShoppingCart class="w-4 h-4" />
            </span>
            <span class="text-xs font-mono font-bold text-muted">STEP 01</span>
          </div>
          <h3 class="text-lg font-bold text-ink">PURCHASE</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Record all site purchases in one place: vendor details, materials, quantities, unit prices, and photo of the physical delivery challan.
          </p>
          <div class="pt-2 text-xs font-medium text-blue border-t border-slate-100 flex items-center gap-1.5">
            <Check class="w-3.5 h-3.5" />
            <span>Zero lost bills</span>
          </div>
        </div>

        <!-- Step 2: Verification -->
        <div data-motion="fade-up" data-delay="200" class="rounded-2xl border border-line bg-white p-6 shadow-xs space-y-3 relative">
          <div class="flex items-center justify-between">
            <span class="h-9 w-9 rounded-xl bg-blue/10 text-blue flex items-center justify-center font-bold">
              <FileCheck2 class="w-4 h-4" />
            </span>
            <span class="text-xs font-mono font-bold text-muted">STEP 02</span>
          </div>
          <h3 class="text-lg font-bold text-ink">VERIFICATION</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Verify bills, delivered quantities, and approvals before releasing payment. No unverified slips slipped into accounting.
          </p>
          <div class="pt-2 text-xs font-medium text-blue border-t border-slate-100 flex items-center gap-1.5">
            <Check class="w-3.5 h-3.5" />
            <span>Dual-check approval</span>
          </div>
        </div>

        <!-- Step 3: Site Cost -->
        <div data-motion="fade-up" data-delay="300" class="rounded-2xl border border-line bg-white p-6 shadow-xs space-y-3 relative">
          <div class="flex items-center justify-between">
            <span class="h-9 w-9 rounded-xl bg-blue/10 text-blue flex items-center justify-center font-bold">
              <FolderTree class="w-4 h-4" />
            </span>
            <span class="text-xs font-mono font-bold text-muted">STEP 03</span>
          </div>
          <h3 class="text-lg font-bold text-ink">SITE COST</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Map every rupee directly to its specific project, block, and active slab. Stop cross-site budget contamination.
          </p>
          <div class="pt-2 text-xs font-medium text-blue border-t border-slate-100 flex items-center gap-1.5">
            <Check class="w-3.5 h-3.5" />
            <span>Accurate project margin</span>
          </div>
        </div>

        <!-- Step 4: Funds -->
        <div data-motion="fade-up" data-delay="400" class="rounded-2xl border border-line bg-white p-6 shadow-xs space-y-3 relative">
          <div class="flex items-center justify-between">
            <span class="h-9 w-9 rounded-xl bg-blue/10 text-blue flex items-center justify-center font-bold">
              <Coins class="w-4 h-4" />
            </span>
            <span class="text-xs font-mono font-bold text-muted">STEP 04</span>
          </div>
          <h3 class="text-lg font-bold text-ink">FUNDS</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Track whether paid from company bank account or site manager petty cash. Clear settlement trails eliminate Saturday disputes.
          </p>
          <div class="pt-2 text-xs font-medium text-blue border-t border-slate-100 flex items-center gap-1.5">
            <Check class="w-3.5 h-3.5" />
            <span>Full cash flow visibility</span>
          </div>
        </div>

      </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 3. INTERACTIVE PRODUCT WALKTHROUGH (SCROLL CHOREOGRAPHY)                   -->
    <!-- ========================================================================= -->
    <section id="walkthrough" class="relative">
      
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-12 sm:mb-16 space-y-3">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-blue bg-blue/10 border border-blue/20 px-3.5 py-1 rounded-full">
          OPERATIONAL MODULES
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-ink leading-tight">
          Built for Control, Clarity, and Financial Discipline
        </h2>
        <p class="text-sm sm:text-base text-muted">
          Explore how Brift handles daily inventory, gate attendance, approval accountability, and multi-site visibility:
        </p>
      </div>

      <!-- 4 Editorial Modules Grid -->
      <div class="space-y-12 sm:space-y-16">
        
        <!-- MODULE 1: STOCK SHOULD NEVER BE A GUESS (Poster 5) -->
        <div data-motion="fade-up" class="rounded-2xl sm:rounded-3xl border border-line bg-white p-6 sm:p-10 shadow-xs">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <div class="lg:col-span-5 space-y-4 text-left">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-xs font-mono font-bold text-blue bg-blue/10">01 // INVENTORY</span>
                <span class="text-xs font-mono text-muted uppercase">Materials & Stock</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-ink leading-tight">
                Stock should never be a guess.
              </h3>
              <p class="text-sm sm:text-base text-muted leading-relaxed">
                Know what was bought, used, and left on every active project. No more calling three supervisors to find out if you need to order cement bags or TMT steel rods for tomorrow morning.
              </p>
              <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span><strong>Result:</strong> Zero over-ordering. Automatic reorder alerts keep pours on schedule.</span>
              </div>
            </div>

            <!-- UI CARD: Material Inventory Table (Poster 5 exact data) -->
            <div class="lg:col-span-7 rounded-2xl border border-line bg-slate-50/60 p-4 sm:p-6 shadow-xs space-y-4">
              <div class="flex items-center justify-between border-b border-line pb-3">
                <div class="flex items-center gap-2">
                  <Package class="w-4 h-4 text-blue" />
                  <strong class="text-sm font-bold text-ink">Material Inventory</strong>
                </div>
                <span class="text-[11px] font-mono text-muted bg-white border border-line px-2.5 py-0.5 rounded">All Sites Live</span>
              </div>

              <!-- Inventory Rows -->
              <div class="space-y-2 text-xs">
                
                <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-line">
                  <div class="space-y-0.5">
                    <strong class="text-ink block font-bold">Cement (50kg)</strong>
                    <span class="text-muted text-[11px]">84 bags in stock</span>
                  </div>
                  <div class="text-right space-y-0.5">
                    <span class="font-mono font-bold text-ink block">₹31,920</span>
                    <span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded">
                      <AlertCircle class="w-3 h-3" />
                      <span>Reorder: 25 bags left</span>
                    </span>
                  </div>
                </div>

                <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-line">
                  <div class="space-y-0.5">
                    <strong class="text-ink block font-bold">TMT Steel Rod (12mm)</strong>
                    <span class="text-muted text-[11px]">1,250 kg in stock</span>
                  </div>
                  <div class="text-right space-y-0.5">
                    <span class="font-mono font-bold text-ink block">₹62,500</span>
                    <span class="text-[11px] text-muted font-mono">Min 200 kg</span>
                  </div>
                </div>

                <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-line">
                  <div class="space-y-0.5">
                    <strong class="text-ink block font-bold">Bricks (1000 nos)</strong>
                    <span class="text-muted text-[11px]">3,600 pcs in stock</span>
                  </div>
                  <div class="text-right space-y-0.5">
                    <span class="font-mono font-bold text-ink block">₹21,600</span>
                    <span class="text-[11px] text-muted font-mono">Min 1,000 pcs</span>
                  </div>
                </div>

                <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-line">
                  <div class="space-y-0.5">
                    <strong class="text-ink block font-bold">M Sand (Aggregates)</strong>
                    <span class="text-muted text-[11px]">4.5 m³ in stock</span>
                  </div>
                  <div class="text-right space-y-0.5">
                    <span class="font-mono font-bold text-ink block">₹9,000</span>
                    <span class="text-[11px] text-muted font-mono">Min 1.5 m³</span>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>

        <!-- MODULE 2: ATTENDANCE SHOULD DO MORE THAN MARK A DAY (Poster 6) -->
        <div data-motion="fade-up" class="rounded-2xl sm:rounded-3xl border border-line bg-white p-6 sm:p-10 shadow-xs">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <div class="lg:col-span-5 space-y-4 text-left">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-xs font-mono font-bold text-blue bg-blue/10">02 // LABOUR</span>
                <span class="text-xs font-mono text-muted uppercase">Wage Cost Mapping</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-ink leading-tight">
                Attendance should do more than mark a day.
              </h3>
              <p class="text-sm sm:text-base text-muted leading-relaxed">
                Record the work. Connect the cost. Instead of taking attendance in a paper notebook and calculating wages separately on Saturdays, Brift links gate muster directly to wage cost and project budget.
              </p>
              <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span><strong>Result:</strong> Zero ghost labour. Works 100% offline in basements with zero mobile coverage.</span>
              </div>
            </div>

            <!-- UI CARD: Attendance & Wage Calculation (Poster 6 exact data) -->
            <div class="lg:col-span-7 rounded-2xl border border-line bg-slate-50/60 p-4 sm:p-6 shadow-xs space-y-4">
              <div class="flex items-center justify-between border-b border-line pb-3">
                <div class="flex items-center gap-2">
                  <Users class="w-4 h-4 text-blue" />
                  <strong class="text-sm font-bold text-ink">Gate Attendance & Wage Slip</strong>
                </div>
                <span class="text-[11px] font-mono text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded font-bold">
                  Gate Locked
                </span>
              </div>

              <div class="space-y-3 text-xs">
                
                <div class="grid grid-cols-2 gap-2.5">
                  <div class="p-3 rounded-xl bg-white border border-line">
                    <span class="text-muted block text-[10px] font-mono uppercase">Worker</span>
                    <strong class="text-ink font-semibold block pt-0.5">Rahul (Mason - Skilled)</strong>
                  </div>
                  <div class="p-3 rounded-xl bg-white border border-line">
                    <span class="text-muted block text-[10px] font-mono uppercase">Site</span>
                    <strong class="text-ink font-semibold block pt-0.5">Tower A - Block 1</strong>
                  </div>
                </div>

                <div class="p-3.5 rounded-xl bg-white border border-line flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                      <Check class="w-3.5 h-3.5" />
                    </span>
                    <div>
                      <strong class="text-ink block font-bold">Full Day Present</strong>
                      <span class="text-muted text-[11px]">Timestamped 07:15 AM at gate</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="text-muted block text-[10px] font-mono uppercase">Calculated Wage</span>
                    <strong class="text-blue font-bold font-mono text-sm">₹600.00</strong>
                  </div>
                </div>

                <div class="p-3.5 rounded-xl bg-blue/5 border border-blue/20 flex items-center justify-between">
                  <div>
                    <span class="text-[10px] font-mono uppercase tracking-wider text-muted block">Daily Site Cost Roll-Up</span>
                    <strong class="text-ink text-sm font-bold">Total Gate Attendance Cost: 18 Workers</strong>
                  </div>
                  <strong class="text-ink font-mono font-extrabold text-base">₹18,400.00</strong>
                </div>

              </div>
            </div>

          </div>
