---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroTransparentImg from '../assets/hero-phone-transparent.png';
import spendImg from '../assets/spend-analytics.png';
import materialsImg from '../assets/materials-stock.png';
import contractorImg from '../assets/contractor-report.png';
import reportsImg from '../assets/reports-overview.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import storiesImg from '../assets/stories-site-updates.png';
---

<Layout
  title="Brift — A Single Hub for Every Site"
  description="A cinematic operating system for construction companies ready to replace spreadsheets, WhatsApp groups and guesswork with one reliable view of every site, rupee and worker."
  schemaType="home"
>
  <!-- FLOATING LIGHT CINEMATIC DIRECTOR'S HUD / VIDEO CONTROLLER -->
  <aside
    id="cinema-hud"
    class="fixed bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-3xl rounded-full bg-white/92 backdrop-blur-xl border border-slate-200/90 shadow-[0_12px_40px_rgba(15,23,42,0.12)] px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between transition-all duration-300"
    aria-label="Story Navigation HUD"
  >
    <!-- Left: Telemetry & Timecode -->
    <div class="flex items-center gap-3">
      <span class="flex h-2.5 w-2.5 rounded-full bg-red-500 animate-ping"></span>
      <div class="font-mono text-[11px] sm:text-xs">
        <span class="text-red-600 font-bold tracking-wider">LIVE</span>
        <span class="text-slate-400 mx-1.5">•</span>
        <span id="hud-timecode" class="text-slate-900 font-semibold">00:00:15</span>
      </div>
      <span class="hidden md:inline-block text-[11px] font-mono text-slate-500 border-l border-slate-200 pl-3" id="hud-scene-title">
        ACT 01 // THE STAKES
      </span>
    </div>

    <!-- Center: Interactive Chapter Markers -->
    <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Story Chapters">
      <button
        type="button"
        class="film-hud-dot is-active h-2 sm:h-2.5 w-7 rounded-full bg-blue transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-1"
        title="Act 1: The Stakes"
        aria-label="Jump to Act 1: The Stakes"
        onclick="jumpToScene('scene-1')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-slate-200 hover:bg-slate-400 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-2"
        title="Act 2: The Crime Scene"
        aria-label="Jump to Act 2: The Crime Scene"
        onclick="jumpToScene('scene-2')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-slate-200 hover:bg-slate-400 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-3"
        title="Act 3: 24h Field Story"
        aria-label="Jump to Act 3: 24-Hour Field Story"
        onclick="jumpToScene('scene-3')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-slate-200 hover:bg-slate-400 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-4"
        title="Act 4: The Cockpit"
        aria-label="Jump to Act 4: The Cockpit"
        onclick="jumpToScene('scene-4')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-slate-200 hover:bg-slate-400 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-5"
        title="Act 5: Profit Radar"
        aria-label="Jump to Act 5: Profit Radar"
        onclick="jumpToScene('scene-5')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-slate-200 hover:bg-slate-400 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-6"
        title="Act 6: Take Command"
        aria-label="Jump to Act 6: Take Command"
        onclick="jumpToScene('scene-6')"
      ></button>
    </nav>

    <!-- Right: Auto-Play Reel Button -->
    <div class="flex items-center gap-2">
      <button
        id="reel-play-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-mono font-bold transition-all cursor-pointer border border-slate-200 active:scale-95"
        onclick="toggleReelAutoScroll()"
      >
        <span id="reel-play-icon">▶</span>
        <span class="hidden sm:inline" id="reel-play-text">PLAY REEL</span>
      </button>
    </div>
  </aside>

  <!-- STACKING CARDS DECK CONTAINER -->
  <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- ========================================== -->
    <!-- SCENE 01 // THE STAKES (ACT I)             -->
    <!-- ========================================== -->
    <section
      id="scene-1"
      class="stacked-card z-10 p-6 sm:p-10 lg:p-14"
    >
      <!-- Atmospheric Pastel Gradient Background Glows -->
      <div class="absolute -top-20 -right-20 w-[500px] h-[500px] bg-blue-100/60 blur-3xl rounded-full pointer-events-none -z-10" aria-hidden="true"></div>
      <div class="absolute -bottom-20 -left-20 w-[450px] h-[450px] bg-amber-100/50 blur-3xl rounded-full pointer-events-none -z-10" aria-hidden="true"></div>

      <!-- Slate Header -->
      <div class="flex items-center justify-between border-b border-slate-200/80 pb-3 mb-8 text-[11px] font-mono tracking-widest text-slate-500">
        <div class="flex items-center gap-2">
          <span class="text-blue font-bold">REEL 01 // ACT I</span>
          <span class="text-slate-300">•</span>
          <span class="text-slate-900 font-bold">THE STAKES</span>
        </div>
        <div class="text-slate-600">CON-OPS OS // V2.4</div>
        <div class="hidden sm:block text-emerald-600 font-bold">TELEMETRY: VERIFIED</div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Left: Narrative -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue-soft px-3.5 py-1.5 text-xs font-semibold text-blue">
            <span class="h-2 w-2 rounded-full bg-blue animate-pulse"></span>
            <span>A SINGLE HUB FOR EVERY SITE</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 leading-[1.08]">
            Stop running ₹50-Crore sites on <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue via-indigo-600 to-amber-600">
              WhatsApp & pocket diaries.
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
            You built a construction business to execute projects and compound wealth. Instead, you're trapped in 45 phone calls a day while ₹2.4 Lakhs quietly leaks every month through unverified receipts, uncounted bags, and lost cash advances.
          </p>

          <!-- Action CTAs -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="#demo"
              class="inline-flex items-center justify-center rounded-xl bg-blue hover:bg-blue-hover text-white px-8 py-4 text-base font-bold shadow-[0_4px_14px_rgba(58,70,225,0.35)] hover:shadow-[0_6px_20px_rgba(58,70,225,0.45)] transition-all active:scale-95 group focus-visible:outline-none"
            >
              <span>Take Command — Book Demo</span>
              <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <button
              type="button"
              class="inline-flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-200/80 px-6 py-4 text-sm font-semibold text-slate-700 transition-all gap-2 cursor-pointer"
              onclick="jumpToScene('scene-2')"
            >
              <span>Scroll to Inspect Leaks</span>
              <span class="animate-bounce">↓</span>
            </button>
          </div>

          <!-- Telemetry Badges -->
          <div class="pt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-xl">
            <div class="rounded-xl border border-slate-200/80 bg-slate-50/80 p-3.5">
              <span class="text-xl font-black text-slate-900 block">~₹29.5L</span>
              <span class="text-[11px] text-slate-500 block leading-tight">Monthly volume tracked per firm</span>
            </div>
            <div class="rounded-xl border border-slate-200/80 bg-slate-50/80 p-3.5">
              <span class="text-xl font-black text-emerald-600 block">100%</span>
              <span class="text-[11px] text-slate-500 block leading-tight">Offline basement sync</span>
            </div>
            <div class="col-span-2 sm:col-span-1 rounded-xl border border-slate-200/80 bg-slate-50/80 p-3.5">
              <span class="text-xl font-black text-amber-600 block">0 Leaks</span>
              <span class="text-[11px] text-slate-500 block leading-tight">No unverified cash movement</span>
            </div>
          </div>
        </div>

        <!-- Right: Floating Cutout Mockup -->
        <div class="lg:col-span-5 relative flex justify-center perspective-container">
          <div class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[420px] animate-float">
            <!-- Gentle shadow halo -->
            <div class="absolute inset-4 bg-gradient-to-tr from-blue/20 via-indigo-200 to-amber-200 blur-2xl rounded-full -z-10" aria-hidden="true"></div>

            <Image
              src={heroTransparentImg}
              alt="Brift Mobile Interface floating cutout with live project cards"
              class="w-full h-auto drop-shadow-[0_20px_30px_rgba(15,23,42,0.18)] select-none"
              loading="eager"
              fetchpriority="high"
              format="webp"
            />

            <!-- Telemetry Overlay Badges -->
            <div class="absolute -top-3 -left-4 sm:-left-6 rounded-2xl border border-slate-200 bg-white/95 p-3.5 shadow-xl backdrop-blur-md max-w-[200px] hidden sm:block">
              <div class="flex items-center gap-2.5">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">✓</span>
                <div>
                  <span class="text-[10px] uppercase font-mono tracking-wider text-slate-500 block">Verified Funds</span>
                  <span class="text-xs font-black text-slate-900 block">₹62,00,000 Locked</span>
                </div>
              </div>
            </div>

            <div class="absolute -bottom-4 -right-4 sm:-right-6 rounded-2xl border border-slate-200 bg-white/95 p-3.5 shadow-xl backdrop-blur-md max-w-[210px]">
              <div class="flex items-center gap-2.5">
                <div class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-ping"></div>
                <div>
                  <span class="text-[10px] uppercase font-mono tracking-wider text-amber-700 block">Site Gate 0 Bars</span>
                  <span class="text-xs font-bold text-slate-900 block">30 Workers Synced</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SCENE 02 // THE CRIME SCENE (ACT II)       -->
    <!-- ========================================== -->
    <section
      id="scene-2"
      class="stacked-card z-20 p-6 sm:p-10 lg:p-14"
    >
      <!-- Slate Header -->
      <div class="flex items-center justify-between border-b border-slate-200/80 pb-3 mb-8 text-[11px] font-mono tracking-widest text-slate-500">
        <div class="flex items-center gap-2">
          <span class="text-red-600 font-bold">REEL 02 // ACT II</span>
          <span class="text-slate-300">•</span>
          <span class="text-slate-900 font-bold">FORENSIC LEAK INSPECTION</span>
        </div>
        <div class="text-red-600 font-bold">ESTIMATED LOSS: -₹2,40,000/MO</div>
      </div>

      <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3 py-1 rounded-full">
          EVIDENCE AUDIT // THE INVISIBLE BLEED
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900">
          Where does ₹2.4 Lakhs quietly vanish every single month?
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Click on any evidence file below to inspect how broken paper habits create silent financial bleeding across your sites.
        </p>
      </div>

      <!-- 4 Forensic Evidence Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Card 1 -->
        <div
          class="evidence-card rounded-2xl border-2 border-slate-200 bg-slate-50/60 p-5 hover:border-red-500 hover:bg-white hover:shadow-lg transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(1)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #01
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹40,000/mo</span>
          </div>
          <h3 class="text-base font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Ghost Labor Register
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Attendance taken on crumpled paper diaries. By Saturday evening, 4 to 6 phantom workers have been added to the payout tally.
          </p>
          <div class="pt-2 border-t border-slate-200 text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div
          class="evidence-card rounded-2xl border-2 border-slate-200 bg-slate-50/60 p-5 hover:border-red-500 hover:bg-white hover:shadow-lg transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(2)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #02
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹80,000/mo</span>
          </div>
          <h3 class="text-base font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Vanishing Cement Challan
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            200 bags billed by the supplier. 170 bags actually unloaded. Delivery challan signed in pencil and lost under a windshield.
          </p>
          <div class="pt-2 border-t border-slate-200 text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <!-- Card 3 -->
        <div
          class="evidence-card rounded-2xl border-2 border-slate-200 bg-slate-50/60 p-5 hover:border-red-500 hover:bg-white hover:shadow-lg transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(3)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #03
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹70,000/mo</span>
          </div>
          <h3 class="text-base font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Pocket Diary Advance
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Site engineer hands out ₹35,000 cash advance to electrical contractor. Written in a pocket notebook, forgotten at final settlement.
          </p>
          <div class="pt-2 border-t border-slate-200 text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <!-- Card 4 -->
        <div
          class="evidence-card rounded-2xl border-2 border-slate-200 bg-slate-50/60 p-5 hover:border-red-500 hover:bg-white hover:shadow-lg transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(4)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #04
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹50,000/mo</span>
          </div>
          <h3 class="text-base font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            Emergency Retail Markups
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Site runs out of binding wire on Thursday. Supervisor rushes to retail hardware store with an 18% markup so labor doesn't stall.
          </p>
          <div class="pt-2 border-t border-slate-200 text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>
      </div>

      <!-- Dynamic Forensic Spotlight Box -->
      <div id="forensic-spotlight" class="mt-6 rounded-2xl border border-blue/30 bg-blue-soft/50 p-5 sm:p-7">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-blue/20 pb-3 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-blue animate-pulse"></span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue" id="spotlight-title">
              CASE FILE #01 // GHOST LABOR RESOLUTION
            </span>
          </div>
          <span class="text-xs font-bold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full">
            Status: Fully Plugged by Brift
          </span>
        </div>
        <p class="text-sm text-slate-700 leading-relaxed" id="spotlight-desc">
          <strong class="text-slate-900">The Brift Closed-Loop:</strong> The site supervisor opens the app at the site gate. Even in a basement with 0 cellular signal, attendance is logged and timestamped with worker categorization (skilled/unskilled). The record locks permanently and syncs to central payroll the second the phone connects to signal. Zero paper registers, zero phantom workers.
        </p>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SCENE 03 // THE 24-HOUR FIELD STORY (ACT III) -->
    <!-- ========================================== -->
    <section
      id="scene-3"
      class="stacked-card z-30 p-6 sm:p-10 lg:p-14"
    >
      <!-- Slate Header & Controls -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 border-b border-slate-200/80 pb-6">
        <div class="space-y-2 max-w-2xl">
          <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-amber-800 bg-amber-100 border border-amber-300 px-3 py-1 rounded-full">
            REEL 03 // ACT III: 24 HOURS ON SITE
          </span>
          <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900">
            Watch a day on your sites unfold.
          </h2>
          <p class="text-sm text-slate-600">
            See how chaotic phone calls and unverified receipts transform into automated, synchronized records.
          </p>
        </div>

        <!-- Controls -->
        <div class="flex items-center gap-3">
          <button
            id="movie-autoplay-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 px-5 py-2.5 text-xs font-mono font-bold shadow-sm transition-all cursor-pointer active:scale-95"
            onclick="toggleMovieAutoPlay()"
          >
            <span id="play-icon">▶</span>
            <span id="play-text">Auto-Play Movie Mode</span>
          </button>
        </div>
      </div>

      <!-- Theater Stage -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Storyboard Narration Card -->
        <div class="lg:col-span-5 space-y-5">
          <!-- Timecode Buttons -->
          <div class="grid grid-cols-2 gap-2" id="movie-scene-buttons">
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border-2 border-amber-400 bg-amber-400 text-slate-950 text-left transition-all cursor-pointer font-mono"
              data-scene="1"
              onclick="showMovieScene(1)"
            >
              07:00 AM • Site Gate
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 text-left hover:border-amber-400 transition-all cursor-pointer font-mono"
              data-scene="2"
              onclick="showMovieScene(2)"
            >
              11:30 AM • Delivery Bay
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 text-left hover:border-amber-400 transition-all cursor-pointer font-mono"
              data-scene="3"
              onclick="showMovieScene(3)"
            >
              03:15 PM • Site Office
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 text-left hover:border-amber-400 transition-all cursor-pointer font-mono"
              data-scene="4"
              onclick="showMovieScene(4)"
            >
              07:30 PM • Living Room
            </button>
          </div>

          <!-- Screenplay Subtitle Card -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 sm:p-7 space-y-4">
            <div class="flex items-center justify-between text-xs font-mono text-amber-800 border-b border-slate-200 pb-3">
              <span id="scene-timecode">TIMECODE: 07:00:00 AM</span>
              <span id="scene-location">LOCATION: SITE GATE</span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-tight" id="scene-headline">
              Muster roll logged without network or ghost labor.
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" id="scene-narration">
              Thirty workers arrive at the gate. Even in a basement with zero cellular bars, the supervisor taps each worker in Brift. Attendance is locked to prevent week-end muster inflation.
            </p>

            <div class="pt-3 border-t border-slate-200 flex items-center justify-between text-xs">
              <span class="text-slate-500">Leak Prevention Status:</span>
              <span class="font-bold text-emerald-700" id="scene-leak-status">✓ Zero Ghost Labor Paid</span>
            </div>
          </div>
        </div>

        <!-- Projector Screen Frame -->
        <div class="lg:col-span-7">
          <div class="rounded-2xl border border-slate-200 bg-slate-100 p-3 sm:p-4 shadow-sm relative overflow-hidden">
            <!-- Screen Ticker HUD -->
