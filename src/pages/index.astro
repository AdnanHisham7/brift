---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroTransparentImg from '../assets/hero-phone-transparent.png';
import spendImg from '../assets/spend-analytics.png';
import materialsImg from '../assets/materials-stock.png';
import contractorImg from '../assets/contractor-report.png';
import reportsImg from '../assets/reports-overview.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import storiesImg from '../assets/stories-site-updates.png';

import {
  ArrowRight,
  ArrowDown,
  Check,
  Clock,
  AlertTriangle,
  TrendingUp,
  ShieldCheck,
  Layers,
  DollarSign,
  PhoneCall,
  MessageSquare,
  Users,
  Truck,
  Lock,
  FileSpreadsheet,
  HardHat,
  Wallet,
  Building,
  CheckCircle2,
  BarChart3,
  FileCheck
} from 'lucide-astro';
---

<Layout
  title="Brift — A Single Hub for Every Site"
  description="A cinematic operating system for construction companies ready to replace spreadsheets, WhatsApp groups and guesswork with one reliable view of every site, rupee and worker."
  schemaType="home"
>
  <!-- BACKGROUND BLUEPRINT ACCENTS -->
  <div class="fixed inset-0 blueprint-grid opacity-35 pointer-events-none -z-20" aria-hidden="true"></div>
  <div class="fixed top-0 right-0 w-[600px] h-[600px] bg-blue-100/50 blur-3xl rounded-full pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="fixed bottom-0 left-0 w-[600px] h-[600px] bg-amber-100/40 blur-3xl rounded-full pointer-events-none -z-10" aria-hidden="true"></div>

  <!-- FLOATING CHAPTER PROGRESS RAIL (DESKTOP) -->
  <aside aria-label="Story Acts Navigation" class="hidden xl:flex fixed right-5 top-1/2 -translate-y-1/2 z-30 flex-col items-end gap-3 bg-white/90 backdrop-blur-md px-3 py-4 rounded-2xl border border-slate-200/90 shadow-md">
    <div class="text-[9px] font-mono font-bold tracking-widest text-slate-400 mb-1 uppercase px-1">STORY ACTS</div>
    <a href="#act-1" data-act-nav="act-1" class="act-nav-item group flex items-center gap-2 text-[11px] font-mono text-slate-500 hover:text-blue transition-colors">
      <span class="act-label hidden group-hover:inline-block font-semibold bg-slate-900 text-white px-2 py-0.5 rounded text-[10px] shadow-sm">01 // Reality Check</span>
      <span class="act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125"></span>
    </a>
    <a href="#act-2" data-act-nav="act-2" class="act-nav-item group flex items-center gap-2 text-[11px] font-mono text-slate-500 hover:text-blue transition-colors">
      <span class="act-label hidden group-hover:inline-block font-semibold bg-slate-900 text-white px-2 py-0.5 rounded text-[10px] shadow-sm">02 // Forensic Audit</span>
      <span class="act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125"></span>
    </a>
    <a href="#act-3" data-act-nav="act-3" class="act-nav-item group flex items-center gap-2 text-[11px] font-mono text-slate-500 hover:text-blue transition-colors">
      <span class="act-label hidden group-hover:inline-block font-semibold bg-slate-900 text-white px-2 py-0.5 rounded text-[10px] shadow-sm">03 // 24-Hour Reel</span>
      <span class="act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125"></span>
    </a>
    <a href="#act-4" data-act-nav="act-4" class="act-nav-item group flex items-center gap-2 text-[11px] font-mono text-slate-500 hover:text-blue transition-colors">
      <span class="act-label hidden group-hover:inline-block font-semibold bg-slate-900 text-white px-2 py-0.5 rounded text-[10px] shadow-sm">04 // Master Overview</span>
      <span class="act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125"></span>
    </a>
    <a href="#act-5" data-act-nav="act-5" class="act-nav-item group flex items-center gap-2 text-[11px] font-mono text-slate-500 hover:text-blue transition-colors">
      <span class="act-label hidden group-hover:inline-block font-semibold bg-slate-900 text-white px-2 py-0.5 rounded text-[10px] shadow-sm">05 // Cockpit Channels</span>
      <span class="act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125"></span>
    </a>
    <a href="#act-6" data-act-nav="act-6" class="act-nav-item group flex items-center gap-2 text-[11px] font-mono text-slate-500 hover:text-blue transition-colors">
      <span class="act-label hidden group-hover:inline-block font-semibold bg-slate-900 text-white px-2 py-0.5 rounded text-[10px] shadow-sm">06 // Profit Loss Radar</span>
      <span class="act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125"></span>
    </a>
    <a href="#act-7" data-act-nav="act-7" class="act-nav-item group flex items-center gap-2 text-[11px] font-mono text-slate-500 hover:text-blue transition-colors">
      <span class="act-label hidden group-hover:inline-block font-semibold bg-slate-900 text-white px-2 py-0.5 rounded text-[10px] shadow-sm">07 // Take Command</span>
      <span class="act-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125"></span>
    </a>
  </aside>

  <!-- MAIN SCROLLING STORYLINE -->
  <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-20 space-y-28 sm:space-y-36">

    <!-- ========================================== -->
    <!-- ACT 01 // THE REALITY CHECK (HERO)        -->
    <!-- ========================================== -->
    <section id="act-1" class="relative pt-6 sm:pt-10">
      <!-- Telemetry Meta Bar -->
      <div data-motion="fade-up" class="flex items-center justify-between border-b border-slate-200/80 pb-3 mb-10 text-[11px] font-mono tracking-widest text-slate-500">
        <div class="flex items-center gap-2">
          <span class="text-blue font-bold">ACT 01 // THE REALITY CHECK</span>
          <span class="text-slate-300">•</span>
          <span class="text-slate-900 font-bold">FIELD OS V2.4</span>
        </div>
        <div class="flex items-center gap-2 text-emerald-700 font-bold">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>LIVE SITE SYNC: ONLINE</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left: Narrative -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div data-motion="fade-up" data-delay="100" class="inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue-soft px-3.5 py-1 text-xs font-semibold text-blue">
            <Layers class="w-3.5 h-3.5 text-blue" />
            <span>A SINGLE HUB FOR EVERY SITE</span>
          </div>

          <h1 data-motion="fade-up" data-delay="150" class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 leading-[1.08]">
            Stop running ₹50-Crore sites on <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue via-indigo-600 to-amber-600">
              scattered chats & pocket diaries.
            </span>
          </h1>

          <p data-motion="fade-up" data-delay="200" class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
            You built a construction company to execute landmark structures and compound wealth. Instead, you're trapped in 45 phone calls a day while ₹2.4 Lakhs quietly leaks every month through paper muster rolls, uncounted bags, and forgotten cash advances.
          </p>

          <!-- Primary Actions -->
          <div data-motion="fade-up" data-delay="250" class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="#demo"
              class="inline-flex items-center justify-center rounded-xl bg-blue hover:bg-blue-hover text-white px-8 py-4 text-base font-bold shadow-[0_4px_14px_rgba(58,70,225,0.35)] hover:shadow-[0_6px_20px_rgba(58,70,225,0.45)] transition-all active:scale-95 group focus-visible:outline-none"
            >
              <span>Take Command — Book Demo</span>
              <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
            </a>
            <a
              href="#act-2"
              class="inline-flex items-center justify-center rounded-xl bg-white hover:bg-slate-50 border border-slate-200/90 shadow-xs px-6 py-4 text-sm font-semibold text-slate-700 transition-all gap-2"
            >
              <span>Inspect The 4 Financial Leaks</span>
              <ArrowDown class="w-4 h-4 text-slate-500 animate-bounce" />
            </a>
          </div>

          <!-- Live Telemetry Badges -->
          <div class="pt-4 grid grid-cols-3 gap-3 max-w-xl">
            <div data-motion="fade-up" data-delay="300" class="motion-card-hover rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
              <span data-counter="29.5" data-format="lakh" class="text-xl sm:text-2xl font-black text-slate-900 block leading-tight">~₹29.5L</span>
              <span class="text-xs text-slate-500 block leading-snug">Monthly volume per firm</span>
            </div>
            <div data-motion="fade-up" data-delay="350" class="motion-card-hover rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
              <span data-counter="100" data-format="percent" class="text-xl sm:text-2xl font-black text-emerald-600 block leading-tight">100%</span>
              <span class="text-xs text-slate-500 block leading-snug">Offline basement sync</span>
            </div>
            <div data-motion="fade-up" data-delay="400" class="motion-card-hover rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
              <span class="text-xl sm:text-2xl font-black text-amber-600 block leading-tight">0 Leaks</span>
              <span class="text-xs text-slate-500 block leading-snug">Zero unverified cash</span>
            </div>
          </div>
        </div>

        <!-- Right: 3D Floating Terminal -->
        <div class="lg:col-span-5 relative flex justify-center perspective-container">
          <div data-motion="zoom-in" data-delay="200" class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[420px] animate-float">
            <!-- Ambient halo -->
            <div class="absolute inset-4 bg-gradient-to-tr from-blue/20 via-indigo-200 to-amber-200 blur-3xl rounded-full -z-10" aria-hidden="true"></div>

            <Image
              src={heroTransparentImg}
              alt="Brift Mobile Interface cutout with live project cards"
              class="w-full h-auto drop-shadow-[0_25px_35px_rgba(15,23,42,0.18)] select-none"
              loading="eager"
              fetchpriority="high"
              format="webp"
            />

            <!-- Floating Telemetry Overlay Badges -->
            <div data-motion="fade-left" data-delay="450" class="absolute -top-3 -left-4 sm:-left-6 rounded-2xl border border-slate-200 bg-white/95 p-3.5 shadow-xl backdrop-blur-md max-w-[210px] hidden sm:block">
              <div class="flex items-center gap-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                  <Check class="w-4 h-4" />
                </span>
                <div>
                  <span class="text-[10px] uppercase font-mono tracking-wider text-slate-500 block">Verified Funds</span>
                  <span class="text-xs font-black text-slate-900 block">₹62,00,000 Locked</span>
                </div>
              </div>
            </div>

            <div data-motion="fade-right" data-delay="550" class="absolute -bottom-4 -right-4 sm:-right-6 rounded-2xl border border-slate-200 bg-white/95 p-3.5 shadow-xl backdrop-blur-md max-w-[220px]">
              <div class="flex items-center gap-2.5">
                <div class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-ping"></div>
                <div>
                  <span class="text-[10px] uppercase font-mono tracking-wider text-amber-700 block">Basement 0 Bars</span>
                  <span class="text-xs font-bold text-slate-900 block">30 Workers Synced</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- ACT 02 // THE INVISIBLE BLEED (CRIME SCENE)-->
    <!-- ========================================== -->
    <section id="act-2" class="relative">
      <!-- Section Header -->
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3.5 py-1 rounded-full">
          ACT 02 // FORENSIC AUDIT
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900">
          Where does ₹2.4 Lakhs quietly vanish every single month?
        </h2>
        <p class="text-base text-slate-600">
          Click on any evidence file below to inspect how manual paper records create silent financial bleeding across your sites:
        </p>
      </div>

      <!-- 4 Forensic Evidence Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Evidence 1 -->
        <div
          data-motion="fade-up"
          data-delay="100"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(1)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <Users class="w-3 h-3" />
              <span>Evidence #01</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹40,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Ghost Labor Register
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Attendance taken on paper notebooks. By Saturday evening, 4 to 6 extra phantom workers have been added to the payout tally.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>

        <!-- Evidence 2 -->
        <div
          data-motion="fade-up"
          data-delay="200"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(2)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <Truck class="w-3 h-3" />
              <span>Evidence #02</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹80,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Vanishing Cement Challan
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            200 bags billed by the supplier. 170 bags actually unloaded. Delivery challan signed in pencil and lost under a windshield.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>

        <!-- Evidence 3 -->
        <div
          data-motion="fade-up"
          data-delay="300"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(3)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <Wallet class="w-3 h-3" />
              <span>Evidence #03</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹70,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Pocket Diary Advance
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Site engineer hands out ₹35,000 cash advance to electrical contractor. Written in a pocket notebook, forgotten at final settlement.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>

        <!-- Evidence 4 -->
        <div
          data-motion="fade-up"
          data-delay="400"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(4)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <AlertTriangle class="w-3 h-3" />
              <span>Evidence #04</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹50,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            Emergency Retail Markups
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Site runs out of binding wire on Thursday. Supervisor rushes to retail hardware store with an 18% markup so labor doesn't stall.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>
      </div>

      <!-- Dynamic Forensic Spotlight Box -->
      <div data-motion="zoom-in" data-delay="150" id="forensic-spotlight" class="mt-8 rounded-3xl border border-blue/30 bg-blue-soft/50 p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-blue/20 pb-4 mb-4">
          <div class="flex items-center gap-2.5">
            <ShieldCheck class="w-5 h-5 text-blue" />
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue" id="spotlight-title">
              CASE FILE #01 // GHOST LABOR RESOLUTION
            </span>
          </div>
          <span class="text-xs font-bold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full flex items-center gap-1">
            <Check class="w-3.5 h-3.5 text-emerald-700" />
            <span>Status: Fully Plugged by Brift</span>
          </span>
        </div>
        <p class="text-sm sm:text-base text-slate-700 leading-relaxed" id="spotlight-desc">
          <strong class="text-slate-900">The Brift Closed-Loop:</strong> The site supervisor opens the app at the site gate. Even in a basement with 0 cellular signal, attendance is logged and timestamped with worker categorization (skilled/unskilled). The record locks permanently and syncs to central payroll the second the phone connects to signal. Zero paper registers, zero phantom workers.
        </p>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- ACT 03 // 24 HOURS ON SITE (TIMELINE REEL) -->
    <!-- ========================================== -->
    <section id="act-3" class="relative">
      <div data-motion="fade-up" class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 border-b border-slate-200/80 pb-6">
        <div class="space-y-2 max-w-2xl">
          <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-amber-800 bg-amber-100 border border-amber-300 px-3.5 py-1 rounded-full">
            ACT 03 // 24-HOUR SITE STORY
          </span>
          <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900">
            Watch a day on your sites unfold.
          </h2>
          <p class="text-base text-slate-600">
            See how chaotic phone calls and unverified receipts transform into automated, synchronized records:
          </p>
        </div>

        <!-- Always-On Auto-Playing Time Indicator -->
        <div class="flex flex-col items-start md:items-end gap-1.5">
          <div class="inline-flex items-center gap-2 rounded-xl bg-slate-100 border border-slate-200 px-4 py-2 text-xs font-mono font-bold text-slate-700 shadow-xs">
            <Clock class="w-3.5 h-3.5 text-amber-600 animate-spin" style="animation-duration: 4s;" />
            <span>NEXT SCENE IN <strong id="reel-countdown" class="text-amber-700 font-black">4s</strong></span>
          </div>
          <!-- Playing Progress Bar Line -->
          <div class="w-44 h-1.5 bg-slate-200 rounded-full overflow-hidden">
            <div id="reel-progress-fill" class="h-full bg-amber-500 rounded-full transition-all duration-100 ease-linear" style="width: 0%;"></div>
          </div>
        </div>
      </div>

      <!-- Theater Stage -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Storyboard Controls -->
        <div data-motion="fade-left" data-delay="150" class="lg:col-span-5 space-y-6">
          <div class="grid grid-cols-2 gap-2.5" id="movie-scene-buttons">
            <button
              type="button"
              class="movie-tab px-4 py-3 rounded-xl text-xs font-bold border-2 border-amber-400 bg-amber-400 text-slate-950 text-left transition-all cursor-pointer font-mono shadow-xs relative overflow-hidden"
              data-scene="1"
              onclick="showMovieScene(1)"
            >
              <div class="flex items-center gap-1.5">
                <Clock class="w-3 h-3 text-slate-900" />
                <span>07:00 AM • Gate Muster</span>
              </div>
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-3 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 text-left hover:border-amber-400 transition-all cursor-pointer font-mono relative overflow-hidden"
              data-scene="2"
              onclick="showMovieScene(2)"
            >
              <div class="flex items-center gap-1.5">
                <Truck class="w-3 h-3 text-slate-500" />
                <span>11:30 AM • Cement Bay</span>
              </div>
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-3 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 text-left hover:border-amber-400 transition-all cursor-pointer font-mono relative overflow-hidden"
              data-scene="3"
              onclick="showMovieScene(3)"
            >
              <div class="flex items-center gap-1.5">
                <Wallet class="w-3 h-3 text-slate-500" />
                <span>03:15 PM • Site Advances</span>
              </div>
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-3 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 text-left hover:border-amber-400 transition-all cursor-pointer font-mono relative overflow-hidden"
              data-scene="4"
              onclick="showMovieScene(4)"
            >
              <div class="flex items-center gap-1.5">
                <BarChart3 class="w-3 h-3 text-slate-500" />
                <span>07:30 PM • Owner Screen</span>
              </div>
            </button>
          </div>

          <!-- Screenplay Narration -->
          <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 space-y-4 shadow-sm">
