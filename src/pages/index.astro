---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroTransparentImg from '../assets/hero-phone-transparent.png';
import spendImg from '../assets/spend-analytics.png';
import materialsImg from '../assets/materials-stock.png';
import contractorImg from '../assets/contractor-report.png';
import reportsImg from '../assets/reports-overview.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import storiesImg from '../assets/stories-site-updates.png';

import {
  ArrowRight,
  ArrowDown,
  Check,
  CheckCircle2,
  Clock,
  AlertTriangle,
  TrendingUp,
  ShieldCheck,
  DollarSign,
  PhoneCall,
  MessageSquare,
  Users,
  Truck,
  Lock,
  FileSpreadsheet,
  HardHat,
  Wallet,
  Building,
  BarChart3,
  FileCheck,
  Calendar,
  Mail
} from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Brift — Construction Operations Platform"
  description="The all-in-one operations platform for construction companies and civil contractors. Track site attendance, material deliveries, contractor advances, and project cash flow in real time."
  schemaType="home"
>
  <!-- Background Blueprint Pattern (Subtle) -->
  <div class="fixed inset-0 blueprint-grid opacity-20 pointer-events-none -z-20" aria-hidden="true"></div>

  <!-- MAIN CONTAINER -->
  <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-16 sm:pb-24 space-y-20 sm:space-y-28 lg:space-y-32">

    <!-- ========================================== -->
    <!-- 1. HERO SECTION                            -->
    <!-- ========================================== -->
    <section id="hero" class="relative pt-4 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        
        <!-- Left: Value Proposition -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-left">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue/10 px-3.5 py-1 text-xs font-semibold text-blue">
            <img src={`${base}/logo-blue.png`} alt="Brift Logo" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
            <span>CONSTRUCTION OPERATIONS PLATFORM</span>
          </div>

          <h1 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.14]">
            Replace scattered site chats and paper registers with <span class="text-blue">one reliable system.</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
            Brift gives civil contractors and builders complete control over daily labor attendance, material delivery challans, subcontractor cash advances, and project cash flow.
          </p>

          <!-- Primary Actions -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a
              href={`${base}/book-demo`}
              class="inline-flex items-center justify-center rounded-xl bg-blue hover:bg-blue-hover text-white px-6 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all active:scale-98 group"
            >
              <span>Book a Product Demo</span>
              <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
            </a>
            <a
              href="#features"
              class="inline-flex items-center justify-center rounded-xl bg-white hover:bg-slate-50 border border-slate-200 shadow-xs px-5 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-sm font-semibold text-slate-700 transition-all gap-2"
            >
              <span>Explore Features</span>
              <ArrowDown class="w-4 h-4 text-slate-500" />
            </a>
          </div>

          <!-- Key Platform Metrics -->
          <div class="pt-4 grid grid-cols-3 gap-3 max-w-lg">
            <div class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-slate-900 block leading-tight">₹29.5L+</span>
              <span class="text-[11px] sm:text-xs text-slate-500 block leading-tight mt-1">Monthly site volume</span>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-emerald-600 block leading-tight">100% Offline</span>
              <span class="text-[11px] sm:text-xs text-slate-500 block leading-tight mt-1">Works without signal</span>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-blue block leading-tight">48 Hours</span>
              <span class="text-[11px] sm:text-xs text-slate-500 block leading-tight mt-1">Site onboarding</span>
            </div>
          </div>
        </div>

        <!-- Right: Mobile App Showcase -->
        <div class="lg:col-span-5 relative flex justify-center pt-4 lg:pt-0">
          <div class="relative w-full max-w-[280px] xs:max-w-[320px] sm:max-w-[360px] lg:max-w-[390px]">
            <!-- Subtle background shadow glow -->
            <div class="absolute inset-4 bg-blue/10 blur-2xl rounded-full -z-10" aria-hidden="true"></div>

            <Image
              src={heroTransparentImg}
              alt="Brift Mobile Interface for Construction Sites"
              class="w-full h-auto drop-shadow-[0_20px_30px_rgba(15,23,42,0.12)] select-none"
              loading="eager"
              fetchpriority="high"
              format="webp"
            />

            <!-- Clean Status Badges -->
            <div class="absolute -top-2 -left-2 sm:-left-4 rounded-xl border border-slate-200 bg-white p-2.5 sm:p-3 shadow-md hidden sm:block">
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                  <Check class="w-3.5 h-3.5" />
                </span>
                <div>
                  <span class="text-[9px] uppercase font-mono tracking-wider text-slate-500 block">Attendance Record</span>
                  <span class="text-xs font-bold text-slate-900 block">Locked & Timestamped</span>
                </div>
              </div>
            </div>

            <div class="absolute -bottom-2 right-0 sm:-right-4 rounded-xl border border-slate-200 bg-white p-2.5 sm:p-3 shadow-md">
              <div class="flex items-center gap-2">
                <div class="h-2 w-2 rounded-full bg-emerald-500"></div>
                <div>
                  <span class="text-[9px] uppercase font-mono tracking-wider text-slate-500 block">Basement Mode</span>
                  <span class="text-xs font-bold text-slate-900 block">0 Signal • Auto-Sync</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- 2. THE 4 COSTLY LEAKS                      -->
    <!-- ========================================== -->
    <section id="leaks" class="relative">
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12 space-y-2.5">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3.5 py-1 rounded-full">
          OPERATIONAL LOSSES
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 leading-tight">
          Where Money Silently Leaks on Construction Sites
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Manual paper records and uncoordinated WhatsApp chats create financial blind spots that cost contractors hundreds of thousands of rupees every month.
        </p>
      </div>

      <!-- 4 Professional Leak Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Leak 1 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs space-y-3 hover:border-slate-300 transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-slate-700 bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
              <Users class="w-3 h-3 text-slate-600" />
              <span>Labor</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">Avg. ₹40k / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900">
            Ghost Labor & Muster Inflation
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Attendance taken on paper notebooks or verbal counts allows extra unverified workers to be added to Saturday wage bills.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Solved: Locked offline muster</span>
          </div>
        </div>

        <!-- Leak 2 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs space-y-3 hover:border-slate-300 transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-slate-700 bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
              <Truck class="w-3 h-3 text-slate-600" />
              <span>Materials</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">Avg. ₹80k / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900">
            Unverified Delivery Challans
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Delivery challans signed without photo verification lead to bills for 200 cement bags when only 170 bags were actually unloaded.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Solved: Gate photo challan match</span>
          </div>
        </div>

        <!-- Leak 3 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs space-y-3 hover:border-slate-300 transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-slate-700 bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
              <Wallet class="w-3 h-3 text-slate-600" />
              <span>Cash</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">Avg. ₹70k / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900">
            Forgotten Pocket Advances
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Site engineers hand out cash advances to trade contractors and record them in pocket diaries, leading to disputes at final billing.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Solved: Auto-deduction ledger</span>
          </div>
        </div>

        <!-- Leak 4 -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs space-y-3 hover:border-slate-300 transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-slate-700 bg-slate-100 px-2 py-0.5 rounded flex items-center gap-1">
              <AlertTriangle class="w-3 h-3 text-slate-600" />
              <span>Purchases</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">Avg. ₹50k / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900">
            Emergency Retail Markups
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Stock shortages on site cause frantic runs to local hardware stores, paying 15-20% retail premiums so labor doesn't sit idle.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Solved: Automated low-stock alerts</span>
          </div>
        </div>
      </div>

      <!-- Clean Summary Callout -->
      <div class="mt-6 sm:mt-8 rounded-2xl border border-blue/20 bg-blue/5 p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <ShieldCheck class="w-6 h-6 text-blue shrink-0" />
          <div>
            <h4 class="text-sm sm:text-base font-bold text-slate-900">Brift stops these leaks automatically at the site gate.</h4>
            <p class="text-xs sm:text-sm text-slate-600">Every worker, challan, and advance is timestamped on mobile and reconciled in central accounts.</p>
          </div>
        </div>
        <a
          href={`${base}/book-demo`}
          class="rounded-xl bg-blue hover:bg-blue-hover text-white text-xs sm:text-sm font-bold px-4 py-2.5 transition-all whitespace-nowrap shrink-0"
        >
          See How It Works
        </a>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- 3. PLATFORM MODULES (FEATURE SHOWCASE)     -->
    <!-- ========================================== -->
    <section id="features" class="relative">
      <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10 space-y-2.5">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-blue bg-blue/10 border border-blue/20 px-3.5 py-1 rounded-full">
          CORE MODULES
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 leading-tight">
          Built for How Real Construction Sites Operate
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Everything your supervisors, site engineers, and project owners need in one connected system:
        </p>

        <!-- Module Selector Tabs -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-2">
          <button
            type="button"
            class="feature-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-blue text-white shadow-xs transition-all cursor-pointer inline-flex items-center gap-2"
            data-feature="attendance"
            onclick="switchFeatureModule('attendance')"
          >
            <Users class="w-4 h-4" />
            <span>Labor & Attendance</span>
          </button>
          <button
            type="button"
            class="feature-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:border-slate-300 transition-all cursor-pointer inline-flex items-center gap-2"
            data-feature="materials"
            onclick="switchFeatureModule('materials')"
          >
            <Truck class="w-4 h-4" />
            <span>Materials & Challans</span>
          </button>
          <button
            type="button"
            class="feature-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:border-slate-300 transition-all cursor-pointer inline-flex items-center gap-2"
            data-feature="advances"
            onclick="switchFeatureModule('advances')"
          >
            <Wallet class="w-4 h-4" />
            <span>Contractor Advances</span>
          </button>
          <button
            type="button"
            class="feature-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:border-slate-300 transition-all cursor-pointer inline-flex items-center gap-2"
            data-feature="finances"
            onclick="switchFeatureModule('finances')"
          >
            <BarChart3 class="w-4 h-4" />
            <span>Project Cash Flow</span>
          </button>
          <button
            type="button"
            class="feature-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:border-slate-300 transition-all cursor-pointer inline-flex items-center gap-2"
            data-feature="roles"
            onclick="switchFeatureModule('roles')"
          >
            <Lock class="w-4 h-4" />
            <span>Role Permissions</span>
          </button>
        </div>
      </div>

      <!-- Feature Content Display -->
      <div class="rounded-2xl sm:rounded-3xl border border-slate-200 bg-white p-5 sm:p-8 shadow-sm">
        
        <!-- Module 1: Attendance -->
        <div id="feature-panel-attendance" class="feature-panel grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <Image
              src={storiesImg}
              alt="Daily attendance and site updates"
              class="w-full h-auto rounded-xl border border-slate-200 shadow-xs object-cover max-h-[380px]"
              format="webp"
            />
          </div>
          <div class="lg:col-span-5 space-y-4 text-left">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-blue">FIELD ATTENDANCE</span>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
              Muster roll logging that works with zero mobile signal.
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Supervisors record skilled and unskilled headcounts at the gate. Records lock permanently with timestamps and automatically sync to central payroll the moment signal connects.
            </p>
            <div class="space-y-2 pt-1 text-xs sm:text-sm text-slate-700">
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>100% offline muster roll entry</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Eliminates Saturday wage inflation disputes</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Linked directly to contractor measurement sheets</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 2: Materials -->
        <div id="feature-panel-materials" class="feature-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <Image
              src={materialsImg}
              alt="Materials stock ledger and delivery intake"
              class="w-full h-auto rounded-xl border border-slate-200 shadow-xs object-cover max-h-[380px]"
              format="webp"
            />
          </div>
          <div class="lg:col-span-5 space-y-4 text-left">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-blue">MATERIAL VERIFICATION</span>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
              Verified intake photos before any materials are unloaded.
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Supervisors photograph physical delivery challans upon truck arrival. Quantities are instantly logged against approved purchase orders, stopping duplicate and inflated bills.
            </p>
            <div class="space-y-2 pt-1 text-xs sm:text-sm text-slate-700">
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Photographic proof of unloaded cement and steel</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Live site inventory thresholds & low-stock alerts</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Eliminates expensive emergency retail purchases</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 3: Advances -->
        <div id="feature-panel-advances" class="feature-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <Image
              src={contractorImg}
              alt="Contractor ledger and advance settlement"
              class="w-full h-auto rounded-xl border border-slate-200 shadow-xs object-cover max-h-[380px]"
              format="webp"
            />
          </div>
          <div class="lg:col-span-5 space-y-4 text-left">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-blue">ADVANCE SETTLEMENTS</span>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
              Instant cash advance tracking with automated deductions.
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Every cash advance handed out on site is recorded in real time with timestamp and contractor name. At final measurement billing, advances are automatically subtracted from payouts.
            </p>
            <div class="space-y-2 pt-1 text-xs sm:text-sm text-slate-700">
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Zero forgotten pocket diary advances</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Shared statement eliminates subcontractor disputes</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Saturday payment calculation in minutes, not hours</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 4: Finances -->
        <div id="feature-panel-finances" class="feature-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <Image
              src={spendImg}
              alt="Project cash flow and spend analytics"
              class="w-full h-auto rounded-xl border border-slate-200 shadow-xs object-cover max-h-[380px]"
              format="webp"
            />
          </div>
          <div class="lg:col-span-5 space-y-4 text-left">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-blue">FINANCIAL VISIBILITY</span>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
              Live burn rate vs budget for every project.
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Understand your cost per square foot and liquid bank balances in real time. Compare budget targets against actual site expenditure without waiting for month-end accountant tallies.
            </p>
            <div class="space-y-2 pt-1 text-xs sm:text-sm text-slate-700">
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Live comparison of client receivables vs site outflows</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>7 instant PDF & Excel export registers</span>
              </div>
              <div class="flex items-center gap-2">
                <Check class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
                <span>Milestone stage completion verification</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 5: Roles -->
        <div id="feature-panel-roles" class="feature-panel hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <Image
              src={adminDashboardImg}
              alt="Multi-role security and permissions"
              class="w-full h-auto rounded-xl border border-slate-200 shadow-xs object-cover max-h-[380px]"
              format="webp"
            />
          </div>
          <div class="lg:col-span-5 space-y-4 text-left">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-blue">ROLE CONTROL</span>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
              Field staff see tasks. Only owners see profits.
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Granular permission controls ensure site supervisors and engineers log everyday activities without accessing sensitive vendor pricing, company margins, or banking data.
            </p>
