---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Image } from 'astro:assets';
import heroMobileImg from '../../assets/hero-mobile.png';
---

<Layout
  title="For Site Managers & Field Teams — Brift"
  description="Built for actual site conditions. Record worker attendance, snap bills, and track stock transfers on your phone without cell signal."
>
  <!-- Hero -->
  <section class="relative pt-16 pb-14 sm:pt-24 sm:pb-20 bg-bg border-b border-line overflow-hidden">
    <div class="hero-gradient-blob" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3.5 py-1 rounded-full">
        FOR FIELD & SITE MANAGERS
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-tight">
        Built for the field. Not an office desk.
      </h1>
      <p class="text-lg sm:text-xl text-muted max-w-2xl mx-auto leading-relaxed">
        Construction sites are dusty, busy, and often have zero mobile signal. Brift installs directly on your smartphone, working offline and syncing smoothly when you reconnect.
      </p>
      <div class="pt-2">
        <a href="/book-a-demo" class="inline-flex items-center justify-center rounded-xl bg-blue px-7 py-3.5 text-sm font-semibold text-white hover:bg-blue-hover transition-all shadow-sm">
          See Mobile Field Walkthrough
        </a>
      </div>
    </div>
  </section>

  <!-- Key Field Features -->
  <section class="py-16 sm:py-24 bg-white border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6 reveal">
          <span class="text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full">
            OFFLINE-READY PWA
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
            No signal? No problem.
          </h2>
          <p class="text-base text-muted leading-relaxed">
            Site managers don't need to write numbers on their hands or wait until they get home to send updates. Everything happens on site in seconds:
          </p>

          <div class="space-y-4 pt-2">
            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">Snap & Upload Bills Instantly</h3>
              <p class="text-xs text-muted leading-relaxed">
                Take a quick photo of vendor bills, delivery challans, or petty cash receipts. The image is permanently linked to the site expense line.
              </p>
            </div>

            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">One-Tap Labor Attendance</h3>
              <p class="text-xs text-muted leading-relaxed">
                Mark mason, carpenter, and helper attendance in 60 seconds each morning. Full day or half day — wages calculate automatically without paperwork errors.
              </p>
            </div>

            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">Material Reorder Requests</h3>
              <p class="text-xs text-muted leading-relaxed">
                Request new purchases or inter-site stock transfers directly from the app so the office can approve and dispatch without multiple phone calls.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 reveal delay-100 flex justify-center">
          <div class="relative w-full max-w-sm rounded-3xl border border-line bg-white p-3 shadow-elevated">
            <Image
              src={heroMobileImg}
              alt="Brift Mobile App on site manager smartphone"
              class="w-full h-auto rounded-2xl object-cover"
              format="webp"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
