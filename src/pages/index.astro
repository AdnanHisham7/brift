---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroTransparentImg from '../assets/hero-phone-transparent.png';
import spendImg from '../assets/spend-analytics.png';
import materialsImg from '../assets/materials-stock.png';
import contractorImg from '../assets/contractor-report.png';
import reportsImg from '../assets/reports-overview.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import storiesImg from '../assets/stories-site-updates.png';

import {
  ArrowRight,
  ArrowDown,
  Check,
  Clock,
  AlertTriangle,
  TrendingUp,
  ShieldCheck,
  DollarSign,
  PhoneCall,
  MessageSquare,
  Users,
  Truck,
  Lock,
  FileSpreadsheet,
  HardHat,
  Wallet,
  Building,
  CheckCircle2,
  BarChart3,
  FileCheck,
  Calendar,
  ChevronLeft,
  ChevronRight,
  Mail,
  Sparkles
} from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Brift — A Single Hub for Every Site"
  description="A cinematic operating system for construction companies ready to replace spreadsheets, WhatsApp groups and guesswork with one reliable view of every site, rupee and worker."
  schemaType="home"
>
  <!-- BACKGROUND BLUEPRINT ACCENTS -->
  <div class="fixed inset-0 blueprint-grid opacity-35 pointer-events-none -z-20" aria-hidden="true"></div>
  <div class="fixed top-0 right-0 w-[600px] h-[600px] bg-blue-100/50 blur-3xl rounded-full pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="fixed bottom-0 left-0 w-[600px] h-[600px] bg-amber-100/40 blur-3xl rounded-full pointer-events-none -z-10" aria-hidden="true"></div>

  <!-- FLOATING CHAPTER PROGRESS RAIL (MINIMAL DOTS ONLY) -->
  <aside aria-label="Story Acts Navigation" class="hidden xl:flex fixed right-6 top-1/2 -translate-y-1/2 z-40 flex-col items-end gap-3.5 pointer-events-auto">
    <a href="#act-1" data-act-nav="act-1" class="act-nav-item group relative flex items-center justify-end py-1 focus:outline-none" aria-label="Act 01: Reality Check">
      <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-slate-900/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono font-semibold text-white shadow-lg opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0">
        01 // Reality Check
      </span>
      <span class="act-dot block w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125 group-hover:bg-blue"></span>
    </a>
    <a href="#act-2" data-act-nav="act-2" class="act-nav-item group relative flex items-center justify-end py-1 focus:outline-none" aria-label="Act 02: Forensic Audit">
      <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-slate-900/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono font-semibold text-white shadow-lg opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0">
        02 // Forensic Audit
      </span>
      <span class="act-dot block w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125 group-hover:bg-blue"></span>
    </a>
    <a href="#act-3" data-act-nav="act-3" class="act-nav-item group relative flex items-center justify-end py-1 focus:outline-none" aria-label="Act 03: 24-Hour Reel">
      <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-slate-900/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono font-semibold text-white shadow-lg opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0">
        03 // 24-Hour Reel
      </span>
      <span class="act-dot block w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125 group-hover:bg-blue"></span>
    </a>
    <a href="#act-4" data-act-nav="act-4" class="act-nav-item group relative flex items-center justify-end py-1 focus:outline-none" aria-label="Act 04: Master Overview">
      <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-slate-900/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono font-semibold text-white shadow-lg opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0">
        04 // Master Overview
      </span>
      <span class="act-dot block w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125 group-hover:bg-blue"></span>
    </a>
    <a href="#act-5" data-act-nav="act-5" class="act-nav-item group relative flex items-center justify-end py-1 focus:outline-none" aria-label="Act 05: Cockpit Channels">
      <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-slate-900/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono font-semibold text-white shadow-lg opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0">
        05 // Cockpit Channels
      </span>
      <span class="act-dot block w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125 group-hover:bg-blue"></span>
    </a>
    <a href="#act-6" data-act-nav="act-6" class="act-nav-item group relative flex items-center justify-end py-1 focus:outline-none" aria-label="Act 06: Profit Loss Radar">
      <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-slate-900/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono font-semibold text-white shadow-lg opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0">
        06 // Profit Loss Radar
      </span>
      <span class="act-dot block w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125 group-hover:bg-blue"></span>
    </a>
    <a href="#act-7" data-act-nav="act-7" class="act-nav-item group relative flex items-center justify-end py-1 focus:outline-none" aria-label="Act 07: Take Command">
      <span class="pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-slate-900/90 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono font-semibold text-white shadow-lg opacity-0 translate-x-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-x-0">
        07 // Take Command
      </span>
      <span class="act-dot block w-2.5 h-2.5 rounded-full bg-slate-300 transition-all duration-300 group-hover:scale-125 group-hover:bg-blue"></span>
    </a>
  </aside>

  <!-- MAIN SCROLLING STORYLINE -->
  <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-16 sm:pb-20 space-y-16 sm:space-y-28 lg:space-y-36">

    <!-- ========================================== -->
    <!-- ACT 01 // THE REALITY CHECK (HERO)        -->
    <!-- ========================================== -->
    <section id="act-1" class="relative pt-4 sm:pt-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
        <!-- Left: Narrative -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-left">
          <div data-motion="fade-up" data-delay="100" class="inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue-soft px-3.5 py-1 text-xs font-semibold text-blue">
            <img src={`${base}/logo-blue.png`} alt="Brift Logo" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
            <span>A SINGLE HUB FOR EVERY SITE</span>
          </div>

          <h1 data-motion="fade-up" data-delay="150" class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 leading-[1.12] sm:leading-[1.08]">
            Stop running your construction sites on <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue via-indigo-600 to-amber-600">
              scattered chats & pocket diaries.
            </span>
          </h1>

          <p data-motion="fade-up" data-delay="200" class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
            You built a construction business to deliver quality projects and protect your hard-earned margins. Instead, you're trapped in 40+ phone calls a day while money quietly leaks every month through paper muster rolls, uncounted bags, and unrecorded cash advances.
          </p>

          <!-- Primary Actions -->
          <div data-motion="fade-up" data-delay="250" class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a
              href="#demo"
              class="inline-flex items-center justify-center rounded-xl bg-blue hover:bg-blue-hover text-white px-6 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base font-bold shadow-[0_4px_14px_rgba(58,70,225,0.35)] hover:shadow-[0_6px_20px_rgba(58,70,225,0.45)] transition-all active:scale-95 group focus-visible:outline-none"
            >
              <span>Take Command — Book Demo</span>
              <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
            </a>
            <a
              href="#act-2"
              class="inline-flex items-center justify-center rounded-xl bg-white hover:bg-slate-50 border border-slate-200/90 shadow-xs px-5 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-sm font-semibold text-slate-700 transition-all gap-2"
            >
              <span>Inspect The 4 Financial Leaks</span>
              <ArrowDown class="w-4 h-4 text-slate-500 animate-bounce" />
            </a>
          </div>

          <!-- Live Telemetry Badges -->
          <div class="pt-2 sm:pt-4 grid grid-cols-3 gap-2 sm:gap-3 max-w-xl">
            <div data-motion="fade-up" data-delay="300" class="motion-card-hover rounded-2xl border border-slate-200/80 bg-white p-2.5 sm:p-4 shadow-xs">
              <span data-counter="29.5" data-format="lakh" class="text-base sm:text-2xl font-black text-slate-900 block leading-tight">~₹29.5L</span>
              <span class="text-[10px] sm:text-xs text-slate-500 block leading-tight mt-0.5">Monthly volume</span>
            </div>
            <div data-motion="fade-up" data-delay="350" class="motion-card-hover rounded-2xl border border-slate-200/80 bg-white p-2.5 sm:p-4 shadow-xs">
              <span data-counter="100" data-format="percent" class="text-base sm:text-2xl font-black text-emerald-600 block leading-tight">100%</span>
              <span class="text-[10px] sm:text-xs text-slate-500 block leading-tight mt-0.5">Offline sync</span>
            </div>
            <div data-motion="fade-up" data-delay="400" class="motion-card-hover rounded-2xl border border-slate-200/80 bg-white p-2.5 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-amber-600 block leading-tight">0 Leaks</span>
              <span class="text-[10px] sm:text-xs text-slate-500 block leading-tight mt-0.5">Zero unverified</span>
            </div>
          </div>
        </div>

        <!-- Right: 3D Floating Terminal -->
        <div class="lg:col-span-5 relative flex justify-center perspective-container pt-4 lg:pt-0">
          <div data-motion="zoom-in" data-delay="200" class="relative w-full max-w-[280px] xs:max-w-[320px] sm:max-w-[380px] lg:max-w-[420px] animate-float">
            <!-- Ambient halo -->
            <div class="absolute inset-4 bg-gradient-to-tr from-blue/20 via-indigo-200 to-amber-200 blur-3xl rounded-full -z-10" aria-hidden="true"></div>

            <Image
              src={heroTransparentImg}
              alt="Brift Mobile Interface cutout with live project cards"
              class="w-full h-auto drop-shadow-[0_25px_35px_rgba(15,23,42,0.18)] select-none"
              loading="eager"
              fetchpriority="high"
              format="webp"
            />

            <!-- Floating Telemetry Overlay Badges -->
            <div data-motion="fade-left" data-delay="450" class="absolute -top-3 -left-3 sm:-left-6 rounded-2xl border border-slate-200 bg-white/95 p-2.5 sm:p-3.5 shadow-xl backdrop-blur-md max-w-[180px] sm:max-w-[210px] hidden sm:block">
              <div class="flex items-center gap-2 sm:gap-2.5">
                <span class="flex h-6 w-6 sm:h-7 sm:w-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                  <Check class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
                </span>
                <div>
                  <span class="text-[9px] sm:text-[10px] uppercase font-mono tracking-wider text-slate-500 block">Verified Funds</span>
                  <span class="text-[11px] sm:text-xs font-black text-slate-900 block">₹62,00,000 Locked</span>
                </div>
              </div>
            </div>

            <div data-motion="fade-right" data-delay="550" class="absolute -bottom-3 right-0 sm:-bottom-4 sm:-right-6 rounded-2xl border border-slate-200 bg-white/95 p-2.5 sm:p-3.5 shadow-xl backdrop-blur-md max-w-[190px] sm:max-w-[220px]">
              <div class="flex items-center gap-2 sm:gap-2.5">
                <div class="h-2 w-2 sm:h-2.5 sm:w-2.5 rounded-full bg-emerald-500 animate-ping"></div>
                <div>
                  <span class="text-[9px] sm:text-[10px] uppercase font-mono tracking-wider text-amber-700 block">Basement 0 Bars</span>
                  <span class="text-[11px] sm:text-xs font-bold text-slate-900 block">30 Workers Synced</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- ACT 02 // THE INVISIBLE BLEED (CRIME SCENE)-->
    <!-- ========================================== -->
    <section id="act-2" class="relative">
      <!-- Section Header -->
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-8 sm:mb-14 space-y-3">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3.5 py-1 rounded-full">
          ACT 02 // FORENSIC AUDIT
        </span>
        <h2 class="text-2xl xs:text-3xl sm:text-5xl font-black tracking-tight text-slate-900 leading-tight">
          Where does ₹2.4 Lakhs quietly vanish every single month?
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Click on any evidence file below to inspect how manual paper records create silent financial bleeding across your sites:
        </p>
      </div>

      <!-- 4 Forensic Evidence Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Evidence 1 -->
        <div
          data-motion="fade-up"
          data-delay="100"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-5 sm:p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(1)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <Users class="w-3 h-3" />
              <span>Evidence #01</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹40,000 / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Ghost Labor Register
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Attendance taken on paper notebooks. By Saturday evening, 4 to 6 extra phantom workers have been added to the payout tally.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>

        <!-- Evidence 2 -->
        <div
          data-motion="fade-up"
          data-delay="200"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-5 sm:p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(2)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <Truck class="w-3 h-3" />
              <span>Evidence #02</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹80,000 / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Vanishing Cement Challan
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            200 bags billed by the supplier. 170 bags actually unloaded. Delivery challan signed in pencil and lost under a windshield.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>

        <!-- Evidence 3 -->
        <div
          data-motion="fade-up"
          data-delay="300"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-5 sm:p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(3)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <Wallet class="w-3 h-3" />
              <span>Evidence #03</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹70,000 / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            The Pocket Diary Advance
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Site engineer hands out ₹35,000 cash advance to electrical contractor. Written in a pocket notebook, forgotten at final settlement.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>

        <!-- Evidence 4 -->
        <div
          data-motion="fade-up"
          data-delay="400"
          class="motion-card-hover rounded-2xl border-2 border-slate-200 bg-white p-5 sm:p-6 hover:border-red-500 hover:shadow-xl transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(4)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-700 bg-red-100 px-2.5 py-0.5 rounded-md flex items-center gap-1">
              <AlertTriangle class="w-3 h-3" />
              <span>Evidence #04</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹50,000 / mo</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-red-600 transition-colors">
            Emergency Retail Markups
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Site runs out of binding wire on Thursday. Supervisor rushes to retail hardware store with an 18% markup so labor doesn't stall.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>
      </div>

      <!-- Dynamic Forensic Spotlight Box -->
      <div data-motion="zoom-in" data-delay="150" id="forensic-spotlight" class="mt-6 sm:mt-8 rounded-2xl sm:rounded-3xl border border-blue/30 bg-blue-soft/50 p-4 sm:p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-blue/20 pb-3 sm:pb-4 mb-3 sm:mb-4">
          <div class="flex items-center gap-2 sm:gap-2.5">
            <ShieldCheck class="w-4 h-4 sm:w-5 sm:h-5 text-blue shrink-0" />
            <span class="text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider text-blue" id="spotlight-title">
              CASE FILE #01 // GHOST LABOR RESOLUTION
            </span>
          </div>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-800 bg-emerald-100 px-2.5 sm:px-3 py-1 rounded-full flex items-center gap-1 self-start sm:self-auto">
            <Check class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-emerald-700" />
            <span>Status: Fully Plugged by Brift</span>
          </span>
        </div>
        <p class="text-xs sm:text-base text-slate-700 leading-relaxed" id="spotlight-desc">
          <strong class="text-slate-900">The Brift Closed-Loop:</strong> The site supervisor opens the app at the site gate. Even in a basement with 0 cellular signal, attendance is logged and timestamped with worker categorization (skilled/unskilled). The record locks permanently and syncs to central payroll the second the phone connects to signal. Zero paper registers, zero phantom workers.
        </p>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- ACT 03 // 24 HOURS ON SITE (TIMELINE REEL) -->
    <!-- ========================================== -->
    <section id="act-3" class="relative">
      <div data-motion="fade-up" class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 mb-6 sm:mb-8 border-b border-slate-200/80 pb-5 sm:pb-6">
        <div class="space-y-2 max-w-2xl">
          <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-amber-800 bg-amber-100 border border-amber-300 px-3.5 py-1 rounded-full">
            ACT 03 // 24-HOUR SITE STORY
          </span>
          <h2 class="text-2xl xs:text-3xl sm:text-5xl font-black tracking-tight text-slate-900 leading-tight">
            Watch a day on your sites unfold.
          </h2>
          <p class="text-sm sm:text-base text-slate-600">
            See how chaotic phone calls and unverified receipts transform into automated, synchronized records:
          </p>
        </div>

        <!-- Always-On Auto-Playing Time Indicator -->
        <div class="flex flex-col items-start md:items-end gap-1.5 self-start md:self-auto">
          <div class="inline-flex items-center gap-2 rounded-xl bg-slate-100 border border-slate-200 px-3.5 sm:px-4 py-1.5 sm:py-2 text-[11px] sm:text-xs font-mono font-bold text-slate-700 shadow-xs">
            <Clock class="w-3.5 h-3.5 text-amber-600 animate-spin" style="animation-duration: 4s;" />
            <span>NEXT SCENE IN <strong id="reel-countdown" class="text-amber-700 font-black">4s</strong></span>
          </div>
          <!-- Playing Progress Bar Line -->
          <div class="w-36 sm:w-44 h-1.5 bg-slate-200 rounded-full overflow-hidden">
            <div id="reel-progress-fill" class="h-full bg-amber-500 rounded-full transition-all duration-100 ease-linear" style="width: 0%;"></div>
          </div>
        </div>
      </div>

      <!-- Theater Stage -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
        <!-- Storyboard Controls -->
