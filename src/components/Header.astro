---
import { ArrowRight } from 'lucide-astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header
  id="main-header"
  class="fixed top-3 sm:top-5 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-5xl transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
>
  <div class="rounded-full bg-white/95 backdrop-blur-xl border border-slate-200/90 shadow-[0_4px_20px_rgba(15,23,42,0.06)] px-4 sm:px-6 py-2 sm:py-2.5 flex items-center justify-between">
    <!-- Brand Logo & Name (Left) -->
    <a href={`${base}/`} class="flex items-center gap-2.5 sm:gap-3 group focus-visible:outline-none" aria-label="Brift Homepage">
      <div class="relative flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl bg-blue text-white shadow-xs transition-transform group-hover:scale-105 p-1.5 shrink-0">
        <img src={`${base}/logo.png`} alt="Brift Logo" class="h-full w-full object-contain" width="36" height="36" />
      </div>
      <div class="flex items-center gap-2">
        <span class="text-base sm:text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-blue transition-colors">BRIFT</span>
        <span class="hidden sm:inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold tracking-wider bg-slate-100 border border-slate-200 text-slate-600">
          CONSTRUCTION OS
        </span>
      </div>
    </a>

    <!-- Single Action CTA (Right) -->
    <div class="flex items-center">
      <a
        href={`${base}/book-demo`}
        class="relative inline-flex items-center justify-center rounded-full bg-blue hover:bg-blue-hover text-white text-xs sm:text-sm font-semibold px-4 sm:px-6 py-2 sm:py-2.5 shadow-xs transition-all duration-200 active:scale-95 group focus-visible:outline-none whitespace-nowrap"
      >
        <span>Book a Demo</span>
        <ArrowRight class="w-3.5 h-3.5 ml-1.5 group-hover:translate-x-0.5 transition-transform" />
      </a>
    </div>
  </div>
</header>

<script>
  function initHeaderAutoHide() {
    const header = document.getElementById('main-header');
    if (!header) return;

    let lastScrollY = window.pageYOffset || document.documentElement.scrollTop;
    let ticking = false;

    function handleScroll() {
      if (!header) return;
      const currentScrollY = window.pageYOffset || document.documentElement.scrollTop;

      // Always show near top of page
      if (currentScrollY <= 80) {
        header.classList.remove('-translate-y-28', 'opacity-0', 'pointer-events-none');
      } else if (currentScrollY > lastScrollY && currentScrollY > 120) {
        // Scrolling DOWN -> hide header smoothly
        header.classList.add('-translate-y-28', 'opacity-0', 'pointer-events-none');
      } else if (currentScrollY < lastScrollY) {
        // Scrolling UP -> reveal header
        header.classList.remove('-translate-y-28', 'opacity-0', 'pointer-events-none');
      }

      lastScrollY = Math.max(0, currentScrollY);
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(handleScroll);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderAutoHide);
  } else {
    initHeaderAutoHide();
  }
</script>
