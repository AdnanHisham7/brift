---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-line bg-white mt-auto">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <!-- Brand & Mission Column -->
      <div class="md:col-span-4 space-y-4">
        <a href="/" class="flex items-center gap-3" aria-label="Brift Homepage">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue text-white shadow-sm">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19h4v-5h4v-5h4V4h4" />
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-ink">BRIFT</span>
        </a>
        <p class="text-sm font-medium text-ink-2 max-w-sm">
          A single hub for every site.
        </p>
        <p class="text-sm text-muted max-w-sm leading-relaxed">
          A live operating system for construction companies ready to replace spreadsheets, WhatsApp groups and guesswork — with one reliable view of every site, rupee and worker.
        </p>
        <p class="text-xs text-muted pt-1">
          Bridging the site to the office.
        </p>
      </div>

      <!-- Product Modules -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">Product Modules</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/product/money" class="text-ink-2 hover:text-blue transition-colors">Money & Budgets</a>
          </li>
          <li>
            <a href="/product/materials" class="text-ink-2 hover:text-blue transition-colors">Materials & Stock</a>
          </li>
          <li>
            <a href="/product/workforce" class="text-ink-2 hover:text-blue transition-colors">Workforce & Contractors</a>
          </li>
          <li>
            <a href="/product/reports" class="text-ink-2 hover:text-blue transition-colors">7 Executive Reports</a>
          </li>
          <li>
            <a href="/product/trust-and-control" class="text-ink-2 hover:text-blue transition-colors">Trust & Role Portals</a>
          </li>
        </ul>
      </div>

      <!-- Solutions & Company -->
      <div class="md:col-span-2 space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">Solutions & ROI</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/solutions/owners" class="text-ink-2 hover:text-blue transition-colors">For Owners</a>
          </li>
          <li>
            <a href="/solutions/site-managers" class="text-ink-2 hover:text-blue transition-colors">For Site Teams</a>
          </li>
          <li>
            <a href="/cost-of-inaction" class="text-amber-700 font-medium hover:text-amber-800 transition-colors">Cost of Inaction</a>
          </li>
          <li>
            <a href="/pricing" class="text-ink-2 hover:text-blue transition-colors">Pricing & Plans</a>
          </li>
          <li>
            <a href="/about" class="text-ink-2 hover:text-blue transition-colors">About Us</a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact & Trust -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">Direct Contact</h3>
        <p class="text-xs text-muted">
          Talk directly with our team to map Brift to your active construction sites:
        </p>
        <ul class="space-y-2 text-sm text-ink-2 pt-1">
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+919037532036" class="hover:text-blue">+91 9037532036</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:brift.official@gmail.com" class="hover:text-blue">brift.official@gmail.com</a>
          </li>
          <li>
            <a
              href="/book-a-demo"
              class="mt-2 inline-flex items-center justify-center rounded-xl bg-blue py-2 px-4 text-xs font-semibold text-white shadow-2xs hover:bg-blue-hover"
            >
              Book a Demo
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar with Legal Links -->
    <div class="mt-12 border-t border-line pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-muted">
        &copy; {currentYear} Brift Technologies. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-xs text-muted">
        <a href="/privacy-policy" class="hover:text-ink transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-ink transition-colors">Terms of Service</a>
        <a href="/sitemap-index.xml" class="hover:text-ink transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
