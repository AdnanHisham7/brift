        headline: "200 bags of cement arrive. Verified before the truck leaves.",
        narration: "The supervisor snaps the delivery challan, logs the counted bags directly into inventory, and locks stock to standardized item codes. Phantom deliveries are physically impossible.",
        leak: "✓ Challan Locked to Stock",
        feed: "FEED // 02 • INVENTORY INTAKE"
      },
      3: {
        timecode: "TIMECODE: 03:15:00 PM",
        location: "LOCATION: SITE OFFICE",
        headline: "Subcontractor requests ₹35,000 cash advance.",
        narration: "Before handing over cash, Brift inspects the electrical contractor's lifetime ledger, previous advances, and unbilled work. The advance deducts automatically from the final bill.",
        leak: "✓ Advance Deducted from Bill",
        feed: "FEED // 03 • ADVANCE LEDGER"
      },
      4: {
        timecode: "TIMECODE: 07:30:00 PM",
        location: "LOCATION: LIVING ROOM",
        headline: "The owner opens one screen. All sites reconciled.",
        narration: "No 45-minute interrogation calls. In under 5 minutes from your phone or desk, you see total funds in hand, verified spend vs budget, and daily photo progress trays.",
        leak: "✓ Real-Time Company Margin",
        feed: "FEED // 04 • OWNER COCKPIT"
      }
    };

    let currentMovieScene = 1;
    let movieAutoPlayInterval = null;

    function showMovieScene(sceneId) {
      currentMovieScene = sceneId;

      // Update Subtitles
      const data = movieScenes[sceneId];
      if (data) {
        document.getElementById('scene-timecode').textContent = data.timecode;
        document.getElementById('scene-location').textContent = data.location;
        document.getElementById('scene-headline').textContent = data.headline;
        document.getElementById('scene-narration').textContent = data.narration;
        document.getElementById('scene-leak-status').textContent = data.leak;
        document.getElementById('projector-id').textContent = data.feed;
      }

      // Update Screen
      for (let i = 1; i <= 4; i++) {
        const screen = document.getElementById('movie-screen-' + i);
        if (screen) {
          if (i === sceneId) {
            screen.classList.remove('hidden');
          } else {
            screen.classList.add('hidden');
          }
        }
      }

      // Update Tab Buttons
      document.querySelectorAll('.movie-tab').forEach(tab => {
        if (parseInt(tab.getAttribute('data-scene'), 10) === sceneId) {
          tab.className = 'movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border-2 border-yellow bg-yellow text-ink text-left transition-all cursor-pointer';
        } else {
          tab.className = 'movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-navy-line bg-navy-surface text-on-dark text-left hover:border-yellow transition-all cursor-pointer';
        }
      });
    }

    function toggleMovieAutoPlay() {
      const btnText = document.getElementById('play-text');
      const btnIcon = document.getElementById('play-icon');

      if (movieAutoPlayInterval) {
        clearInterval(movieAutoPlayInterval);
        movieAutoPlayInterval = null;
        if (btnText) btnText.textContent = "Auto-Play Movie Mode";
        if (btnIcon) btnIcon.textContent = "▶";
      } else {
        if (btnText) btnText.textContent = "Pause Movie (Playing...)";
        if (btnIcon) btnIcon.textContent = "❚❚";
        movieAutoPlayInterval = setInterval(() => {
          let nextScene = currentMovieScene + 1;
          if (nextScene > 4) nextScene = 1;
          showMovieScene(nextScene);
        }, 4000);
      }
    }

    // 3. Cockpit Channel Switcher
    function switchCockpit(channelId) {
      document.querySelectorAll('.cockpit-panel').forEach(p => p.classList.add('hidden'));
      const active = document.getElementById('cockpit-panel-' + channelId);
      if (active) active.classList.remove('hidden');

      document.querySelectorAll('.cockpit-btn').forEach(btn => {
        if (btn.getAttribute('data-channel') === channelId) {
          btn.className = 'cockpit-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border-2 border-blue bg-blue text-white shadow-xs transition-all cursor-pointer';
        } else {
          btn.className = 'cockpit-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer';
        }
      });
    }

    // 4. Financial Radar Scanner
    function runRadarScan(numSites) {
      document.querySelectorAll('.radar-site-btn').forEach(btn => {
        if (parseInt(btn.getAttribute('data-sites'), 10) === numSites) {
          btn.className = 'radar-site-btn px-4 py-2.5 rounded-xl text-xs font-bold border-2 border-yellow bg-yellow text-ink shadow-sm transition-all cursor-pointer';
        } else {
          btn.className = 'radar-site-btn px-4 py-2.5 rounded-xl text-xs font-bold border border-navy-line bg-navy-surface text-white hover:border-yellow transition-all cursor-pointer';
        }
      });

      const label = document.getElementById('radar-site-label');
      if (label) label.textContent = numSites + ' Active Construction Sites';

      const adv = numSites * 17500;
      const muster = numSites * 10000;
      const mat = numSites * 20000;
      const retail = numSites * 12500;
      const monthlyTotal = adv + muster + mat + retail;
      const annualTotal = monthlyTotal * 12;

      document.getElementById('radar-advances').textContent = '₹' + adv.toLocaleString('en-IN') + ' / mo';
      document.getElementById('radar-muster').textContent = '₹' + muster.toLocaleString('en-IN') + ' / mo';
      document.getElementById('radar-materials').textContent = '₹' + mat.toLocaleString('en-IN') + ' / mo';
      document.getElementById('radar-retail').textContent = '₹' + retail.toLocaleString('en-IN') + ' / mo';
      document.getElementById('radar-monthly-total').textContent = '₹' + monthlyTotal.toLocaleString('en-IN') + ' / mo';
      
      const lakhs = (annualTotal / 100000).toFixed(1);
      document.getElementById('radar-annual-total').textContent = '₹' + lakhs + ' Lakhs every year';
    }

    // 5. Demo Form Submission Simulation
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('lead-demo-form');
      const successBox = document.getElementById('demo-success-box');
      if (form && successBox) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
        });
      }
    });
  </script>
</Layout>
