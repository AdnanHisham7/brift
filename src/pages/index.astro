---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroTransparentImg from '../assets/hero-phone-transparent.png';
import spendImg from '../assets/spend-analytics.png';
import materialsImg from '../assets/materials-stock.png';
import contractorImg from '../assets/contractor-report.png';
import reportsImg from '../assets/reports-overview.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import storiesImg from '../assets/stories-site-updates.png';

import {
  ArrowRight,
  ArrowDown,
  Check,
  CheckCircle2,
  Clock,
  ShieldCheck,
  Users,
  Truck,
  Wallet,
  Building,
  BarChart3,
  Calendar,
  Lock,
  MessageSquare,
  Phone,
  Mail,
  ChevronLeft,
  ChevronRight
} from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Brift — Construction Operations Platform"
  description="The all-in-one operations platform for construction companies and civil contractors. Track site attendance, material deliveries, contractor advances, and project cash flow in real time."
  schemaType="home"
>
  <!-- Background Grid Accent -->
  <div class="fixed inset-0 blueprint-grid opacity-25 pointer-events-none -z-20" aria-hidden="true"></div>

  <!-- SILKY LOAD FADE-IN WRAPPER -->
  <div class="app-load-fade relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-16 sm:pb-24 space-y-24 sm:space-y-32 lg:space-y-40">

    <!-- ========================================== -->
    <!-- 1. HERO SECTION WITH 3D PERSPECTIVE & SLICED HUD -->
    <!-- ========================================== -->
    <section id="hero" class="relative pt-4 sm:pt-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        
        <!-- Left: Value Proposition -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-left">
          <div data-motion="fade-up" data-delay="100" class="inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue/10 px-3.5 py-1 text-xs font-semibold text-blue">
            <img src={`${base}/logo-blue.png`} alt="Brift Logo" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
            <span>CONSTRUCTION OPERATIONS PLATFORM</span>
          </div>

          <h1 data-motion="fade-up" data-delay="150" class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.14]">
            Replace scattered site chats and paper registers with <span class="text-blue">one reliable system.</span>
          </h1>

          <p data-motion="fade-up" data-delay="200" class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
            Brift gives civil contractors and builders complete control over daily labor attendance, material delivery challans, subcontractor cash advances, and project cash flow.
          </p>

          <!-- Primary Actions -->
          <div data-motion="fade-up" data-delay="250" class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a
              href="#book-demo"
              class="inline-flex items-center justify-center rounded-xl bg-blue hover:bg-blue-hover text-white px-6 sm:px-8 py-3.5 sm:py-4 text-sm sm:base font-bold shadow-md hover:shadow-lg transition-all active:scale-98 group cursor-pointer"
            >
              <span>Schedule a Live Demo</span>
              <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
            </a>
            <a
              href="#story"
              class="inline-flex items-center justify-center rounded-xl bg-white hover:bg-slate-50 border border-slate-200 shadow-xs px-5 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-sm font-semibold text-slate-700 transition-all gap-2"
            >
              <span>Explore Interactive Walkthrough</span>
              <ArrowDown class="w-4 h-4 text-slate-500 animate-bounce" />
            </a>
          </div>

          <!-- Key Metrics Badges with Counter Scrub -->
          <div class="pt-4 grid grid-cols-3 gap-3 max-w-lg">
            <div data-motion="fade-up" data-delay="300" class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4 shadow-xs">
              <span data-counter="29.5" data-format="lakh" class="text-base sm:text-2xl font-black text-slate-900 block leading-tight">₹29.5L+</span>
              <span class="text-[11px] sm:text-xs text-slate-500 block leading-tight mt-1">Monthly site volume</span>
            </div>
            <div data-motion="fade-up" data-delay="350" class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-emerald-600 block leading-tight">100% Offline</span>
              <span class="text-[11px] sm:text-xs text-slate-500 block leading-tight mt-1">Works in basements</span>
            </div>
            <div data-motion="fade-up" data-delay="400" class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-blue block leading-tight">48 Hours</span>
              <span class="text-[11px] sm:text-xs text-slate-500 block leading-tight mt-1">Rapid team setup</span>
            </div>
          </div>
        </div>

        <!-- Right: 3D Sliced Hardware Terminal with Parallax Physics Layers -->
        <div class="lg:col-span-5 relative flex justify-center pt-4 lg:pt-0 theater-3d-stage">
          <div
            id="hero-3d-stage"
            class="relative w-full max-w-[280px] xs:max-w-[320px] sm:max-w-[360px] lg:max-w-[390px] device-3d-canvas"
          >
            <!-- Ambient Volumetric Glow -->
            <div class="absolute inset-4 bg-gradient-to-tr from-blue/20 to-indigo-400/20 blur-2xl rounded-full -z-10" aria-hidden="true"></div>

            <!-- Primary Hardware Frame & UI Slice -->
            <div class="relative rounded-[2.5rem] p-1.5 bg-slate-900/10 border border-slate-300/40 shadow-[0_25px_60px_-15px_rgba(15,23,42,0.22)] overflow-hidden">
              <Image
                src={heroTransparentImg}
                alt="Brift Mobile Interface for Construction Sites"
                class="w-full h-auto select-none rounded-[2.2rem] block"
                loading="eager"
                fetchpriority="high"
                format="webp"
              />
              <!-- Sliced Specular Glass Sheen Layer -->
              <div class="absolute inset-0 device-sheen-layer rounded-[2.2rem]"></div>
            </div>

            <!-- SLICED TELEMETRY LAYER 1: Geo-Fence Muster Verification (Front Z-Plane) -->
            <div
              id="hero-badge-muster"
              data-depth="0.75"
              class="physics-badge-layer slice-z-high -top-3 -left-3 sm:-left-6 rounded-xl border border-slate-200/90 bg-white/95 backdrop-blur-md p-2.5 sm:p-3 shadow-xl hidden sm:block"
            >
              <div class="flex items-center gap-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 shrink-0">
                  <Check class="w-4 h-4 font-bold" />
                </span>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                    <span class="text-[9px] uppercase font-mono font-bold tracking-wider text-slate-500 block">Gate Verification</span>
                  </div>
                  <span class="text-xs font-bold text-slate-900 block">Locked & Timestamped</span>
                </div>
              </div>
            </div>

            <!-- SLICED TELEMETRY LAYER 2: Basement Offline Sync (Mid Z-Plane) -->
            <div
              id="hero-badge-offline"
              data-depth="0.45"
              class="physics-badge-layer slice-z-mid -bottom-3 right-0 sm:-right-5 rounded-xl border border-slate-200/90 bg-white/95 backdrop-blur-md p-2.5 sm:p-3 shadow-xl"
            >
              <div class="flex items-center gap-2.5">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-blue/10 text-blue shrink-0">
                  <Lock class="w-3.5 h-3.5 font-bold" />
                </div>
                <div>
                  <span class="text-[9px] uppercase font-mono font-bold tracking-wider text-slate-500 block">Basement Mode</span>
                  <span class="text-xs font-bold text-slate-900 block">0 Signal • Auto-Sync Active</span>
                </div>
              </div>
            </div>

            <!-- SLICED TELEMETRY LAYER 3: PO Auto-Match Radar (Front Z-Plane) -->
            <div
              id="hero-badge-po"
              data-depth="0.6"
              class="physics-badge-layer slice-z-front top-1/2 -right-6 rounded-lg border border-slate-200/80 bg-slate-900 text-white px-2.5 py-1.5 shadow-lg hidden lg:flex items-center gap-2"
            >
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-[10px] font-mono tracking-wide">PO #204 MATCHED</span>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- 2. THE 3 PRIMARY OPERATIONAL LEAKS         -->
    <!-- ========================================== -->
    <section id="leaks" class="relative">
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-10 sm:mb-14 space-y-2.5">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3.5 py-1 rounded-full">
          OPERATIONAL LEAKS
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 leading-tight">
          Where Money Silently Leaks on Construction Sites
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Contractors lose 3% to 6% of project margins every month through manual logs and delayed reporting:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
        <!-- Leak 1 -->
        <div data-motion="fade-up" data-delay="100" class="motion-card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded flex items-center gap-1.5">
              <Users class="w-3.5 h-3.5 text-slate-600" />
              <span>Leak 01</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹40,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Ghost Labor & Muster Inflation</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Attendance taken on paper notebooks or verbal calls allows extra unverified workers to be added to the Saturday tally before billing.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1.5">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Brift Fix: Offline locked muster roll</span>
          </div>
        </div>

        <!-- Leak 2 -->
        <div data-motion="fade-up" data-delay="200" class="motion-card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded flex items-center gap-1.5">
              <Truck class="w-3.5 h-3.5 text-slate-600" />
              <span>Leak 02</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹80,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Unverified Delivery Challans</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Trucks arrive and slips are signed in pencil. Without photo proof of unloaded bags, contractors pay bills for materials never received on site.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1.5">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Brift Fix: Gate photo challan match</span>
          </div>
        </div>

        <!-- Leak 3 -->
        <div data-motion="fade-up" data-delay="300" class="motion-card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded flex items-center gap-1.5">
              <Wallet class="w-3.5 h-3.5 text-slate-600" />
              <span>Leak 03</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹70,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Untracked Pocket Advances</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Site engineers hand out cash advances to subcontractors and record them in pocket diaries, leading to bitter disputes at final settlement.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1.5">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Brift Fix: Instant auto-deduct ledger</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. STICKY PARALLAX SCROLL CHOREOGRAPHY (THE LIVING PRODUCT ENGINE)        -->
    <!-- ========================================================================= -->
    <section id="story" class="relative">
      
      <!-- Section Intro Header -->
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-2.5">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-blue bg-blue/10 border border-blue/20 px-3.5 py-1 rounded-full">
          SCROLL WALKTHROUGH
        </span>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
          How Brift Runs Your Sites From Morning to Night
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Scroll down to experience the product in action. The live stage below tracks your scroll naturally:
        </p>
      </div>

      <!-- STICKY CHOREOGRAPHY TRACK (DESKTOP SYNCHRONIZED STAGE) -->
      <div class="sticky-stage-track relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- LEFT COLUMN: NARRATIVE MILESTONES (SCROLLS NATURALLY) -->
        <div class="lg:col-span-5 space-y-28 sm:space-y-36 py-4">
          
          <!-- MILESTONE 1: ATTENDANCE -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                01 // 07:00 AM
              </span>
              <span class="text-xs font-mono text-slate-500 font-semibold uppercase">Site Gate Entrance</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              Muster roll logged at the gate — works 100% offline.
            </h3>
            <p class="text-xs sm:text-base text-slate-600 leading-relaxed">
              Thirty workers arrive at the gate. Even in a basement with zero cellular reception, the supervisor taps skilled and unskilled counts in Brift. The record locks permanently with timestamps and automatically syncs to payroll the moment signal connects.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Zero ghost labor. Saturday muster disputes are eliminated.</span>
            </div>
            <!-- Mobile Fallback Image -->
            <div class="block lg:hidden pt-3">
              <Image src={storiesImg} alt="Muster Roll Log" class="w-full h-auto rounded-xl border border-slate-200 shadow-sm" format="webp" />
            </div>
          </div>

          <!-- MILESTONE 2: MATERIALS -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                02 // 11:30 AM
              </span>
              <span class="text-xs font-mono text-slate-500 font-semibold uppercase">Material Delivery Bay</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              Delivery challan photographed before unloading begins.
            </h3>
            <p class="text-xs sm:text-base text-slate-600 leading-relaxed">
              A supplier truck delivers 200 bags of cement. The site engineer snaps a photo of the physical delivery challan in Brift. Central procurement matches it against the approved purchase order in real time.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Billed bags always equal unloaded bags. Duplicate billing is blocked.</span>
            </div>
            <!-- Mobile Fallback Image -->
            <div class="block lg:hidden pt-3">
              <Image src={materialsImg} alt="Material Challan Verification" class="w-full h-auto rounded-xl border border-slate-200 shadow-sm" format="webp" />
            </div>
          </div>

          <!-- MILESTONE 3: CASH ADVANCES -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="3">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                03 // 03:15 PM
              </span>
              <span class="text-xs font-mono text-slate-500 font-semibold uppercase">Site Office Settlement</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              Cash advances recorded and auto-deducted from billing.
            </h3>
            <p class="text-xs sm:text-base text-slate-600 leading-relaxed">
              The electrical subcontractor requests a ₹35,000 cash advance. The site engineer logs it instantly with timestamp and recipient details. On Saturday billing, Brift automatically deducts the advance from measurement payouts.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Zero forgotten pocket diary advances. Both parties see the same audited record.</span>
            </div>
            <!-- Mobile Fallback Image -->
            <div class="block lg:hidden pt-3">
              <Image src={contractorImg} alt="Contractor Cash Advances" class="w-full h-auto rounded-xl border border-slate-200 shadow-sm" format="webp" />
            </div>
          </div>

          <!-- MILESTONE 4: OWNER DASHBOARD -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="4">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                04 // 07:30 PM
              </span>
              <span class="text-xs font-mono text-slate-500 font-semibold uppercase">Executive Overview</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              All sites reconciled on one screen. No 40 phone calls.
            </h3>
            <p class="text-xs sm:text-base text-slate-600 leading-relaxed">
              In under 5 minutes from your phone or office, review live project burn rates, bank balances, stage milestone completions, and 7 auto-generated PDF audit reports.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Complete peace of mind and verified profit margins across all active sites.</span>
            </div>
            <!-- Mobile Fallback Image -->
            <div class="block lg:hidden pt-3">
              <Image src={reportsImg} alt="Owner Executive Dashboard" class="w-full h-auto rounded-xl border border-slate-200 shadow-sm" format="webp" />
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: STICKY 3D PINNED STAGE (DESKTOP SYNCHRONIZED THEATER) -->
        <div class="hidden lg:block lg:col-span-7 sticky-stage-display theater-3d-stage">
          <div
            id="story-3d-device"
            class="device-3d-canvas rounded-2xl border border-slate-200/90 bg-white p-4 shadow-[0_20px_50px_-10px_rgba(15,23,42,0.18)] relative overflow-hidden h-[490px]"
          >
            <!-- Ambient Stage Backlight -->
            <div class="absolute -inset-10 bg-gradient-to-tr from-blue/10 via-indigo-500/5 to-transparent blur-2xl -z-10" aria-hidden="true"></div>

            <!-- Stage Top Bar with Active Chapter Indicator & Live Scrub Bar -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100 text-xs font-mono text-slate-500 relative z-20">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="stage-active-label" class="font-bold text-slate-900">01 // MUSTER ROLL LOCK</span>
              </div>
              <!-- Step Progress Tracker Pills -->
              <div class="flex items-center gap-1.5" id="stage-tracker-pills">
                <span class="story-step-indicator active-step h-2 w-6 rounded-full bg-blue"></span>
                <span class="story-step-indicator h-2 w-2 rounded-full bg-slate-200"></span>
                <span class="story-step-indicator h-2 w-2 rounded-full bg-slate-200"></span>
                <span class="story-step-indicator h-2 w-2 rounded-full bg-slate-200"></span>
              </div>
            </div>

            <!-- Screen Slide 1: Gate Muster Roll -->
            <div id="stage-slide-1" class="stage-screen-slide is-active">
              <div class="relative w-full h-[405px] rounded-xl overflow-hidden border border-slate-100 shadow-xs">
                <Image
                  src={storiesImg}
                  alt="Site attendance and daily photo update feed"
                  class="w-full h-full object-cover"
                  format="webp"
                />
                <div class="absolute inset-0 device-sheen-layer"></div>
              </div>
              <!-- Sliced Physics Badge Layer 1 (Front Z-Plane) -->
              <div class="physics-badge-layer slice-z-high bottom-6 left-6 rounded-xl border border-slate-200/95 bg-white/95 backdrop-blur-md p-3 shadow-xl">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                    <Check class="w-4 h-4 font-bold" />
                  </span>
                  <div>
                    <span class="text-[9px] uppercase font-mono tracking-wider text-slate-500 block">Gate Verification</span>
                    <span class="text-xs font-bold text-slate-900">38 Skilled • 12 Unskilled Locked</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Screen Slide 2: Materials & Delivery Challan OCR -->
            <div id="stage-slide-2" class="stage-screen-slide is-inactive">
              <div class="relative w-full h-[405px] rounded-xl overflow-hidden border border-slate-100 shadow-xs">
                <Image
                  src={materialsImg}
                  alt="Materials stock ledger and delivery intake"
                  class="w-full h-full object-cover"
                  format="webp"
                />
                <!-- Sliced OCR Laser Scan Beam Effect -->
                <div class="ocr-scan-beam"></div>
                <div class="absolute inset-0 device-sheen-layer"></div>
              </div>
              <!-- Sliced Physics Badge Layer 2 (High Z-Plane) -->
              <div class="physics-badge-layer slice-z-high bottom-6 left-6 rounded-xl border border-slate-200/95 bg-white/95 backdrop-blur-md p-3 shadow-xl">
                <div class="flex items-center gap-2.5">
