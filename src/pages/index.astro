  <!-- INTERACTIVE CINEMA ENGINE CLIENT SCRIPT -->
  <script is:inline>
    // 1. Evidence Casefile Data
    const evidenceData = {
      1: {
        title: "CASE FILE #01 // GHOST LABOR RESOLUTION",
        desc: "The Brift Closed-Loop: The site supervisor opens the app at the site gate. Even in a basement with 0 cellular signal, attendance is logged and timestamped with worker categorization (skilled/unskilled). The record locks permanently and syncs to central payroll the second the phone connects to signal. Zero paper registers, zero phantom workers."
      },
      2: {
        title: "CASE FILE #02 // CEMENT INTAKE AUDIT",
        desc: "The Brift Closed-Loop: The delivery truck arrives at the bay. The supervisor must photograph the printed delivery challan and bag stack directly in Brift before the intake voucher is generated. Central office verifies before accounting issues payment. Phantom shortfalls vanish."
      },
      3: {
        title: "CASE FILE #03 // CASH ADVANCE SETTLEMENT",
        desc: "The Brift Closed-Loop: Cash advances require an instant digital timestamped entry in the contractor's ledger. When the final measurement bill is submitted, Brift automatically deducts all outstanding advances from the settlement. Zero forgotten diary advances."
      },
      4: {
        title: "CASE FILE #04 // INVENTORY BUFFER ALERTS",
        desc: "The Brift Closed-Loop: Material run-rates are calculated daily. When steel or cement dips below 3 days of supply, automatic replenishment alerts are sent to bulk procurement with pre-negotiated volume pricing, eliminating costly local retail emergency markups."
      }
    };

    function inspectEvidence(id) {
      const data = evidenceData[id];
      if (data) {
        const titleEl = document.getElementById('spotlight-title');
        const descEl = document.getElementById('spotlight-desc');
        if (titleEl) titleEl.textContent = data.title;
        if (descEl) descEl.innerHTML = '<strong class="text-white">The Brift Closed-Loop: </strong>' + data.desc.replace('The Brift Closed-Loop: ', '');
      }
    }

    // 2. 24-Hour Movie Scene Controller
    const movieScenes = {
      1: {
        timecode: "TIMECODE: 07:00:00 AM",
        location: "LOCATION: SITE GATE",
        headline: "Muster roll logged without network or ghost labor.",
        narration: "Thirty workers arrive at the gate. Even in a basement with zero cellular bars, the supervisor taps each worker in Brift. Attendance is locked to prevent week-end muster inflation.",
        leak: "✓ Zero Ghost Labor Paid",
        feed: "FEED // 01 • MUSTER SYNC"
      },
      2: {
        timecode: "TIMECODE: 11:30:00 AM",
        location: "LOCATION: DELIVERY BAY",
        headline: "200 bags of cement arrive. Delivery challan photographed.",
        narration: "A driver brings a delivery challan. The supervisor snaps a clear photo in Brift before unloading begins. Central office sees it instantly. No phantom bags billed.",
        leak: "✓ Billed Bags = Unloaded Bags",
        feed: "FEED // 02 • STOCK INTAKE"
      },
      3: {
        timecode: "TIMECODE: 03:15:00 PM",
        location: "LOCATION: SITE OFFICE",
        headline: "Subcontractor requests ₹35,000 advance. Automatically recorded.",
        narration: "The electrical contractor requests a cash advance. The site engineer enters it into Brift. It is instantly linked to the contractor's balance, eliminating disputed settlements.",
        leak: "✓ 0 Disputed Advances",
        feed: "FEED // 03 • CONTRACTOR LEDGER"
      },
      4: {
        timecode: "TIMECODE: 07:30:00 PM",
        location: "LOCATION: LIVING ROOM",
        headline: "The owner opens one screen. All sites reconciled.",
        narration: "No 45-minute interrogation calls. In under 5 minutes from your phone or desk, you see total funds in hand, verified spend vs budget, and daily photo progress trays.",
        leak: "✓ Real-Time Company Margin",
        feed: "FEED // 04 • OWNER COCKPIT"
      }
    };

    let currentMovieScene = 1;
    let movieAutoPlayInterval = null;

    function showMovieScene(sceneId) {
      currentMovieScene = sceneId;
      const data = movieScenes[sceneId];
      if (data) {
        const tc = document.getElementById('scene-timecode');
        const loc = document.getElementById('scene-location');
        const hl = document.getElementById('scene-headline');
        const narr = document.getElementById('scene-narration');
        const lk = document.getElementById('scene-leak-status');
        const pId = document.getElementById('projector-id');

        if (tc) tc.textContent = data.timecode;
        if (loc) loc.textContent = data.location;
        if (hl) hl.textContent = data.headline;
        if (narr) narr.textContent = data.narration;
        if (lk) lk.textContent = data.leak;
        if (pId) pId.textContent = data.feed;
      }

      for (let i = 1; i <= 4; i++) {
        const screen = document.getElementById('movie-screen-' + i);
        if (screen) {
          if (i === sceneId) screen.classList.remove('hidden');
          else screen.classList.add('hidden');
        }
      }

      document.querySelectorAll('.movie-tab').forEach(tab => {
        if (parseInt(tab.getAttribute('data-scene') || '0', 10) === sceneId) {
          tab.className = 'movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border-2 border-amber-400 bg-amber-400 text-slate-950 text-left transition-all cursor-pointer font-mono';
        } else {
          tab.className = 'movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-white/10 bg-white/[0.04] text-slate-300 text-left hover:border-amber-400/50 transition-all cursor-pointer font-mono';
        }
      });
    }

    function toggleMovieAutoPlay() {
      const btnText = document.getElementById('play-text');
      const btnIcon = document.getElementById('play-icon');

      if (movieAutoPlayInterval) {
        clearInterval(movieAutoPlayInterval);
        movieAutoPlayInterval = null;
        if (btnText) btnText.textContent = "Auto-Play Movie Mode";
        if (btnIcon) btnIcon.textContent = "▶";
      } else {
        if (btnText) btnText.textContent = "Pause Movie (Playing...)";
        if (btnIcon) btnIcon.textContent = "❚❚";
        movieAutoPlayInterval = setInterval(() => {
          let nextScene = currentMovieScene + 1;
          if (nextScene > 4) nextScene = 1;
          showMovieScene(nextScene);
        }, 3500);
      }
    }

    // 3. Cockpit Channel Switcher
    function switchCockpit(channelId) {
      document.querySelectorAll('.cockpit-panel').forEach(p => p.classList.add('hidden'));
      const active = document.getElementById('cockpit-panel-' + channelId);
      if (active) active.classList.remove('hidden');

      document.querySelectorAll('.cockpit-btn').forEach(btn => {
        if (btn.getAttribute('data-channel') === channelId) {
          btn.className = 'cockpit-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border-2 border-blue-500 bg-blue-600 text-white shadow-[0_0_15px_rgba(59,130,246,0.5)] transition-all cursor-pointer';
        } else {
          btn.className = 'cockpit-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-white/10 bg-white/[0.04] text-slate-300 hover:border-blue-400/50 transition-all cursor-pointer';
        }
      });
    }

    // 4. Financial Radar Scanner
    function runRadarScan(numSites) {
      document.querySelectorAll('.radar-site-btn').forEach(btn => {
        if (parseInt(btn.getAttribute('data-sites') || '0', 10) === numSites) {
          btn.className = 'radar-site-btn px-4 py-2 rounded-xl text-xs font-mono font-bold border-2 border-amber-400 bg-amber-400 text-slate-950 shadow-[0_0_15px_rgba(245,158,11,0.4)] transition-all cursor-pointer';
        } else {
          btn.className = 'radar-site-btn px-4 py-2 rounded-xl text-xs font-mono font-bold border border-white/10 bg-white/[0.04] text-white hover:border-amber-400 transition-all cursor-pointer';
        }
      });

      const label = document.getElementById('radar-site-label');
      if (label) label.textContent = numSites + ' Active Sites';

      const adv = numSites * 17500;
      const muster = numSites * 10000;
      const mat = numSites * 20000;
      const retail = numSites * 12500;
      const monthlyTotal = adv + muster + mat + retail;
      const annualTotal = monthlyTotal * 12;

      const advEl = document.getElementById('radar-advances');
      const musterEl = document.getElementById('radar-muster');
      const matEl = document.getElementById('radar-materials');
      const retEl = document.getElementById('radar-retail');
      const monEl = document.getElementById('radar-monthly-total');
      const annEl = document.getElementById('radar-annual-total');

      if (advEl) advEl.textContent = '₹' + adv.toLocaleString('en-IN') + ' / mo';
      if (musterEl) musterEl.textContent = '₹' + muster.toLocaleString('en-IN') + ' / mo';
      if (matEl) matEl.textContent = '₹' + mat.toLocaleString('en-IN') + ' / mo';
      if (retEl) retEl.textContent = '₹' + retail.toLocaleString('en-IN') + ' / mo';
      if (monEl) monEl.textContent = '₹' + monthlyTotal.toLocaleString('en-IN') + ' / mo';
      
      const lakhs = (annualTotal / 100000).toFixed(1);
      if (annEl) annEl.textContent = '₹' + lakhs + ' Lakhs every year';
    }

    // 5. Jump to Scene Helper for Stacking Deck
    function jumpToScene(sceneId) {
      const el = document.getElementById(sceneId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // 6. Stacking Deck Scroll Observer & Timecode Engine
    const sceneTitles = {
      'scene-1': 'SCENE 01 // THE STAKES',
      'scene-2': 'SCENE 02 // CRIME SCENE LEAKS',
      'scene-3': 'SCENE 03 // 24H FIELD STORY',
      'scene-4': 'SCENE 04 // THE COCKPIT',
      'scene-5': 'SCENE 05 // PROFIT RADAR',
      'scene-6': 'SCENE 06 // TAKE COMMAND'
    };

    const sceneTimecodes = {
      'scene-1': '00:00:15',
      'scene-2': '00:01:20',
      'scene-3': '00:02:45',
      'scene-4': '00:04:10',
      'scene-5': '00:05:30',
      'scene-6': '00:07:00'
    };

    function initStackingDeckObserver() {
      const cards = Array.from(document.querySelectorAll('.stacked-card'));
      if (cards.length === 0) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const id = entry.target.id;
          const idx = cards.indexOf(entry.target);

          if (entry.isIntersecting && entry.intersectionRatio >= 0.4) {
            // Update HUD
            const titleEl = document.getElementById('hud-scene-title');
            const tcEl = document.getElementById('hud-timecode');
            if (titleEl && sceneTitles[id]) titleEl.textContent = sceneTitles[id];
            if (tcEl && sceneTimecodes[id]) tcEl.textContent = sceneTimecodes[id];

            // Update Chapter dots
            document.querySelectorAll('.film-hud-dot').forEach(dot => {
              if (dot.getAttribute('data-target') === id) {
                dot.classList.add('is-active');
              } else {
                dot.classList.remove('is-active');
              }
            });

            // Mark previous cards as receding for subtle 3D scale down
            cards.forEach((card, cIdx) => {
              if (cIdx < idx) {
                card.classList.add('is-receding');
              } else {
                card.classList.remove('is-receding');
              }
            });
          }
        });
      }, {
        threshold: [0.2, 0.5, 0.8]
      });

      cards.forEach(card => observer.observe(card));
    }

    // 7. Auto-Scroll "Play Reel" Mode
    let reelScrollInterval = null;
    let reelActiveSceneIndex = 0;
    const sceneList = ['scene-1', 'scene-2', 'scene-3', 'scene-4', 'scene-5', 'scene-6'];

    function toggleReelAutoScroll() {
      const icon = document.getElementById('reel-play-icon');
      const text = document.getElementById('reel-play-text');

      if (reelScrollInterval) {
        clearInterval(reelScrollInterval);
        reelScrollInterval = null;
        if (icon) icon.textContent = '▶';
        if (text) text.textContent = 'PLAY REEL';
      } else {
        if (icon) icon.textContent = '❚❚';
        if (text) text.textContent = 'PAUSE REEL';

        reelScrollInterval = setInterval(() => {
          reelActiveSceneIndex = (reelActiveSceneIndex + 1) % sceneList.length;
          jumpToScene(sceneList[reelActiveSceneIndex]);
        }, 5000);
      }
    }

    // 8. Lead Demo Form Submission Simulation
    document.addEventListener('DOMContentLoaded', () => {
      initStackingDeckObserver();

      const form = document.getElementById('lead-demo-form');
      const successBox = document.getElementById('demo-success-box');
      if (form && successBox) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
        });
      }
    });
  </script>
