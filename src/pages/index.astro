  <!-- SCRIPT ENGINE: LENIS SMOOTH SCROLL, GSAP REVEALS & FAQ ACCORDION -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger);

    // 1. LENIS SMOOTH SCROLLING
    let lenis: Lenis | null = null;
    try {
      lenis = new Lenis({
        lerp: 0.08,
        wheelMultiplier: 1.05,
        touchMultiplier: 1.2,
        smoothWheel: true,
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis?.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Smooth Anchor Navigation
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href !== '#' && href.startsWith('#')) {
            const target = document.querySelector(href);
            if (target && lenis) {
              e.preventDefault();
              lenis.scrollTo(target as HTMLElement, { offset: -60, duration: 1.2 });
            }
          }
        });
      });
    } catch (e) {
      console.warn('Lenis smooth scroll initialized with fallback', e);
    }

    // 2. MOTION REVEAL ENGINE
    function initMotionAnimations() {
      const elements = document.querySelectorAll('[data-motion]');
      if (!elements.length) return;

      document.body.classList.add('motion-js-ready');

      elements.forEach((el) => {
        const delay = (parseInt(el.getAttribute('data-delay') || '0', 10)) / 1000;
        gsap.fromTo(
          el,
          {
            opacity: 0,
            y: el.getAttribute('data-motion') === 'zoom-in' ? 18 : 30,
            scale: el.getAttribute('data-motion') === 'zoom-in' ? 0.96 : 1,
          },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.75,
            delay: delay,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            },
          }
        );
      });
    }

    // 3. STICKY STAGE CHOREOGRAPHY (SYNCHRONIZES SCREENS & BADGES AS YOU SCROLL)
    function initStickyScrollChoreography() {
      const milestones = document.querySelectorAll('.story-milestone-block');
      const activeLabel = document.getElementById('stage-active-label');
      const trackerPills = document.querySelectorAll('.story-step-indicator');
      const storyDevice = document.getElementById('story-3d-device');

      if (!milestones.length) return;

      const stageLabels: Record<string, string> = {
        '1': '01 // MUSTER ROLL LOCK',
        '2': '02 // CHALLAN PHOTO VERIFICATION',
        '3': '03 // CONTRACTOR ADVANCE LEDGER',
        '4': '04 // MASTER FINANCIAL AUDIT',
      };

      const stageRotations: Record<string, { rotateY: number; rotateX: number; scale: number; z: number }> = {
        '1': { rotateY: -4, rotateX: 3, scale: 1, z: 0 },
        '2': { rotateY: 4, rotateX: 4, scale: 1.01, z: 10 },
        '3': { rotateY: -3, rotateX: -2, scale: 1, z: 5 },
        '4': { rotateY: 0, rotateX: 0, scale: 1.02, z: 15 },
      };

      milestones.forEach((block) => {
        const stage = block.getAttribute('data-stage') || '1';

        ScrollTrigger.create({
          trigger: block,
          start: 'top 55%',
          end: 'bottom 45%',
          onEnter: () => activateStage(stage),
          onEnterBack: () => activateStage(stage),
        });
      });

      function activateStage(stage: string) {
        // 1. Cross-fade active slides
        for (let i = 1; i <= 4; i++) {
          const slide = document.getElementById('stage-slide-' + i);
          if (slide) {
            if (i === parseInt(stage, 10)) {
              slide.classList.remove('is-inactive');
              slide.classList.add('is-active');
              gsap.fromTo(
                slide.querySelectorAll('.physics-badge-layer'),
                { opacity: 0, y: 15 },
                { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }
              );
            } else {
              slide.classList.remove('is-active');
              slide.classList.add('is-inactive');
            }
          }
        }

        // 2. Subtle Device Elevation
        if (storyDevice && stageRotations[stage]) {
          const rot = stageRotations[stage];
          gsap.to(storyDevice, {
            rotateY: rot.rotateY,
            rotateX: rot.rotateX,
            scale: rot.scale,
            z: rot.z,
            duration: 0.6,
            ease: 'power2.out',
            transformPerspective: 1400,
          });
        }

        // 3. Update Label
        if (activeLabel && stageLabels[stage]) {
          activeLabel.textContent = stageLabels[stage];
        }

        // 4. Update Pills
        trackerPills.forEach((pill, idx) => {
          if (idx + 1 === parseInt(stage, 10)) {
            pill.className = 'story-step-indicator active-step h-2 w-6 rounded-full bg-blue transition-all duration-300';
          } else {
            pill.className = 'story-step-indicator h-2 w-2 rounded-full bg-slate-200 transition-all duration-300';
          }
        });
      }
    }

    // 4. ANIMATED STAT COUNTERS
    function initCounters() {
      const counters = document.querySelectorAll('[data-counter]');
      counters.forEach((el) => {
        const target = parseFloat(el.getAttribute('data-counter') || '0');
        const format = el.getAttribute('data-format') || 'raw';
        const obj = { val: 0 };

        gsap.to(obj, {
          val: target,
          duration: 1.4,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            toggleActions: 'play none none none',
          },
          onUpdate: () => {
            if (format === 'percent') {
              el.textContent = Math.round(obj.val) + '%';
            } else if (format === 'lakh') {
              el.textContent = '₹' + obj.val.toFixed(1) + 'L+';
            }
          },
        });
      });
    }

    // 5. FAQ ACCORDION ENGINE
    function initFaqAccordion() {
      const items = document.querySelectorAll('.faq-item');
      items.forEach((item) => {
        const btn = item.querySelector('.faq-toggle') as HTMLButtonElement | null;
        const content = item.querySelector('.faq-content') as HTMLElement | null;
        const icon = item.querySelector('.faq-icon') as HTMLElement | null;

        if (!btn || !content) return;

        btn.addEventListener('click', () => {
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';

          // Close all items
          items.forEach((other) => {
            const otherBtn = other.querySelector('.faq-toggle');
            const otherContent = other.querySelector('.faq-content');
            const otherIcon = other.querySelector('.faq-icon');
            if (otherBtn && otherContent) {
              otherBtn.setAttribute('aria-expanded', 'false');
              otherContent.classList.add('hidden');
              otherContent.classList.remove('block');
              if (otherIcon) {
                otherIcon.classList.remove('rotate-180', 'text-blue');
              }
            }
          });

          // Toggle current
          if (!isExpanded) {
            btn.setAttribute('aria-expanded', 'true');
            content.classList.remove('hidden');
            content.classList.add('block');
            if (icon) {
              icon.classList.add('rotate-180', 'text-blue');
            }
          }
        });
      });
    }

    function initPage() {
      initMotionAnimations();
      initStickyScrollChoreography();
      initCounters();
      initFaqAccordion();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage);
    } else {
      initPage();
    }
  </script>
