---
// Minimalist, world-class floating dark capsule navbar: Brand on left, Book a Demo on right, auto-hides on scroll
---

<header
  id="main-header"
  class="fixed top-3 sm:top-5 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-6xl transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
>
  <div class="rounded-full bg-[#0B0F1B]/85 backdrop-blur-xl border border-white/[0.12] shadow-[0_16px_40px_rgba(0,0,0,0.6)] px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between">
    <!-- Brand Logo & Name (Left) -->
    <a href="#" class="flex items-center gap-3 group focus-visible:outline-none" aria-label="Brift Homepage">
      <div class="relative flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-white shadow-[0_0_16px_rgba(59,130,246,0.5)] transition-transform group-hover:scale-105 border border-white/20">
        <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19h4v-5h4v-5h4V4h4" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-lg sm:text-xl font-extrabold tracking-tight text-white group-hover:text-blue-300 transition-colors">BRIFT</span>
        <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold tracking-wider bg-white/[0.06] border border-white/[0.08] text-slate-300">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>CON-OPS</span>
        </span>
      </div>
    </a>

    <!-- Single Action CTA (Right) -->
    <div class="flex items-center">
      <a
        href="#demo"
        class="relative inline-flex items-center justify-center rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-500 hover:from-blue-500 hover:to-indigo-500 text-white text-xs sm:text-sm font-bold px-4 sm:px-6 py-2 sm:py-2.5 shadow-[0_0_20px_rgba(59,130,246,0.35)] hover:shadow-[0_0_30px_rgba(59,130,246,0.6)] border border-blue-400/30 transition-all duration-200 active:scale-95 group focus-visible:outline-none"
      >
        <span>Book a Demo</span>
        <svg class="w-3.5 h-3.5 ml-1.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  function initHeaderAutoHide() {
    const header = document.getElementById('main-header');
    if (!header) return;

    let lastScrollY = window.pageYOffset || document.documentElement.scrollTop;
    let ticking = false;

    function handleScroll() {
      if (!header) return;
      const currentScrollY = window.pageYOffset || document.documentElement.scrollTop;

      // Always show near top of page
      if (currentScrollY <= 80) {
        header.classList.remove('-translate-y-28', 'opacity-0', 'pointer-events-none');
      } else if (currentScrollY > lastScrollY && currentScrollY > 120) {
        // Scrolling DOWN -> hide header smoothly
        header.classList.add('-translate-y-28', 'opacity-0', 'pointer-events-none');
      } else if (currentScrollY < lastScrollY) {
        // Scrolling UP -> reveal header
        header.classList.remove('-translate-y-28', 'opacity-0', 'pointer-events-none');
      }

      lastScrollY = Math.max(0, currentScrollY);
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(handleScroll);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderAutoHide);
  } else {
    initHeaderAutoHide();
  }
</script>
