---
import Layout from '../layouts/Layout.astro';
import {
  ArrowRight,
  ArrowDown,
  Check,
  CheckCircle2,
  Clock,
  ShieldCheck,
  Users,
  Truck,
  Wallet,
  Building,
  BarChart3,
  Calendar,
  Lock,
  MessageSquare,
  Mail,
  ChevronLeft,
  ChevronRight,
  Package,
  FileCheck2,
  PhoneCall
} from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Brift — Construction Operations Platform Built for Owners"
  description="Replace scattered site chats and paper registers with one reliable system. Brift gives civil contractors and builders complete control over daily labor attendance, material delivery challans, subcontractor cash advances, and project cash flow."
  schemaType="home"
>
  <!-- Background Blueprint Accent -->
  <div class="fixed inset-0 blueprint-grid opacity-25 pointer-events-none -z-20" aria-hidden="true"></div>

  <!-- MAIN SCROLLING CONTAINER WITH INITIAL LOAD FADE -->
  <div class="app-load-fade relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-16 sm:pb-24 space-y-24 sm:space-y-32 lg:space-y-40">

    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION: HIGH-CONVERTING VALUE PROPOSITION & EDITORIAL UI          -->
    <!-- ========================================================================= -->
    <section id="hero" class="relative pt-4 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        
        <!-- Left: Value Proposition & High-Intent Conversion Copy -->
        <div class="lg:col-span-6 space-y-5 sm:space-y-6 text-left">
          
          <div data-motion="fade-up" data-delay="100" class="inline-flex items-center gap-2 rounded-full border border-blue/20 bg-blue/10 px-3.5 py-1 text-xs font-semibold text-blue">
            <span class="w-2 h-2 rounded-full bg-blue"></span>
            <span>CONSTRUCTION OPERATIONS PLATFORM</span>
          </div>

          <h1 data-motion="fade-up" data-delay="150" class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-[1.12]">
            Replace scattered site chats and paper registers with <span class="text-blue">one reliable system.</span>
          </h1>

          <p data-motion="fade-up" data-delay="200" class="text-base sm:text-lg text-muted max-w-xl leading-relaxed">
            Brift gives civil contractors and builders complete control over daily labor attendance, material delivery challans, subcontractor cash advances, and project cash flow in real time.
          </p>

          <!-- Primary Actions -->
          <div data-motion="fade-up" data-delay="250" class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a
              href="#book-demo"
              class="inline-flex items-center justify-center rounded-xl bg-blue hover:bg-blue-hover text-white px-7 py-3.5 sm:py-4 text-sm sm:text-base font-bold shadow-sm hover:shadow-md transition-all active:scale-98 group cursor-pointer"
            >
              <span>Schedule a Live Demo</span>
              <ArrowRight class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
            </a>
            <a
              href="#story"
              class="inline-flex items-center justify-center rounded-xl bg-white hover:bg-slate-50 border border-line shadow-xs px-5 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-sm font-semibold text-ink transition-all gap-2"
            >
              <span>Explore Interactive Walkthrough</span>
              <ArrowDown class="w-4 h-4 text-muted animate-bounce" />
            </a>
          </div>

          <!-- Key Metrics Badges with Counter Animation -->
          <div class="pt-4 grid grid-cols-3 gap-3 max-w-lg">
            <div data-motion="fade-up" data-delay="300" class="rounded-xl border border-line bg-white p-3 sm:p-4 shadow-xs">
              <span data-counter="29.5" data-format="lakh" class="text-base sm:text-2xl font-black text-ink block leading-tight">₹29.5L+</span>
              <span class="text-[11px] sm:text-xs text-muted block leading-tight mt-1">Monthly site volume</span>
            </div>
            <div data-motion="fade-up" data-delay="350" class="rounded-xl border border-line bg-white p-3 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-emerald-600 block leading-tight">100% Offline</span>
              <span class="text-[11px] sm:text-xs text-muted block leading-tight mt-1">Works in basements</span>
            </div>
            <div data-motion="fade-up" data-delay="400" class="rounded-xl border border-line bg-white p-3 sm:p-4 shadow-xs">
              <span class="text-base sm:text-2xl font-black text-blue block leading-tight">48 Hours</span>
              <span class="text-[11px] sm:text-xs text-muted block leading-tight mt-1">Rapid team setup</span>
            </div>
          </div>

        </div>

        <!-- Right: Editorial Brift UI Showcase (Custom Brand Image) -->
        <div data-motion="zoom-in" data-delay="200" class="lg:col-span-6 relative">
          <div class="relative rounded-2xl sm:rounded-3xl border border-line bg-white p-3 sm:p-4 shadow-[0_15px_45px_-10px_rgba(14,17,22,0.1)] overflow-hidden">
            
            <img
              src={`${base}/images/brift_hero_editorial.jpg`}
              alt="Brift Construction Operations Platform UI on laptop and mobile at active construction site"
              class="w-full h-auto rounded-xl sm:rounded-2xl object-cover shadow-xs"
              loading="eager"
              fetchpriority="high"
              width="1280"
              height="720"
            />

            <!-- Sliced Telemetry Overlay Chips -->
            <div class="absolute top-6 left-6 rounded-xl border border-white/90 bg-white/95 backdrop-blur-md p-2.5 sm:p-3 shadow-lg hidden sm:block">
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                  <Check class="w-3.5 h-3.5" />
                </span>
                <div>
                  <span class="text-[9px] uppercase font-mono tracking-wider text-muted block">Attendance Record</span>
                  <span class="text-xs font-bold text-ink block">Locked & Timestamped</span>
                </div>
              </div>
            </div>

            <div class="absolute bottom-6 right-6 rounded-xl border border-white/90 bg-white/95 backdrop-blur-md p-2.5 sm:p-3 shadow-lg">
              <div class="flex items-center gap-2">
                <div class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-ping"></div>
                <div>
                  <span class="text-[9px] uppercase font-mono tracking-wider text-muted block">Basement Mode</span>
                  <span class="text-xs font-bold text-ink block">0 Signal • Auto-Sync</span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. THE 3 PRIMARY OPERATIONAL LEAKS (WHERE MONEY SILENTLY LEAKS)            -->
    <!-- ========================================================================= -->
    <section id="leaks" class="relative">
      
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-10 sm:mb-14 space-y-2.5">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-3.5 py-1 rounded-full">
          OPERATIONAL LEAKS
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-ink leading-tight">
          Where Money Silently Leaks on Construction Sites
        </h2>
        <p class="text-sm sm:text-base text-muted">
          Contractors lose 3% to 6% of project margins every month through manual logs and delayed reporting:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
        
        <!-- Leak 1 -->
        <div data-motion="fade-up" data-delay="100" class="motion-card-hover rounded-2xl border border-line bg-white p-6 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase text-ink bg-slate-100 px-2.5 py-0.5 rounded flex items-center gap-1.5">
              <Users class="w-3.5 h-3.5 text-slate-600" />
              <span>Leak 01</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹40,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-ink">Ghost Labor & Muster Inflation</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Attendance taken on paper notebooks or verbal calls allows extra unverified workers to be added to the Saturday tally before billing.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1.5">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Brift Fix: Offline locked gate muster roll</span>
          </div>
        </div>

        <!-- Leak 2 -->
        <div data-motion="fade-up" data-delay="200" class="motion-card-hover rounded-2xl border border-line bg-white p-6 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase text-ink bg-slate-100 px-2.5 py-0.5 rounded flex items-center gap-1.5">
              <Truck class="w-3.5 h-3.5 text-slate-600" />
              <span>Leak 02</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹80,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-ink">Unverified Delivery Challans</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Trucks arrive and slips are signed in pencil. Without photo proof of unloaded bags, contractors pay bills for materials never received on site.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1.5">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Brift Fix: Gate photo challan match against PO</span>
          </div>
        </div>

        <!-- Leak 3 -->
        <div data-motion="fade-up" data-delay="300" class="motion-card-hover rounded-2xl border border-line bg-white p-6 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase text-ink bg-slate-100 px-2.5 py-0.5 rounded flex items-center gap-1.5">
              <Wallet class="w-3.5 h-3.5 text-slate-600" />
              <span>Leak 03</span>
            </span>
            <span class="text-xs font-mono font-bold text-red-600">-₹70,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-ink">Untracked Pocket Advances</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Site engineers hand out cash advances to subcontractors and record them in pocket diaries, leading to bitter disputes at final settlement.
          </p>
          <div class="pt-2 border-t border-slate-100 text-xs text-blue font-semibold flex items-center gap-1.5">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Brift Fix: Instant auto-deduct ledger on payouts</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. STICKY PARALLAX WALKTHROUGH: FROM MORNING TO NIGHT                      -->
    <!-- ========================================================================= -->
    <section id="story" class="relative">
      
      <!-- Section Intro Header -->
      <div data-motion="fade-up" class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-2.5">
        <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-blue bg-blue/10 border border-blue/20 px-3.5 py-1 rounded-full">
          SCROLL WALKTHROUGH
        </span>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-ink leading-tight">
          How Brift Runs Your Sites From Morning to Night
        </h2>
        <p class="text-sm sm:text-base text-muted">
          Scroll down to experience the product in action. The live stage below tracks your scroll naturally:
        </p>
      </div>

      <!-- STICKY CHOREOGRAPHY TRACK -->
      <div class="sticky-stage-track relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- LEFT COLUMN: NARRATIVE MILESTONES (SCROLLS NATURALLY) -->
        <div class="lg:col-span-5 space-y-28 sm:space-y-36 py-4">
          
          <!-- MILESTONE 1: ATTENDANCE -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                01 // 07:00 AM
              </span>
              <span class="text-xs font-mono text-muted font-semibold uppercase">Site Gate Entrance</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-ink leading-tight">
              Muster roll logged at the gate — works 100% offline.
            </h3>
            <p class="text-xs sm:text-base text-muted leading-relaxed">
              Thirty workers arrive at the gate. Even in a basement with zero cellular reception, the supervisor taps skilled and unskilled counts in Brift. The record locks permanently with timestamps and automatically syncs to payroll the moment signal connects.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Zero ghost labor. Saturday muster disputes are eliminated.</span>
            </div>
            <!-- Mobile Fallback Image -->
            <div class="block lg:hidden pt-3">
              <img src={`${base}/images/brift_muster_attendance.jpg`} alt="Muster Roll Log" class="w-full h-auto rounded-xl border border-line shadow-sm" />
            </div>
          </div>

          <!-- MILESTONE 2: MATERIALS -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                02 // 11:30 AM
              </span>
              <span class="text-xs font-mono text-muted font-semibold uppercase">Material Delivery Bay</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-ink leading-tight">
              Delivery challan photographed before unloading begins.
            </h3>
            <p class="text-xs sm:text-base text-muted leading-relaxed">
              A supplier truck delivers 200 bags of cement. The site engineer snaps a photo of the physical delivery challan in Brift. Central procurement matches it against the approved purchase order in real time.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Billed bags always equal unloaded bags. Duplicate billing is blocked.</span>
            </div>
            <!-- Mobile Fallback Image -->
            <div class="block lg:hidden pt-3">
              <img src={`${base}/images/brift_material_challan.jpg`} alt="Material Challan Verification" class="w-full h-auto rounded-xl border border-line shadow-sm" />
            </div>
          </div>

          <!-- MILESTONE 3: CASH ADVANCES -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="3">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                03 // 03:15 PM
              </span>
              <span class="text-xs font-mono text-muted font-semibold uppercase">Site Office Settlement</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-ink leading-tight">
              Cash advances recorded and auto-deducted from billing.
            </h3>
            <p class="text-xs sm:text-base text-muted leading-relaxed">
              The electrical subcontractor requests a ₹35,000 cash advance. The site engineer logs it instantly with timestamp and recipient details. On Saturday billing, Brift automatically deducts the advance from measurement payouts.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Zero forgotten pocket diary advances. Both parties see the same audited record.</span>
            </div>
            <!-- Mobile Fallback Card -->
            <div class="block lg:hidden pt-3 p-4 rounded-xl border border-line bg-white shadow-sm space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-ink">Subcontractor Electrical Settlement</span>
                <span class="font-mono text-emerald-600 font-bold">Auto-Deducted</span>
              </div>
              <div class="text-xs text-muted">Running Bill #04 • Advance ₹35,000 locked to measurement payment</div>
            </div>
          </div>

          <!-- MILESTONE 4: OWNER DASHBOARD -->
          <div class="story-milestone-block space-y-4 text-left" data-stage="4">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-blue bg-blue/10 border border-blue/20">
                04 // 07:30 PM
              </span>
              <span class="text-xs font-mono text-muted font-semibold uppercase">Executive Overview</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-ink leading-tight">
              All sites reconciled on one screen. No 40 phone calls.
            </h3>
            <p class="text-xs sm:text-base text-muted leading-relaxed">
              In under 5 minutes from your phone or office, review live project burn rates, bank balances, stage milestone completions, and 7 auto-generated PDF audit reports.
            </p>
            <div class="p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/70 text-xs sm:text-sm text-emerald-900 flex items-center gap-2.5">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span><strong>Result:</strong> Complete peace of mind and verified profit margins across all active sites.</span>
            </div>
            <!-- Mobile Fallback Card -->
            <div class="block lg:hidden pt-3 p-4 rounded-xl border border-line bg-white shadow-sm space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-ink">Multi-Site Executive Overview</span>
                <span class="font-mono text-blue font-bold">4 Sites Synced</span>
              </div>
              <div class="text-xs text-muted">Company Funds: ₹28,50,000 • Receivables: ₹17,20,000</div>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: STICKY 3D PINNED STAGE (DESKTOP SYNCHRONIZED THEATER) -->
        <div class="hidden lg:block lg:col-span-7 sticky-stage-display theater-3d-stage">
          <div
            id="story-3d-device"
            class="device-3d-canvas rounded-2xl border border-line bg-white p-4 shadow-[0_20px_50px_-10px_rgba(14,17,22,0.12)] relative overflow-hidden h-[495px]"
          >
            <!-- Stage Top Bar with Active Chapter Indicator -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-line text-xs font-mono text-muted relative z-20">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="stage-active-label" class="font-bold text-ink">01 // MUSTER ROLL LOCK</span>
              </div>
              <!-- Step Progress Tracker Pills -->
              <div class="flex items-center gap-1.5" id="stage-tracker-pills">
                <span class="story-step-indicator active-step h-2 w-6 rounded-full bg-blue"></span>
                <span class="story-step-indicator h-2 w-2 rounded-full bg-slate-200"></span>
                <span class="story-step-indicator h-2 w-2 rounded-full bg-slate-200"></span>
                <span class="story-step-indicator h-2 w-2 rounded-full bg-slate-200"></span>
              </div>
            </div>

            <!-- Screen Slide 1: Gate Muster Roll -->
            <div id="stage-slide-1" class="stage-screen-slide is-active">
              <div class="relative w-full h-[410px] rounded-xl overflow-hidden border border-line shadow-xs">
                <img
                  src={`${base}/images/brift_muster_attendance.jpg`}
                  alt="Site attendance and daily photo update feed"
                  class="w-full h-full object-cover"
                />
              </div>
              <!-- Sliced Physics Badge Layer 1 -->
              <div class="physics-badge-layer slice-z-high bottom-6 left-6 rounded-xl border border-white/95 bg-white/95 backdrop-blur-md p-3 shadow-xl">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                    <Check class="w-4 h-4 font-bold" />
                  </span>
                  <div>
                    <span class="text-[9px] uppercase font-mono tracking-wider text-muted block">Gate Verification</span>
                    <span class="text-xs font-bold text-ink">38 Skilled • 12 Unskilled Locked</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Screen Slide 2: Materials & Delivery Challan Verification -->
            <div id="stage-slide-2" class="stage-screen-slide is-inactive">
              <div class="relative w-full h-[410px] rounded-xl overflow-hidden border border-line shadow-xs">
                <img
                  src={`${base}/images/brift_material_challan.jpg`}
                  alt="Materials stock ledger and delivery intake"
                  class="w-full h-full object-cover"
                />
              </div>
              <!-- Sliced Physics Badge Layer 2 -->
              <div class="physics-badge-layer slice-z-high bottom-6 left-6 rounded-xl border border-white/95 bg-white/95 backdrop-blur-md p-3 shadow-xl">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-blue/10 text-blue">
                    <Truck class="w-4 h-4 font-bold" />
                  </span>
                  <div>
                    <span class="text-[9px] uppercase font-mono tracking-wider text-muted block">Delivery Challan Photo</span>
                    <span class="text-xs font-bold text-ink">200 Cement Bags Photo-Matched to PO</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Screen Slide 3: Cash Advances Auto-Deductions -->
            <div id="stage-slide-3" class="stage-screen-slide is-inactive">
              <div class="relative w-full h-[410px] rounded-xl overflow-hidden border border-line bg-slate-50 p-6 flex flex-col justify-between">
                <div class="space-y-3">
                  <div class="flex items-center justify-between border-b border-line pb-3">
                    <span class="font-bold text-sm text-ink">Contractor Advance Ledger</span>
                    <span class="font-mono text-xs font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">Auto-Deducted</span>
                  </div>
                  <div class="p-4 rounded-xl bg-white border border-line space-y-2">
                    <div class="text-xs text-muted">Subcontractor: <strong>Apex Electricals</strong></div>
                    <div class="text-sm font-bold text-ink">Cash Advance Requested: ₹35,000</div>
                    <div class="text-xs text-emerald-700 font-mono">Deducted from Saturday Running Bill #04</div>
                  </div>
                </div>
                <div class="p-3 rounded-lg bg-blue-soft border border-blue/20 text-xs text-blue font-semibold">
                  ✓ Recorded with named supervisor timestamp
                </div>
              </div>
              <!-- Sliced Physics Badge Layer 3 -->
              <div class="physics-badge-layer slice-z-high bottom-6 left-6 rounded-xl border border-white/95 bg-white/95 backdrop-blur-md p-3 shadow-xl">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-100 text-amber-800">
                    <Wallet class="w-4 h-4 font-bold" />
                  </span>
                  <div>
                    <span class="text-[9px] uppercase font-mono tracking-wider text-muted block">Advance Settlement</span>
                    <span class="text-xs font-bold text-ink">₹35,000 Running Bill Advance Synced</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Screen Slide 4: Owner Executive Multi-Site Dashboard -->
            <div id="stage-slide-4" class="stage-screen-slide is-inactive">
