---
import Layout from '../layouts/Layout.astro';
import {
  Calendar,
  Clock,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  ArrowRight,
  ArrowLeft,
  ShieldCheck,
  MessageSquare,
  Building,
  Mail,
  Phone
} from 'lucide-astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Schedule a Product Demo — Brift"
  description="Book a 30-minute 1-on-1 walkthrough of Brift Construction OS. See how daily attendance, material challans, and contractor advances are managed in real time."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    
    <!-- Top Back Navigation -->
    <div class="mb-6 sm:mb-8">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-500 hover:text-blue transition-colors group"
      >
        <ArrowLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
        <span>Back to Brift Overview</span>
      </a>
    </div>

    <!-- Clean Header Banner -->
    <div class="max-w-2xl mb-8 sm:mb-10 space-y-2.5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono font-semibold uppercase tracking-wider text-blue bg-blue/10 border border-blue/20">
        <span>30-Minute Live Walkthrough</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Book a 1-on-1 Product Demo
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Select a date and time slot below. We will show you how Brift tracks daily muster rolls, vendor delivery challans, and cash advances live in the software — tailored to your active site count.
      </p>
    </div>

    <!-- Main Booking Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <!-- Left Column: What to Expect & Essential Notices (5 Cols) -->
      <div class="lg:col-span-5 space-y-5">
        
        <!-- Walkthrough Summary Card -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs space-y-5">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">
            What to Expect
          </h2>

          <div class="space-y-4 text-xs sm:text-sm">
            <div class="flex items-start gap-3">
              <Clock class="w-4 h-4 text-blue shrink-0 mt-0.5" />
              <div>
                <span class="font-bold text-slate-900 block">30 Minutes Focused Session</span>
                <span class="text-slate-500 text-xs">Direct walkthrough of the platform tailored to your project operations.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <Calendar class="w-4 h-4 text-blue shrink-0 mt-0.5" />
              <div>
                <span class="font-bold text-slate-900 block">Google Meet Video Call</span>
                <span class="text-slate-500 text-xs">A meeting invite and video link will be sent to your email immediately.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <ShieldCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <div>
                <span class="font-bold text-slate-900 block">Confidential & Zero Pressure</span>
                <span class="text-slate-500 text-xs">No spam or aggressive sales follow-ups. Direct discussion with our solutions team.</span>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 space-y-2.5">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 block">
              Key Areas Covered:
            </span>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Offline attendance & muster roll locking</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Material delivery challan photo verification</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Contractor advances & auto-deduction settlements</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                <span>Live owner dashboard & multi-site reporting</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Quick Contact Assistance -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-xs text-slate-700 space-y-2.5">
          <span class="font-bold uppercase tracking-wider text-[11px] font-mono text-slate-900 block">
            Prefer immediate scheduling?
          </span>
          <p class="text-slate-600 leading-relaxed text-xs">
            Connect directly with our team on WhatsApp or phone for immediate assistance:
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            <a
              href="https://wa.me/919037532036?text=Hi%20Brift%20team,%20I%20would%20like%20to%20schedule%20a%20demo%20for%20my%20construction%20company"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 font-semibold transition-all shadow-xs"
            >
              <MessageSquare class="w-3.5 h-3.5" />
              <span>WhatsApp: +91 9037532036</span>
            </a>
            <a
              href="mailto:brift.official@gmail.com"
              class="inline-flex items-center gap-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 px-3 py-1.5 font-medium transition-all"
            >
              <Mail class="w-3.5 h-3.5 text-slate-500" />
              <span>brift.official@gmail.com</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Scheduling Form (7 Cols) -->
      <div id="booking-container" class="lg:col-span-7">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm relative">
          
          <div class="border-b border-slate-100 pb-4 mb-6 flex items-center justify-between">
            <div>
              <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-blue block">Direct Scheduling</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Select Date & Time Slot</h2>
            </div>
            <span class="text-[10px] font-mono text-slate-600 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-full font-medium">
              Timezone: IST (UTC+5:30)
            </span>
          </div>

          <!-- Scheduling Form -->
          <form id="lead-demo-form" class="space-y-6">
            
            <!-- SECTION 1: CALENDAR & TIME SLOTS -->
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-slate-800 uppercase tracking-wide flex items-center gap-1.5">
                  <Calendar class="w-4 h-4 text-blue" />
                  <span>1. Choose Preferred Date</span>
                </span>
                <span id="cal-selected-day-label" class="text-xs font-mono text-blue font-bold"></span>
              </div>

              <!-- Visual Month & Days Calendar Widget -->
              <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5 sm:p-4">
                <!-- Month Navigator -->
                <div class="flex items-center justify-between pb-3 mb-2.5 border-b border-slate-200">
                  <span id="cal-month-title" class="text-sm sm:text-base font-bold text-slate-900 capitalize"></span>
                  <div class="flex items-center gap-1">
                    <button
                      type="button"
                      id="cal-prev-month-btn"
                      class="p-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 transition-colors disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
                      aria-label="Previous month"
                    >
                      <ChevronLeft class="w-4 h-4" />
                    </button>
                    <button
                      type="button"
                      id="cal-next-month-btn"
                      class="p-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 transition-colors cursor-pointer"
                      aria-label="Next month"
                    >
                      <ChevronRight class="w-4 h-4" />
                    </button>
                  </div>
                </div>

                <!-- Days of Week Header -->
                <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-mono font-semibold text-slate-400 mb-1.5">
                  <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span class="text-rose-400">Sun</span>
                </div>

                <!-- Calendar Days Grid (Populated dynamically) -->
                <div id="cal-days-grid" class="grid grid-cols-7 gap-1 sm:gap-1.5 text-center"></div>
              </div>

              <!-- Time Slot Grid -->
              <div class="space-y-2 pt-1">
                <label class="block text-xs font-mono text-slate-700 font-semibold">2. Choose Time Slot (30 Mins) *</label>
                <div id="time-slots-grid" class="grid grid-cols-3 sm:grid-cols-6 gap-2"></div>
              </div>

              <!-- Selected Slot Summary Banner -->
              <div id="slot-selection-summary" class="flex items-center justify-between rounded-xl bg-blue/10 border border-blue/20 px-3.5 py-2.5 text-xs text-blue-950">
                <div class="flex items-center gap-2 truncate">
                  <Clock class="w-4 h-4 text-blue shrink-0" />
                  <span class="truncate">Selected Slot: <strong id="selected-slot-text"></strong></span>
                </div>
                <span class="text-[10px] font-mono text-blue-800 bg-blue-100 px-2 py-0.5 rounded-md font-bold shrink-0">30 MINS</span>
              </div>

              <!-- Hidden form inputs -->
              <input type="hidden" id="booking-date" name="scheduled_date" value="" required />
              <input type="hidden" id="booking-time" name="scheduled_time" value="" required />
            </div>

            <!-- SECTION 2: ATTENDEE CONTACT DETAILS -->
            <div class="space-y-4 pt-3 border-t border-slate-100">
              <span class="text-xs font-mono font-bold text-slate-800 uppercase tracking-wide flex items-center gap-1.5">
                <Building class="w-4 h-4 text-blue" />
                <span>3. Your Information</span>
              </span>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label for="demo-name" class="block text-xs font-medium text-slate-700 mb-1">Full Name *</label>
                  <input
                    type="text"
                    id="demo-name"
                    name="name"
                    required
                    placeholder="e.g. Rajesh Kumar"
                    class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue focus:ring-1 focus:ring-blue focus:outline-none transition-colors"
                  />
                </div>

                <div>
                  <label for="demo-phone" class="block text-xs font-medium text-slate-700 mb-1">WhatsApp / Phone *</label>
                  <input
                    type="tel"
                    id="demo-phone"
                    name="phone"
                    required
                    placeholder="+91 98765 43210"
                    class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue focus:ring-1 focus:ring-blue focus:outline-none transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label for="demo-email" class="block text-xs font-medium text-slate-700 mb-1">Work Email (for Calendar Invite) *</label>
                  <input
                    type="email"
                    id="demo-email"
                    name="email"
                    required
                    placeholder="name@company.com"
                    class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue focus:ring-1 focus:ring-blue focus:outline-none transition-colors"
                  />
                </div>

                <div>
                  <label for="demo-company" class="block text-xs font-medium text-slate-700 mb-1">Company / Contractor Name *</label>
                  <input
                    type="text"
                    id="demo-company"
                    name="company"
                    required
                    placeholder="e.g. Apex Builders"
                    class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue focus:ring-1 focus:ring-blue focus:outline-none transition-colors"
                  />
                </div>
              </div>

              <div>
                <label for="demo-sites" class="block text-xs font-medium text-slate-700 mb-1">Active Projects Count *</label>
                <select
                  id="demo-sites"
                  name="active_sites"
                  required
                  class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 focus:border-blue focus:ring-1 focus:ring-blue focus:outline-none transition-colors"
                >
                  <option value="1-2">1 to 2 Active Sites</option>
                  <option value="3-5" selected>3 to 5 Active Sites</option>
                  <option value="6-10">6 to 10 Active Sites</option>
                  <option value="10+">10+ Multi-Site Projects</option>
                </select>
              </div>
            </div>

            <!-- Error Notification Alert -->
            <div id="demo-error-box" class="hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800"></div>

            <!-- Submit CTA Button -->
            <div class="pt-2">
              <button
                type="submit"
                id="submit-demo-btn"
                class="w-full rounded-xl bg-blue hover:bg-blue-hover text-white font-bold text-sm py-3.5 px-6 shadow-sm transition-all cursor-pointer active:scale-98 flex items-center justify-center gap-2 group"
              >
                <Calendar class="w-4 h-4" />
                <span id="submit-demo-btn-text">Confirm Demo Booking</span>
                <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </button>
            </div>

            <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1">
              <span>Your information is kept strictly confidential.</span>
              <span>Dispatched to brift.official@gmail.com</span>
            </div>
          </form>

          <!-- Success State -->
          <div id="demo-success-box" class="hidden py-6 space-y-5">
            <div class="text-center space-y-2">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                <CheckCircle2 class="w-7 h-7" />
              </div>
              <h3 class="text-2xl font-bold text-slate-900">Demo Scheduled Successfully</h3>
              <p class="text-xs sm:text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
                We have reserved your slot. A meeting confirmation has been dispatched to <strong>brift.official@gmail.com</strong> and your email.
              </p>
            </div>

            <!-- Booking Summary -->
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5 space-y-3.5 text-left">
              <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-700">Appointment Details</span>
                <span class="text-[10px] font-mono text-emerald-800 bg-emerald-100 border border-emerald-300 px-2.5 py-0.5 rounded font-bold">
                  CONFIRMED
                </span>
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
                <div>
                  <span class="text-slate-500 block text-[11px]">Date & Time:</span>
                  <strong id="conf-slot-time" class="text-slate-900"></strong>
                </div>
                <div>
                  <span class="text-slate-500 block text-[11px]">Format:</span>
                  <strong class="text-slate-900">30-Min Google Meet Walkthrough</strong>
                </div>
                <div>
                  <span class="text-slate-500 block text-[11px]">Attendee:</span>
                  <span id="conf-attendee" class="text-slate-900 font-medium"></span>
                </div>
                <div>
                  <span class="text-slate-500 block text-[11px]">Contact:</span>
                  <span id="conf-phone" class="text-slate-900 font-mono"></span>
                </div>
              </div>
            </div>

            <!-- Calendar Action Buttons -->
            <div class="space-y-2 pt-1">
              <a
                id="btn-google-cal"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-blue hover:bg-blue-hover text-white py-3 px-4 text-xs sm:text-sm font-bold transition-all shadow-xs"
              >
                <Calendar class="w-4 h-4" />
                <span>Add to Google Calendar</span>
              </a>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <button
                  type="button"
                  id="btn-download-ics"
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 py-2.5 px-3 text-xs font-semibold shadow-2xs transition-all cursor-pointer"
                >
                  <Calendar class="w-3.5 h-3.5 text-slate-500" />
                  <span>Download .ics Calendar</span>
                </button>

                <a
                  id="btn-whatsapp-conf"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white py-2.5 px-3 text-xs font-bold transition-all shadow-2xs"
                >
                  <MessageSquare class="w-3.5 h-3.5" />
                  <span>Confirm on WhatsApp</span>
                </a>
              </div>
            </div>

            <p class="text-center text-xs text-slate-500 pt-2">
              Need to reschedule? Reach out directly via WhatsApp at <span class="font-medium text-slate-700">+91 9037532036</span>.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Client-Side Calendar Scheduling Engine -->
  <script is:inline>
    function initBookingPageCalendar() {
      const form = document.getElementById('lead-demo-form');
      const successBox = document.getElementById('demo-success-box');
      const daysGrid = document.getElementById('cal-days-grid');
      const monthTitle = document.getElementById('cal-month-title');
      const prevMonthBtn = document.getElementById('cal-prev-month-btn');
      const nextMonthBtn = document.getElementById('cal-next-month-btn');
      const slotsGrid = document.getElementById('time-slots-grid');
      const selectedDayLabel = document.getElementById('cal-selected-day-label');
      const selectedSlotText = document.getElementById('selected-slot-text');
      const bookingDateInput = document.getElementById('booking-date');
      const bookingTimeInput = document.getElementById('booking-time');
      const submitBtn = document.getElementById('submit-demo-btn');
      const submitBtnText = document.getElementById('submit-demo-btn-text');
      const errorBox = document.getElementById('demo-error-box');

      if (!form || !daysGrid || !slotsGrid) return;

      const timeSlots = [
        '10:00 AM',
        '11:30 AM',
        '02:00 PM',
        '03:30 PM',
        '05:00 PM',
        '06:30 PM'
      ];

      const today = new Date();
      let browseYear = today.getFullYear();
      let browseMonth = today.getMonth();

      let selectedDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
      if (selectedDate.getDay() === 0) {
        selectedDate.setDate(selectedDate.getDate() + 1);
      }
      let selectedSlot = '11:30 AM';

      const monthNames = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'
      ];
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

      function formatDateDisplay(d) {
        return dayNames[d.getDay()] + ', ' + monthNames[d.getMonth()].slice(0, 3) + ' ' + d.getDate() + ', ' + d.getFullYear();
      }

      function formatShortDate(d) {
        return dayNames[d.getDay()] + ', ' + monthNames[d.getMonth()].slice(0, 3) + ' ' + d.getDate();
      }

      function updateSlotDisplay() {
        if (selectedDayLabel) {
          selectedDayLabel.textContent = formatShortDate(selectedDate);
        }
        if (selectedSlotText) {
          selectedSlotText.textContent = formatDateDisplay(selectedDate) + ' @ ' + selectedSlot + ' IST';
        }
        if (bookingDateInput) {
          bookingDateInput.value = selectedDate.toISOString().split('T')[0];
        }
        if (bookingTimeInput) {
          bookingTimeInput.value = selectedSlot + ' IST';
        }
      }

      function renderTimeSlots() {
        slotsGrid.innerHTML = '';
        timeSlots.forEach((slot) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = (slot === selectedSlot)
            ? 'py-2 px-1 text-center rounded-lg text-xs font-mono font-bold bg-blue text-white shadow-xs transition-all cursor-pointer'
            : 'py-2 px-1 text-center rounded-lg text-xs font-mono font-medium bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 transition-all cursor-pointer';
          btn.textContent = slot;

          btn.addEventListener('click', () => {
            selectedSlot = slot;
            renderTimeSlots();
            updateSlotDisplay();
          });

          slotsGrid.appendChild(btn);
        });
      }

      function renderCalendar() {
        if (monthTitle) {
          monthTitle.textContent = monthNames[browseMonth] + ' ' + browseYear;
        }

        const isCurrentMonth = (browseYear === today.getFullYear() && browseMonth === today.getMonth());
        if (prevMonthBtn) {
          prevMonthBtn.disabled = isCurrentMonth;
        }

        daysGrid.innerHTML = '';

        const firstDayIndex = new Date(browseYear, browseMonth, 1).getDay();
        const mondayOffset = (firstDayIndex === 0 ? 6 : firstDayIndex - 1);
        const daysInMonth = new Date(browseYear, browseMonth + 1, 0).getDate();

        for (let i = 0; i < mondayOffset; i++) {
          const empty = document.createElement('div');
          empty.className = 'py-2';
          daysGrid.appendChild(empty);
        }

        const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

        for (let day = 1; day <= daysInMonth; day++) {
          const thisDate = new Date(browseYear, browseMonth, day);
          const isSunday = (thisDate.getDay() === 0);
          const isPast = (thisDate < todayStart);
          const isToday = (thisDate.getTime() === todayStart.getTime());
          const isSelected = (
            selectedDate &&
            thisDate.getFullYear() === selectedDate.getFullYear() &&
            thisDate.getMonth() === selectedDate.getMonth() &&
            thisDate.getDate() === selectedDate.getDate()
          );

          const cell = document.createElement('button');
          cell.type = 'button';
          cell.textContent = day;

          if (isSunday || isPast) {
            cell.disabled = true;
            cell.className = 'py-2 text-xs font-mono rounded-lg text-slate-300 cursor-not-allowed';
            if (isSunday) cell.classList.add('bg-rose-50/40', 'text-rose-300');
          } else if (isSelected) {
            cell.className = 'py-2 text-xs font-mono font-bold rounded-lg bg-blue text-white shadow-xs cursor-pointer';
          } else if (isToday) {
            cell.className = 'py-2 text-xs font-mono font-bold rounded-lg border border-blue text-blue hover:bg-blue/5 cursor-pointer';
          } else {
            cell.className = 'py-2 text-xs font-mono rounded-lg text-slate-700 hover:bg-slate-200/80 cursor-pointer';
          }

          if (!isSunday && !isPast) {
            cell.addEventListener('click', () => {
              selectedDate = thisDate;
              renderCalendar();
              updateSlotDisplay();
            });
          }

          daysGrid.appendChild(cell);
        }
      }

      if (prevMonthBtn) {
        prevMonthBtn.addEventListener('click', () => {
          if (browseMonth === 0) {
            browseMonth = 11;
            browseYear--;
          } else {
            browseMonth--;
          }
          renderCalendar();
        });
      }

      if (nextMonthBtn) {
        nextMonthBtn.addEventListener('click', () => {
          if (browseMonth === 11) {
            browseMonth = 0;
            browseYear++;
          } else {
            browseMonth++;
          }
          renderCalendar();
        });
      }

      renderCalendar();
      renderTimeSlots();
      updateSlotDisplay();

      // Form Submit Handler
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorBox) errorBox.classList.add('hidden');

        const name = document.getElementById('demo-name')?.value.trim();
        const phone = document.getElementById('demo-phone')?.value.trim();
        const email = document.getElementById('demo-email')?.value.trim();
        const company = document.getElementById('demo-company')?.value.trim();
        const activeSites = document.getElementById('demo-sites')?.value;
        const scheduledDate = bookingDateInput?.value;
        const scheduledTime = bookingTimeInput?.value;

        if (!name || !phone || !email || !company || !scheduledDate || !scheduledTime) {
          if (errorBox) {
            errorBox.textContent = 'Please fill out all required fields and select a date & slot.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = 'Securing Your Slot...';

        const payload = {
          name: name,
          email: email,
          phone: phone,
          company: company,
          active_sites: activeSites,
          scheduled_date: scheduledDate,
          scheduled_time: scheduledTime,
          _subject: `New Demo Scheduled: ${name} (${company}) — ${scheduledDate} @ ${scheduledTime}`,
          _captcha: "false",
          _template: "table"
        };

        try {
          const res = await fetch("https://formsubmit.co/ajax/brift.official@gmail.com", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify(payload)
          });

          const data = await res.json().catch(() => ({}));

          if (res.ok || data.success === "true" || data.success === true) {
            form.classList.add('hidden');
            if (successBox) successBox.classList.remove('hidden');

            const confSlotTime = document.getElementById('conf-slot-time');
            const confAttendee = document.getElementById('conf-attendee');
            const confPhone = document.getElementById('conf-phone');
            if (confSlotTime) confSlotTime.textContent = formatDateDisplay(selectedDate) + ' @ ' + selectedSlot + ' IST';
            if (confAttendee) confAttendee.textContent = name + ' • ' + company;
            if (confPhone) confPhone.textContent = phone + ' (' + email + ')';

            setupConfirmationCalendarLinks({
              name,
              company,
              email,
              phone,
              activeSites,
              dateObj: selectedDate,
              timeStr: selectedSlot
            });

            successBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } else {
            throw new Error(data.message || 'Unable to schedule slot. Please try again.');
          }
        } catch (err) {
          console.error(err);
          if (errorBox) {
            errorBox.textContent = 'We encountered an issue submitting your request. You can directly WhatsApp our desk at +91 9037532036 to confirm your slot.';
            errorBox.classList.remove('hidden');
          }
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = 'Confirm Demo Booking';
        }
      });
    }

    function setupConfirmationCalendarLinks(data) {
      const { name, company, email, phone, dateObj, timeStr } = data;

      const [timePart, meridiem] = timeStr.split(' ');
      let [hours, minutes] = timePart.split(':').map(Number);
      if (meridiem === 'PM' && hours !== 12) hours += 12;
      if (meridiem === 'AM' && hours === 12) hours = 0;

      const startLocal = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate(), hours, minutes, 0);
      const endLocal = new Date(startLocal.getTime() + 30 * 60 * 1000);

      function toIsoUtc(d) {
        return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      }

      const startUtc = toIsoUtc(startLocal);
      const endUtc = toIsoUtc(endLocal);

      const title = encodeURIComponent(`Brift 1-on-1 Product Walkthrough — ${company}`);
      const details = encodeURIComponent(
        `Brift Construction OS 1-on-1 Demo & Walkthrough\n\nAttendee: ${name} (${company})\nEmail: ${email}\nPhone: ${phone}\nHost: Brift Operations Team\nMeeting: Google Meet link will be provided\nSupport: +91 9037532036 / brift.official@gmail.com`
      );
      const location = encodeURIComponent('Google Meet (Link will be sent to email)');

      const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${startUtc}/${endUtc}&details=${details}&location=${location}&add=brift.official@gmail.com,${encodeURIComponent(email)}`;
      const gcalBtn = document.getElementById('btn-google-cal');
      if (gcalBtn) gcalBtn.setAttribute('href', gcalUrl);

      const icsBtn = document.getElementById('btn-download-ics');
      if (icsBtn) {
        icsBtn.onclick = () => {
          const icsContent = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//Brift Technologies//Construction OS//EN',
            'CALSCALE:GREGORIAN',
            'METHOD:REQUEST',
            'BEGIN:VEVENT',
            `UID:brift-demo-${Date.now()}@brift.in`,
            `DTSTAMP:${toIsoUtc(new Date())}`,
            `DTSTART:${startUtc}`,
            `DTEND:${endUtc}`,
            `SUMMARY:Brift 1-on-1 Product Walkthrough — ${company}`,
            `DESCRIPTION:Brift Construction OS Walkthrough with ${name}. Host: Brift Operations. Phone: +91 9037532036.`,
            'LOCATION:Google Meet',
            'STATUS:CONFIRMED',
            'END:VEVENT',
            'END:VCALENDAR'
          ].join('\r\n');

          const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `brift-demo-${dateObj.toISOString().split('T')[0]}.ics`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        };
      }

      const waBtn = document.getElementById('btn-whatsapp-conf');
      if (waBtn) {
        const waText = encodeURIComponent(
          `Hi Brift team, I just scheduled a product walkthrough for ${company} on ${dateObj.toLocaleDateString('en-IN', { weekday: 'short', month: 'short', day: 'numeric' })} at ${timeStr} IST. Attendee: ${name} (${phone}).`
        );
        waBtn.setAttribute('href', `https://wa.me/919037532036?text=${waText}`);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBookingPageCalendar);
    } else {
      initBookingPageCalendar();
    }
  </script>
</Layout>
