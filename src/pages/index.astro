  <!-- Client-Side Feature Module & Savings Calculator Scripts -->
  <script is:inline>
    // 1. Feature Module Switcher
    function switchFeatureModule(moduleKey) {
      document.querySelectorAll('.feature-panel').forEach(panel => panel.classList.add('hidden'));
      const activePanel = document.getElementById('feature-panel-' + moduleKey);
      if (activePanel) activePanel.classList.remove('hidden');

      document.querySelectorAll('.feature-tab-btn').forEach(btn => {
        if (btn.getAttribute('data-feature') === moduleKey) {
          btn.className = 'feature-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-blue text-white shadow-xs transition-all cursor-pointer inline-flex items-center gap-2';
        } else {
          btn.className = 'feature-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:border-slate-300 transition-all cursor-pointer inline-flex items-center gap-2';
        }
      });
    }

    // 2. Savings Calculator
    const savingsMatrix = {
      2: { advances: "₹35,000 / mo", muster: "₹20,000 / mo", materials: "₹40,000 / mo", retail: "₹25,000 / mo", monthly: "₹1,20,000 / month", annual: "₹14.4 Lakhs / year" },
      4: { advances: "₹70,000 / mo", muster: "₹40,000 / mo", materials: "₹80,000 / mo", retail: "₹50,000 / mo", monthly: "₹2,40,000 / month", annual: "₹28.8 Lakhs / year" },
      6: { advances: "₹1,05,000 / mo", muster: "₹60,000 / mo", materials: "₹1,20,000 / mo", retail: "₹75,000 / mo", monthly: "₹3,60,000 / month", annual: "₹43.2 Lakhs / year" },
      8: { advances: "₹1,40,000 / mo", muster: "₹80,000 / mo", materials: "₹1,60,000 / mo", retail: "₹1,00,000 / mo", monthly: "₹4,80,000 / month", annual: "₹57.6 Lakhs / year" },
      12: { advances: "₹2,10,000 / mo", muster: "₹1,20,000 / mo", materials: "₹2,40,000 / mo", retail: "₹1,50,000 / mo", monthly: "₹7,20,000 / month", annual: "₹86.4 Lakhs / year" }
    };

    function updateSavings(sites) {
      const data = savingsMatrix[sites];
      if (!data) return;

      const adv = document.getElementById('calc-advances');
      const mus = document.getElementById('calc-muster');
      const mat = document.getElementById('calc-materials');
      const ret = document.getElementById('calc-retail');
      const mon = document.getElementById('calc-monthly-total');
      const ann = document.getElementById('calc-annual-total');

      if (adv) adv.textContent = data.advances;
      if (mus) mus.textContent = data.muster;
      if (mat) mat.textContent = data.materials;
      if (ret) ret.textContent = data.retail;
      if (mon) mon.textContent = data.monthly;
      if (ann) ann.textContent = data.annual;

      document.querySelectorAll('.site-btn').forEach(btn => {
        if (parseInt(btn.getAttribute('data-sites') || '0', 10) === sites) {
          btn.className = 'site-btn px-4 py-1.5 rounded-lg text-xs font-mono font-bold bg-blue text-white shadow-xs transition-all cursor-pointer';
        } else {
          btn.className = 'site-btn px-4 py-1.5 rounded-lg text-xs font-mono font-semibold border border-slate-200 bg-white text-slate-700 hover:border-slate-300 transition-all cursor-pointer';
        }
      });
    }
  </script>
