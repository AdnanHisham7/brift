---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Image } from 'astro:assets';
import contractorReportImg from '../../assets/contractor-report.png';
import purchasesLedgerImg from '../../assets/purchases-ledger.png';
---

<Layout
  title="People, Contractors & Vendor Ledgers — Brift"
  description="Know who worked, who's owed, and who's paid. Field attendance without signal, contractor advance ledgers, and vendor procurement accounts."
>
  <!-- Hero -->
  <section class="relative pt-16 pb-14 sm:pt-24 sm:pb-20 bg-bg border-b border-line overflow-hidden">
    <div class="hero-gradient-blob" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3.5 py-1 rounded-full">
        PEOPLE & PAYMENTS
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-tight">
        Know who worked, who's owed, who's paid.
      </h1>
      <p class="text-lg sm:text-xl text-muted max-w-2xl mx-auto leading-relaxed">
        Eliminate wage arguments and contractor settlement disputes. Clean digital ledgers for daily laborers, specialized trade contractors, and material suppliers.
      </p>
      <div class="pt-2">
        <a href="/book-a-demo" class="inline-flex items-center justify-center rounded-xl bg-blue px-7 py-3.5 text-sm font-semibold text-white hover:bg-blue-hover transition-all shadow-sm">
          Book a Live People & Payroll Walkthrough
        </a>
      </div>
    </div>
  </section>

  <!-- Contractor Ledger Section -->
  <section class="py-16 sm:py-24 bg-white border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6 reveal">
          <span class="text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full">
            CONTRACTOR CONTROL
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
            No more forgotten advances
          </h2>
          <p class="text-base text-muted leading-relaxed">
            In construction, subcontractor advances are commonly recorded in pocket diaries or remembered during phone calls. Brift gives you a real-time ledger for every trade contractor across all active sites.
          </p>

          <div class="space-y-3 text-sm text-ink-2">
            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">Contract Amount vs. Verified Work</h3>
              <p class="text-xs text-muted leading-relaxed">Track total agreed contract value against actual verified stage progress.</p>
            </div>
            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">Digital Advance Slips</h3>
              <p class="text-xs text-muted leading-relaxed">Every cash or bank advance automatically reduces supervisor cash and updates the contractor's net balance due.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 reveal delay-100">
          <div class="rounded-card-lg border border-line bg-white p-3 shadow-elevated">
            <Image
              src={contractorReportImg}
              alt="Brift Contractor Ledger Report showing Fahad Nair Contracting and Jithin Ali Contracting commitments and balances"
              class="w-full h-auto rounded-card object-cover"
              format="webp"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Labor & Vendors 2-Column Section -->
  <section class="py-16 sm:py-24 bg-bg border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Labor Workforce -->
        <div class="rounded-card border border-line bg-white p-8 space-y-5 reveal shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full">
            DAILY WORKFORCE
          </span>
          <h3 class="text-2xl font-bold text-ink">
            Attendance marked per worker, per site
          </h3>
          <p class="text-sm text-muted leading-relaxed">
            Site managers mark workers full or half day on their phones even without cellular signal. Each worker's daily wage auto-costs to the site ledger with duplicate-entry prevention.
          </p>
          <ul class="space-y-2.5 text-xs text-ink-2 pt-2">
            <li class="flex items-center gap-2 font-medium">✓ Automated payroll register with paid & unpaid tracking</li>
            <li class="flex items-center gap-2 font-medium">✓ Zero miscalculations or lost paper muster rolls</li>
            <li class="flex items-center gap-2 font-medium">✓ Overtime and daily allowances verified by admin</li>
          </ul>
        </div>

        <!-- Vendor Procurement -->
        <div class="rounded-card border border-line bg-white p-8 space-y-5 reveal shadow-xs">
          <span class="text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full">
            VENDOR PROCUREMENT
          </span>
          <h3 class="text-2xl font-bold text-ink">
            Cash & credit purchases separated
          </h3>
          <p class="text-sm text-muted leading-relaxed">
            Outstanding balances per supplier are visible at a glance. When settlements are made, payments are automatically applied against the oldest unpaid bills first.
          </p>
          <ul class="space-y-2.5 text-xs text-ink-2 pt-2">
            <li class="flex items-center gap-2 font-medium">✓ Bill photograph attached directly to purchase line item</li>
            <li class="flex items-center gap-2 font-medium">✓ Prevents duplicate payments for the same invoice</li>
            <li class="flex items-center gap-2 font-medium">✓ Export complete vendor statements in PDF or Excel</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Purchases Ledger Screenshot -->
  <section class="py-16 sm:py-24 bg-white border-b border-line">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <div class="space-y-3">
        <h2 class="text-3xl font-extrabold tracking-tight text-ink">
          Purchases carry the bill, vendor, and approval status
        </h2>
        <p class="text-sm text-muted max-w-xl mx-auto">
          Every purchase is verified by the owner before it reflects in cash deductions and stock balances.
        </p>
      </div>

      <div class="rounded-card-lg border border-line bg-white p-3 shadow-elevated reveal">
        <Image
          src={purchasesLedgerImg}
          alt="Brift Verified Purchases Table showing date, site, items, amount, payment, and status"
          class="w-full h-auto rounded-card object-cover"
          format="webp"
        />
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
