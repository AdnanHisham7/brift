---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { Image } from 'astro:assets';
import materialsStockImg from '../../assets/materials-stock.png';
---

<Layout
  title="Materials & Stock Inventory — Brift"
  description="Know what was bought, used and moved across every construction site. Standardized item names, inter-site transfer approvals, and low-stock reorder alerts."
>
  <!-- Hero -->
  <section class="relative pt-16 pb-14 sm:pt-24 sm:pb-20 bg-bg border-b border-line overflow-hidden">
    <div class="hero-gradient-blob" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3.5 py-1 rounded-full">
        MATERIALS & INVENTORY
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-tight">
        Know what was bought, used and moved.
      </h1>
      <p class="text-lg sm:text-xl text-muted max-w-2xl mx-auto leading-relaxed">
        Stop stock from quietly disappearing between sites. Standardized material naming, verified site usage, and automated reorder alerts.
      </p>
      <div class="pt-2">
        <a href="/book-a-demo" class="inline-flex items-center justify-center rounded-xl bg-blue px-7 py-3.5 text-sm font-semibold text-white hover:bg-blue-hover transition-all shadow-sm">
          Book a Live Materials Walkthrough
        </a>
      </div>
    </div>
  </section>

  <!-- Materials Core Engine -->
  <section class="py-16 sm:py-24 bg-white border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6 reveal">
          <span class="text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full">
            ACCURATE SITE LEDGERS
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
            No more stock in memory
          </h2>
          <p class="text-base text-muted leading-relaxed">
            When materials arrive on site, site supervisors upload the vendor bill. Once admin verifies it, the site's stock ledger and cost update simultaneously with weighted-average pricing.
          </p>

          <div class="space-y-4 pt-2">
            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">Standardized Item Master</h3>
              <p class="text-xs text-muted leading-relaxed">
                Item names are standardized and fuzzy-matched, so “cement”, “Cement ”, and “UltraTech Cement” are never tracked as separate fragmented materials.
              </p>
            </div>
            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">Inter-Site Transfer Approvals</h3>
              <p class="text-xs text-muted leading-relaxed">
                Moving 100 bags of cement from Site A to Site B requires a digital handshake. The stock and its financial value deduct from Site A and post to Site B automatically.
              </p>
            </div>
            <div class="rounded-xl border border-line bg-bg p-4 space-y-1">
              <h3 class="text-sm font-bold text-ink">Automated Low-Stock Alerts</h3>
              <p class="text-xs text-muted leading-relaxed">
                Configure minimum reorder thresholds (e.g. 10 tons of 20mm aggregate). Low-stock warnings reach you and the managers before work on site grinds to a halt.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 reveal delay-100">
          <div class="rounded-card-lg border border-line bg-white p-3 shadow-elevated">
            <Image
              src={materialsStockImg}
              alt="Brift Material Stock Ledger showing 20mm Aggregate stock cards and low-stock reorder alert"
              class="w-full h-auto rounded-card object-cover"
              format="webp"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Step Materials Flow -->
  <section class="py-16 sm:py-24 bg-bg border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
          The 4 pillars of material control
        </h2>
        <p class="text-base text-muted">
          From purchase order to pouring on site, every kilogram is accounted for.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {[
          {
            num: '1',
            title: 'Bought',
            desc: 'Purchases carry the bill and the vendor. Once you verify, stock quantity and site cost update together.',
          },
          {
            num: '2',
            title: 'Used',
            desc: 'Site teams log what was used each day, so what remains in the ledger is a verified record, not a guess.',
          },
          {
            num: '3',
            title: 'Moved',
            desc: 'Transfers between sites need approval. The stock moves and the financial balance moves with it.',
          },
          {
            num: '4',
            title: 'Never Surprised',
            desc: 'Set reorder levels per item. Automated cron checks run daily to flag potential bottlenecks early.',
          },
        ].map((item) => (
          <div class="rounded-card border border-line bg-white p-6 shadow-xs reveal space-y-3">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue text-xs font-bold text-white">
              {item.num}
            </span>
            <h3 class="text-lg font-bold text-ink">{item.title}</h3>
            <p class="text-xs text-muted leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
