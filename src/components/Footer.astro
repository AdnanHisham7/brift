---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] bg-[#05080E] text-slate-400 mt-auto relative z-30">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <!-- Brand & Mission Column -->
      <div class="md:col-span-5 space-y-4">
        <a href="#" class="flex items-center gap-3 group" aria-label="Brift Homepage">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-white shadow-[0_0_15px_rgba(59,130,246,0.4)] border border-white/20">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19h4v-5h4v-5h4V4h4" />
            </svg>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xl font-extrabold tracking-tight text-white group-hover:text-blue-300 transition-colors">BRIFT</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-white/[0.06] border border-white/[0.08] text-slate-300">
              CON-OPS OS
            </span>
          </div>
        </a>
        <p class="text-sm font-medium text-slate-200 max-w-sm">
          A single hub for every construction site.
        </p>
        <p class="text-xs sm:text-sm text-slate-400 max-w-sm leading-relaxed">
          A live operating system for construction companies ready to replace spreadsheets, WhatsApp groups and guesswork — with one reliable view of every site, rupee and worker.
        </p>
        <p class="text-xs text-slate-500 pt-1 font-mono">
          Bridges the gap between the site and the office.
        </p>
      </div>

      <!-- Quick Navigation Anchors -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-mono uppercase tracking-wider text-slate-400">Cinematic Chapters</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#scene-1" class="text-slate-300 hover:text-blue-400 transition-colors">Act 01: The Stakes</a>
          </li>
          <li>
            <a href="#scene-2" class="text-slate-300 hover:text-blue-400 transition-colors">Act 02: Crime Scene Leaks</a>
          </li>
          <li>
            <a href="#scene-3" class="text-slate-300 hover:text-blue-400 transition-colors">Act 03: 24h Field Story</a>
          </li>
          <li>
            <a href="#scene-4" class="text-slate-300 hover:text-blue-400 transition-colors">Act 04: The Cockpit Console</a>
          </li>
          <li>
            <a href="#scene-5" class="text-amber-400 font-medium hover:text-amber-300 transition-colors">Act 05: Profit Radar</a>
          </li>
          <li>
            <a href="#scene-6" class="text-slate-300 hover:text-blue-400 transition-colors">Act 06: Private Screening</a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact & Trust -->
      <div class="md:col-span-4 space-y-3">
        <h3 class="text-xs font-mono uppercase tracking-wider text-slate-400">Direct Hotline</h3>
        <p class="text-xs text-slate-400">
          Connect directly with our engineering founders to map Brift to your live construction sites:
        </p>
        <ul class="space-y-2 text-sm text-slate-300 pt-1">
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+919037532036" class="hover:text-blue-400 transition-colors">+91 9037532036</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:brift.official@gmail.com" class="hover:text-blue-400 transition-colors">brift.official@gmail.com</a>
          </li>
          <li class="pt-2">
            <a
              href="#demo"
              class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 py-2.5 px-5 text-xs font-bold text-white shadow-[0_0_20px_rgba(59,130,246,0.3)] hover:shadow-[0_0_30px_rgba(59,130,246,0.5)] border border-blue-400/30 transition-all active:scale-95"
            >
              Reserve Private Screening &rarr;
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar with Legal Links -->
    <div class="mt-12 border-t border-white/[0.08] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        &copy; {currentYear} Brift Technologies. Built for contractors and developers who refuse to lose money.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-300 transition-colors">Terms of Service</a>
        <a href="/sitemap-index.xml" class="hover:text-slate-300 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
