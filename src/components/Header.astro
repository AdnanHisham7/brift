---
// Minimalist, high-end navbar: Brand on left, Book a Demo on right, auto-hides on scroll
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 w-full border-b border-line bg-white/95 backdrop-blur-md transition-transform duration-300 ease-in-out"
>
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo & Name (Left) -->
    <a href="#" class="flex items-center gap-3 group focus-visible:outline-none" aria-label="Brift Homepage">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue text-white shadow-sm transition-transform group-hover:scale-105">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19h4v-5h4v-5h4V4h4" />
        </svg>
      </div>
      <span class="text-xl font-bold tracking-tight text-ink">BRIFT</span>
    </a>

    <!-- Single Action CTA (Right) -->
    <div class="flex items-center">
      <a
        href="#demo"
        class="inline-flex items-center justify-center rounded-xl bg-blue px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-hover focus-visible:outline-none transition-all active:scale-[0.98]"
      >
        Book a Demo
      </a>
    </div>
  </div>
</header>

<!-- Spacer so top content isn't covered by fixed header -->
<div class="h-18" aria-hidden="true"></div>

<script>
  function initHeaderAutoHide() {
    const header = document.getElementById('main-header');
    if (!header) return;

    let lastScrollY = window.pageYOffset || document.documentElement.scrollTop;
    let ticking = false;

    function handleScroll() {
      if (!header) return;
      const currentScrollY = window.pageYOffset || document.documentElement.scrollTop;

      // Always show at top of page
      if (currentScrollY <= 80) {
        header.classList.remove('-translate-y-full');
      } else if (currentScrollY > lastScrollY && currentScrollY > 120) {
        // Scrolling DOWN -> hide header
        header.classList.add('-translate-y-full');
      } else if (currentScrollY < lastScrollY) {
        // Scrolling UP -> reveal header
        header.classList.remove('-translate-y-full');
      }

      lastScrollY = Math.max(0, currentScrollY);
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(handleScroll);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderAutoHide);
  } else {
    initHeaderAutoHide();
  }
</script>
