        const phone = phoneInput ? phoneInput.value.trim() : '';
        const email = emailInput ? emailInput.value.trim() : '';
        const company = companyInput ? companyInput.value.trim() : '';
        const sites = sitesInput ? sitesInput.value : '3-5';
        const message = messageInput ? messageInput.value.trim() : '';

        if (!name || !phone || !email || !company) {
          if (errorBox) {
            errorBox.textContent = 'Please fill out all required fields: Name, Phone, Email, and Company.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = 'Securing Slot & Sending Email Notification...';

        const formattedDate = formatDateDisplay(selectedDate);

        // Payload sent directly to brift.official@gmail.com via FormSubmit.co
        const payload = {
          _subject: '📅 New Walkthrough Demo Scheduled: ' + name + ' (' + company + ') - ' + formattedDate + ' @ ' + selectedSlot + ' IST',
          _template: 'table',
          _captcha: 'false',
          _replyto: email,
          'Lead Name': name,
          'Company / Firm': company,
          'Official WhatsApp / Phone': phone,
          'Work Email': email,
          'Active Construction Sites': sites,
          'Scheduled Date': formattedDate,
          'Scheduled Time Slot': selectedSlot + ' (IST)',
          'Primary Headache / Notes': message || 'None provided',
          'Notification Recipient': 'brift.official@gmail.com',
          'Submission Timestamp': new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })
        };

        try {
          await fetch('https://formsubmit.co/ajax/brift.official@gmail.com', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });
        } catch (err) {
          console.warn('FormSubmit notification dispatch note:', err);
        }

        // Update Confirmed Pass details
        const confSlotTime = document.getElementById('conf-slot-time');
        const confAttendee = document.getElementById('conf-attendee');
        const confPhone = document.getElementById('conf-phone');
        if (confSlotTime) confSlotTime.textContent = formattedDate + ' @ ' + selectedSlot + ' IST';
        if (confAttendee) confAttendee.textContent = name + ' • ' + company;
        if (confPhone) confPhone.textContent = phone + ' (' + email + ')';

        // 1. Google Calendar Link
        const timeParts = selectedSlot.split(' ');
        const hm = timeParts[0].split(':');
        let h = parseInt(hm[0], 10);
        const m = parseInt(hm[1], 10);
        if (timeParts[1] === 'PM' && h < 12) h += 12;
        if (timeParts[1] === 'AM' && h === 12) h = 0;

        const startDt = new Date(selectedDate.getFullYear(), selectedDate.getMonth(), selectedDate.getDate(), h, m, 0);
        const endDt = new Date(startDt.getTime() + 30 * 60 * 1000);

        function formatUTC(dt) {
          return dt.toISOString().replace(/-|:|\.\d+/g, '');
        }

        const btnGoogle = document.getElementById('btn-google-cal');
        if (btnGoogle) {
          const calTitle = encodeURIComponent('Brift Construction OS Walkthrough (' + company + ')');
          const calDetails = encodeURIComponent('1-on-1 private walkthrough of Brift Construction Operations OS with Adnan Hisham.\n\nAttendee: ' + name + ' (' + company + ')\nWhatsApp: ' + phone + '\nEmail: ' + email + '\nActive Sites: ' + sites + '\n\nHost: brift.official@gmail.com / +91 9037532036');
          btnGoogle.href = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + calTitle + '&dates=' + formatUTC(startDt) + '/' + formatUTC(endDt) + '&details=' + calDetails + '&add=brift.official@gmail.com&location=Google+Meet+/+WhatsApp+Call';
        }

        // 2. Download .ics iCalendar file
        const btnIcs = document.getElementById('btn-download-ics');
        if (btnIcs) {
          btnIcs.onclick = function() {
            const icsContent = [
              'BEGIN:VCALENDAR',
              'VERSION:2.0',
              'PRODID:-//Brift//Walkthrough Demo//EN',
              'CALSCALE:GREGORIAN',
              'METHOD:REQUEST',
              'BEGIN:VEVENT',
              'SUMMARY:Brift Construction OS Walkthrough - ' + company,
              'DESCRIPTION:1-on-1 walkthrough demo for ' + name + ' (' + company + ') with Brift product team. Attendee phone: ' + phone,
              'DTSTART:' + formatUTC(startDt),
              'DTEND:' + formatUTC(endDt),
              'STATUS:CONFIRMED',
              'ORGANIZER;CN=Brift Operations:mailto:brift.official@gmail.com',
              'ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;CN=' + name + ':mailto:' + email,
              'END:VEVENT',
              'END:VCALENDAR'
            ].join('\r\n');

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'brift-walkthrough-' + company.replace(/[^a-zA-Z0-9]/g, '-') + '.ics';
            link.click();
          };
        }

        // 3. Direct WhatsApp confirmation
        const btnWa = document.getElementById('btn-whatsapp-conf');
        if (btnWa) {
          const waMsg = encodeURIComponent('Hi Brift team, I just scheduled a walkthrough session for ' + formattedDate + ' at ' + selectedSlot + ' IST.\n\nCompany: ' + company + '\nName: ' + name + '\nSites: ' + sites);
          btnWa.href = 'https://wa.me/919037532036?text=' + waMsg;
        }

        // Show confirmation view
        form.classList.add('hidden');
        successBox.classList.remove('hidden');

        const demoContainer = document.getElementById('demo');
        if (demoContainer) {
          demoContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    // 9. Master Initialization
    function initializeApp() {
      initMotionAnimations();
      initCounters();
      initStoryNavigator();
      initContinuousMovieAutoPlay();
      initDemoCalendarScheduler();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeApp);
    } else {
      initializeApp();
    }
  </script>
</Layout>
