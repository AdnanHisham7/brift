        const narr = document.getElementById('scene-narration');
        const lk = document.getElementById('scene-leak-status');
        const pId = document.getElementById('projector-id');

        if (tc) tc.textContent = data.timecode;
        if (loc) loc.textContent = data.location;
        if (hl) hl.textContent = data.headline;
        if (narr) narr.textContent = data.narration;
        if (lk) lk.textContent = data.leak;
        if (pId) pId.textContent = data.feed;
      }

      for (let i = 1; i <= 4; i++) {
        const screen = document.getElementById('movie-screen-' + i);
        if (screen) {
          if (i === sceneId) screen.classList.remove('hidden');
          else screen.classList.add('hidden');
        }
      }

      document.querySelectorAll('.movie-tab').forEach(tab => {
        if (parseInt(tab.getAttribute('data-scene') || '0', 10) === sceneId) {
          tab.className = 'movie-tab px-4 py-3 rounded-xl text-xs font-bold border-2 border-amber-400 bg-amber-400 text-slate-950 text-left transition-all cursor-pointer font-mono shadow-xs';
        } else {
          tab.className = 'movie-tab px-4 py-3 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 text-left hover:border-amber-400 transition-all cursor-pointer font-mono';
        }
      });
    }

    function toggleMovieAutoPlay() {
      const btnText = document.getElementById('play-text');
      const btnIcon = document.getElementById('play-icon');

      if (movieAutoPlayInterval) {
        clearInterval(movieAutoPlayInterval);
        movieAutoPlayInterval = null;
        if (btnText) btnText.textContent = "Auto-Play Day Story";
        if (btnIcon) btnIcon.textContent = "▶";
      } else {
        if (btnText) btnText.textContent = "Pause (Playing...)";
        if (btnIcon) btnIcon.textContent = "❚❚";
        movieAutoPlayInterval = setInterval(() => {
          let nextScene = currentMovieScene + 1;
          if (nextScene > 4) nextScene = 1;
          showMovieScene(nextScene);
        }, 3500);
      }
    }

    // 3. Cockpit Channel Switcher
    function switchCockpit(channelId) {
      document.querySelectorAll('.cockpit-panel').forEach(p => p.classList.add('hidden'));
      const active = document.getElementById('cockpit-panel-' + channelId);
      if (active) active.classList.remove('hidden');

      document.querySelectorAll('.cockpit-btn').forEach(btn => {
        if (btn.getAttribute('data-channel') === channelId) {
          btn.className = 'cockpit-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border-2 border-blue bg-blue text-white shadow-xs transition-all cursor-pointer';
        } else {
          btn.className = 'cockpit-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 bg-white text-slate-700 hover:border-blue transition-all cursor-pointer';
        }
      });
    }

    // 4. Financial Radar Scanner
    function runRadarScan(numSites) {
      document.querySelectorAll('.radar-site-btn').forEach(btn => {
        if (parseInt(btn.getAttribute('data-sites') || '0', 10) === numSites) {
          btn.className = 'radar-site-btn px-4 py-2 rounded-xl text-xs font-mono font-bold border-2 border-amber-400 bg-amber-400 text-slate-950 shadow-xs transition-all cursor-pointer';
        } else {
          btn.className = 'radar-site-btn px-4 py-2 rounded-xl text-xs font-mono font-bold border border-slate-200 bg-white text-slate-700 hover:border-amber-400 transition-all cursor-pointer';
        }
      });

      const label = document.getElementById('radar-site-label');
      if (label) label.textContent = numSites + ' Active Sites';

      const adv = numSites * 17500;
      const muster = numSites * 10000;
      const mat = numSites * 20000;
      const retail = numSites * 12500;
      const monthlyTotal = adv + muster + mat + retail;
      const annualTotal = monthlyTotal * 12;

      const advEl = document.getElementById('radar-advances');
      const musterEl = document.getElementById('radar-muster');
      const matEl = document.getElementById('radar-materials');
      const retEl = document.getElementById('radar-retail');
      const monEl = document.getElementById('radar-monthly-total');
      const annEl = document.getElementById('radar-annual-total');

      if (advEl) advEl.textContent = '₹' + adv.toLocaleString('en-IN') + ' / mo';
      if (musterEl) musterEl.textContent = '₹' + muster.toLocaleString('en-IN') + ' / mo';
      if (matEl) matEl.textContent = '₹' + mat.toLocaleString('en-IN') + ' / mo';
      if (retEl) retEl.textContent = '₹' + retail.toLocaleString('en-IN') + ' / mo';
      if (monEl) monEl.textContent = '₹' + monthlyTotal.toLocaleString('en-IN') + ' / mo';
      
      const lakhs = (annualTotal / 100000).toFixed(1);
      if (annEl) annEl.textContent = '₹' + lakhs + ' Lakhs / year';
    }

    // 5. Jump to Screen Helper for Storyline
    function jumpToScreen(screenId) {
      const el = document.getElementById(screenId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // 6. Fluid Staggered Micro-Reveal Engine (IntersectionObserver)
    function initScrollRevealEngine() {
      const revealElements = document.querySelectorAll('.story-fade-in, .story-fade-left, .story-fade-right, .story-scale-up');
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: '0px 0px -40px 0px'
      });

      revealElements.forEach(el => observer.observe(el));
    }

    // 7. Active Act Indicator Tracker
    const actTitles = {
      'act-1': 'ACT 01 // THE REALITY CHECK',
      'act-2': 'ACT 02 // CRIME SCENE LEAKS',
      'act-3': 'ACT 03 // 24H FIELD STORY',
      'act-4': 'ACT 04 // THE COCKPIT',
      'act-5': 'ACT 05 // PROFIT RADAR',
      'act-6': 'ACT 06 // TAKE COMMAND'
    };

    const actTimecodes = {
      'act-1': '00:00:15',
      'act-2': '00:01:20',
      'act-3': '00:02:45',
      'act-4': '00:04:10',
      'act-5': '00:05:30',
      'act-6': '00:07:00'
    };

    function initActObserver() {
      const acts = ['act-1', 'act-2', 'act-3', 'act-4', 'act-5', 'act-6'].map(id => document.getElementById(id)).filter(Boolean);

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            const titleEl = document.getElementById('hud-scene-title');
            const tcEl = document.getElementById('hud-timecode');
            if (titleEl && actTitles[id]) titleEl.textContent = actTitles[id];
            if (tcEl && actTimecodes[id]) tcEl.textContent = actTimecodes[id];

            document.querySelectorAll('.film-hud-dot').forEach(dot => {
              if (dot.getAttribute('data-target') === id.replace('act-', 'screen-')) {
                dot.classList.add('is-active');
              } else {
                dot.classList.remove('is-active');
              }
            });
          }
        });
      }, {
        threshold: 0.25
      });

      acts.forEach(act => act && observer.observe(act));
    }



    // 9. Lead Demo Form Submission Simulation
    document.addEventListener('DOMContentLoaded', () => {
      initScrollRevealEngine();
      initActObserver();

      const form = document.getElementById('lead-demo-form');
      const successBox = document.getElementById('demo-success-box');
      if (form && successBox) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
        });
      }
    });
  </script>
</Layout>
