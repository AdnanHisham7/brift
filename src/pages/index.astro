---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroTransparentImg from '../assets/hero-phone-transparent.png';
import spendImg from '../assets/spend-analytics.png';
import materialsImg from '../assets/materials-stock.png';
import contractorImg from '../assets/contractor-report.png';
import reportsImg from '../assets/reports-overview.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import storiesImg from '../assets/stories-site-updates.png';
---

<Layout
  title="Brift — A Single Hub for Every Site"
  description="A cinematic operating system for construction companies ready to replace spreadsheets, WhatsApp groups and guesswork with one reliable view of every site, rupee and worker."
  schemaType="home"
>
  <!-- FLOATING CINEMATIC DIRECTOR'S HUD / VIDEO CONTROLLER -->
  <aside
    id="cinema-hud"
    class="fixed bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-3xl rounded-2xl sm:rounded-full bg-[#080D1A]/90 backdrop-blur-xl border border-white/[0.14] shadow-[0_16px_50px_rgba(0,0,0,0.8)] px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between transition-all duration-300"
    aria-label="Movie Navigation HUD"
  >
    <!-- Left: Telemetry & Timecode -->
    <div class="flex items-center gap-3">
      <span class="flex h-2.5 w-2.5 rounded-full bg-red-500 animate-ping"></span>
      <div class="font-mono text-[11px] sm:text-xs">
        <span class="text-red-400 font-bold tracking-wider">REC</span>
        <span class="text-slate-400 mx-1.5">•</span>
        <span id="hud-timecode" class="text-white font-semibold">00:00:00</span>
      </div>
      <span class="hidden md:inline-block text-[11px] font-mono text-slate-400 border-l border-white/10 pl-3" id="hud-scene-title">
        SCENE 01 // THE STAKES
      </span>
    </div>

    <!-- Center: Interactive Chapter Markers -->
    <nav class="flex items-center gap-1.5 sm:gap-2" aria-label="Movie Chapters">
      <button
        type="button"
        class="film-hud-dot is-active h-2 sm:h-2.5 w-7 rounded-full bg-blue-500 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-1"
        title="Scene 1: The Stakes"
        aria-label="Jump to Scene 1: The Stakes"
        onclick="jumpToScene('scene-1')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-2"
        title="Scene 2: The Crime Scene"
        aria-label="Jump to Scene 2: The Crime Scene"
        onclick="jumpToScene('scene-2')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-3"
        title="Scene 3: 24h Field Story"
        aria-label="Jump to Scene 3: 24-Hour Field Story"
        onclick="jumpToScene('scene-3')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-4"
        title="Scene 4: The Cockpit"
        aria-label="Jump to Scene 4: The Cockpit"
        onclick="jumpToScene('scene-4')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-5"
        title="Scene 5: Profit Radar"
        aria-label="Jump to Scene 5: Profit Radar"
        onclick="jumpToScene('scene-5')"
      ></button>
      <button
        type="button"
        class="film-hud-dot h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-white/20 hover:bg-white/50 transition-all cursor-pointer focus-visible:outline-none"
        data-target="scene-6"
        title="Scene 6: Take Command"
        aria-label="Jump to Scene 6: Take Command"
        onclick="jumpToScene('scene-6')"
      ></button>
    </nav>

    <!-- Right: Auto-Play Reel Button -->
    <div class="flex items-center gap-2">
      <button
        id="reel-play-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white text-xs font-mono font-bold transition-all cursor-pointer border border-white/10 active:scale-95"
        onclick="toggleReelAutoScroll()"
      >
        <span id="reel-play-icon">▶</span>
        <span class="hidden sm:inline" id="reel-play-text">PLAY REEL</span>
      </button>
    </div>
  </aside>

  <!-- STACKING CARDS MOVIE DECK WRAPPER -->
  <div class="relative w-full overflow-hidden bg-[#060910]">

    <!-- ========================================== -->
    <!-- SCENE 01 // THE STAKES (CINEMATIC OVERTURE) -->
    <!-- ========================================== -->
    <section
      id="scene-1"
      class="stacked-card z-10 bg-[#060912] pt-24 pb-20 sm:pt-28 sm:pb-28"
    >
      <!-- Atmospheric Lighting -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-tr from-blue-600/25 via-indigo-600/15 to-transparent blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-10 right-0 w-[450px] h-[450px] bg-amber-500/10 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-0 scanline-overlay pointer-events-none opacity-20" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full my-auto">
        <!-- Scene Meta Slate -->
        <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 mb-8 text-[11px] font-mono tracking-widest text-slate-400">
          <div class="flex items-center gap-2">
            <span class="text-blue-400 font-bold">REEL 01 // ACT I</span>
            <span class="text-slate-600">•</span>
            <span class="text-white">THE STAKES</span>
          </div>
          <div>SYSTEM OS // V2.4</div>
          <div class="hidden sm:block text-emerald-400">TELEMETRY: VERIFIED</div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
          <!-- Left: Narrative -->
          <div class="lg:col-span-7 space-y-6 text-left">
            <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-950/40 px-3.5 py-1.5 text-xs font-semibold text-blue-300 backdrop-blur-md">
              <span class="h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
              <span>THE OPERATING SYSTEM FOR CONSTRUCTION</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.08]">
              A single hub <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-amber-300">
                for every construction site.
              </span>
            </h1>

            <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
              You built a construction business to execute projects and compound wealth. Instead, you're trapped in 45 phone calls a day while ₹2.4 Lakhs quietly leaks every month through WhatsApp groups, uncounted bags, and unrecorded cash advances.
            </p>

            <!-- Action CTAs -->
            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <a
                href="#demo"
                class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-500 hover:from-blue-500 hover:to-indigo-500 text-white px-8 py-4 text-base font-bold shadow-[0_0_25px_rgba(59,130,246,0.5)] hover:shadow-[0_0_35px_rgba(59,130,246,0.8)] border border-blue-400/30 transition-all active:scale-95 group focus-visible:outline-none"
              >
                <span>Take Command — Book Demo</span>
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
              <button
                type="button"
                class="inline-flex items-center justify-center rounded-xl bg-white/[0.06] border border-white/10 px-6 py-4 text-sm font-semibold text-slate-200 hover:bg-white/10 hover:border-white/20 transition-all gap-2 cursor-pointer"
                onclick="jumpToScene('scene-2')"
              >
                <span>Scroll Down to Inspect Leaks</span>
                <span class="animate-bounce">↓</span>
              </button>
            </div>

            <!-- Telemetry Badges -->
            <div class="pt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-xl">
              <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] p-3.5 backdrop-blur-sm">
                <span class="text-xl font-black text-white block">~₹29.5L</span>
                <span class="text-[11px] text-slate-400 block leading-tight">Monthly volume tracked per firm</span>
              </div>
              <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] p-3.5 backdrop-blur-sm">
                <span class="text-xl font-black text-emerald-400 block">100%</span>
                <span class="text-[11px] text-slate-400 block leading-tight">Offline basement sync</span>
              </div>
              <div class="col-span-2 sm:col-span-1 rounded-xl border border-white/[0.08] bg-white/[0.03] p-3.5 backdrop-blur-sm">
                <span class="text-xl font-black text-amber-300 block">0 Leaks</span>
                <span class="text-[11px] text-slate-400 block leading-tight">No unverified cash movement</span>
              </div>
            </div>
          </div>

          <!-- Right: Floating Cutout Mockup -->
          <div class="lg:col-span-5 relative flex justify-center perspective-container">
            <div class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[420px] animate-float">
              <!-- Halo glow -->
              <div class="absolute inset-4 bg-gradient-to-tr from-blue-600/30 via-indigo-500/20 to-amber-500/20 blur-3xl rounded-full -z-10" aria-hidden="true"></div>

              <Image
                src={heroTransparentImg}
                alt="Brift Mobile Interface floating cutout with live project cards"
                class="w-full h-auto drop-shadow-[0_25px_35px_rgba(0,0,0,0.8)] select-none"
                loading="eager"
                fetchpriority="high"
                format="webp"
              />

              <!-- Telemetry Overlay Badges -->
              <div class="absolute -top-3 -left-4 sm:-left-6 rounded-2xl border border-white/10 bg-[#0B1020]/95 p-3.5 shadow-2xl backdrop-blur-md max-w-[200px] hidden sm:block">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
                  <div>
                    <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 block">Verified Funds</span>
                    <span class="text-xs font-black text-white block">₹62,00,000 Locked</span>
                  </div>
                </div>
              </div>

              <div class="absolute -bottom-4 -right-4 sm:-right-6 rounded-2xl border border-white/10 bg-[#0B1020]/95 p-3.5 shadow-2xl backdrop-blur-md max-w-[210px]">
                <div class="flex items-center gap-2.5">
                  <div class="h-2.5 w-2.5 rounded-full bg-emerald-400 animate-ping"></div>
                  <div>
                    <span class="text-[10px] uppercase font-mono tracking-wider text-amber-300 block">Site Gate 0 Bars</span>
                    <span class="text-xs font-bold text-white block">30 Workers Synced</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SCENE 02 // THE CRIME SCENE (FORENSIC LEAKS) -->
    <!-- ========================================== -->
    <section
      id="scene-2"
      class="stacked-card z-20 bg-[#090E1C] pt-24 pb-20 sm:pt-28 sm:pb-28"
    >
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full my-auto">
        <!-- Slate Header -->
        <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 mb-8 text-[11px] font-mono tracking-widest text-slate-400">
          <div class="flex items-center gap-2">
            <span class="text-red-400 font-bold">REEL 02 // ACT II</span>
            <span class="text-slate-600">•</span>
            <span class="text-white">FORENSIC LEAK INSPECTION</span>
          </div>
          <div class="text-red-400">TOTAL ESTIMATED LOSS: -₹2,40,000/MO</div>
        </div>

        <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
          <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-red-400 bg-red-950/60 border border-red-800/40 px-3 py-1 rounded-full">
            EVIDENCE AUDIT // THE INVISIBLE BLEED
          </span>
          <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
            Where does ₹2.4 Lakhs quietly vanish every single month?
          </h2>
          <p class="text-sm sm:text-base text-slate-300">
            Click on any evidence file below to inspect how broken paper habits create silent financial bleeding across your sites.
          </p>
        </div>

        <!-- 4 Forensic Evidence Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          <!-- Card 1 -->
          <div
            class="evidence-card rounded-2xl border border-white/[0.08] bg-[#0E1528]/80 p-5 hover:border-red-500/70 hover:shadow-[0_0_30px_rgba(239,68,68,0.25)] transition-all duration-300 cursor-pointer group space-y-3"
            onclick="inspectEvidence(1)"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold uppercase text-red-400 bg-red-950/60 px-2.5 py-0.5 rounded-md border border-red-800/30">
                Evidence #01
              </span>
              <span class="text-xs font-mono font-bold text-red-400">-₹40,000/mo</span>
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-red-400 transition-colors">
              The Ghost Labor Register
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Attendance taken on crumpled paper diaries. By Saturday evening, 4 to 6 phantom workers have been added to the payout tally.
            </p>
            <div class="pt-2 border-t border-white/[0.06] text-[11px] font-bold text-blue-400 flex items-center justify-between">
              <span>Inspect Brift Fix</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </div>

          <!-- Card 2 -->
          <div
            class="evidence-card rounded-2xl border border-white/[0.08] bg-[#0E1528]/80 p-5 hover:border-red-500/70 hover:shadow-[0_0_30px_rgba(239,68,68,0.25)] transition-all duration-300 cursor-pointer group space-y-3"
            onclick="inspectEvidence(2)"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold uppercase text-red-400 bg-red-950/60 px-2.5 py-0.5 rounded-md border border-red-800/30">
                Evidence #02
              </span>
              <span class="text-xs font-mono font-bold text-red-400">-₹80,000/mo</span>
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-red-400 transition-colors">
              The Vanishing Cement Challan
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              200 bags billed by the supplier. 170 bags actually unloaded. Delivery challan signed in pencil and lost under a windshield.
            </p>
            <div class="pt-2 border-t border-white/[0.06] text-[11px] font-bold text-blue-400 flex items-center justify-between">
              <span>Inspect Brift Fix</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </div>

          <!-- Card 3 -->
          <div
            class="evidence-card rounded-2xl border border-white/[0.08] bg-[#0E1528]/80 p-5 hover:border-red-500/70 hover:shadow-[0_0_30px_rgba(239,68,68,0.25)] transition-all duration-300 cursor-pointer group space-y-3"
            onclick="inspectEvidence(3)"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold uppercase text-red-400 bg-red-950/60 px-2.5 py-0.5 rounded-md border border-red-800/30">
                Evidence #03
              </span>
              <span class="text-xs font-mono font-bold text-red-400">-₹70,000/mo</span>
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-red-400 transition-colors">
              The Pocket Diary Advance
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Site engineer hands out ₹35,000 cash advance to electrical contractor. Written in a pocket notebook, forgotten at settlement.
            </p>
            <div class="pt-2 border-t border-white/[0.06] text-[11px] font-bold text-blue-400 flex items-center justify-between">
              <span>Inspect Brift Fix</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </div>

          <!-- Card 4 -->
          <div
            class="evidence-card rounded-2xl border border-white/[0.08] bg-[#0E1528]/80 p-5 hover:border-red-500/70 hover:shadow-[0_0_30px_rgba(239,68,68,0.25)] transition-all duration-300 cursor-pointer group space-y-3"
            onclick="inspectEvidence(4)"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold uppercase text-red-400 bg-red-950/60 px-2.5 py-0.5 rounded-md border border-red-800/30">
                Evidence #04
              </span>
              <span class="text-xs font-mono font-bold text-red-400">-₹50,000/mo</span>
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-red-400 transition-colors">
              Emergency Retail Markups
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Site runs out of binding wire on Thursday. Supervisor rushes to retail hardware store with an 18% markup so labor doesn't stall.
            </p>
            <div class="pt-2 border-t border-white/[0.06] text-[11px] font-bold text-blue-400 flex items-center justify-between">
              <span>Inspect Brift Fix</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </div>
        </div>

        <!-- Dynamic Forensic Spotlight Box -->
        <div id="forensic-spotlight" class="mt-6 rounded-3xl border border-blue-500/30 bg-[#0C1324]/90 p-5 sm:p-7 shadow-[0_10px_35px_rgba(0,0,0,0.5)]">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/[0.08] pb-3 mb-3">
            <div class="flex items-center gap-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-blue-400 animate-pulse"></span>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue-400" id="spotlight-title">
                CASE FILE #01 // GHOST LABOR RESOLUTION
              </span>
            </div>
            <span class="text-xs font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-800/40 px-3 py-1 rounded-full">
              Status: Sealed by Brift
            </span>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed" id="spotlight-desc">
            <strong class="text-white">The Brift Closed-Loop:</strong> The site supervisor opens the app at the site gate. Even in a basement with 0 cellular signal, attendance is logged and timestamped with worker categorization (skilled/unskilled). The record locks permanently and syncs to central payroll the second the phone connects to signal. Zero paper registers, zero phantom workers.
          </p>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SCENE 03 // THE 24-HOUR MOVIE SEQUENCE -->
    <!-- ========================================== -->
    <section
      id="scene-3"
      class="stacked-card z-30 bg-[#0B1226] pt-24 pb-20 sm:pt-28 sm:pb-28"
    >
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full my-auto">
        <!-- Slate Header & Movie Controls -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 border-b border-white/[0.08] pb-6">
          <div class="space-y-2 max-w-2xl">
            <span class="inline-block text-xs font-bold font-mono uppercase tracking-wider text-amber-300 bg-amber-950/40 border border-amber-800/40 px-3 py-1 rounded-full">
              REEL 03 // ACT III: 24 HOURS ON SITE
            </span>
            <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
              Watch a day on your sites unfold.
            </h2>
            <p class="text-sm text-slate-300">
              See how chaotic phone calls and unverified receipts transform into automated, synchronized records.
            </p>
          </div>

          <!-- Controls -->
          <div class="flex items-center gap-3">
            <button
              id="movie-autoplay-btn"
              type="button"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 text-slate-950 px-5 py-2.5 text-xs font-mono font-bold shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all cursor-pointer active:scale-95"
              onclick="toggleMovieAutoPlay()"
            >
              <span id="play-icon">▶</span>
              <span id="play-text">Auto-Play Movie Mode</span>
            </button>
          </div>
        </div>

        <!-- Theater Stage -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Storyboard Narration Card -->
          <div class="lg:col-span-5 space-y-5">
            <!-- Timecode Buttons -->
            <div class="grid grid-cols-2 gap-2" id="movie-scene-buttons">
              <button
                type="button"
                class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border-2 border-amber-400 bg-amber-400 text-slate-950 text-left transition-all cursor-pointer font-mono"
                data-scene="1"
                onclick="showMovieScene(1)"
              >
                07:00 AM • Site Gate
              </button>
              <button
                type="button"
                class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-white/10 bg-white/[0.04] text-slate-300 text-left hover:border-amber-400/50 transition-all cursor-pointer font-mono"
                data-scene="2"
                onclick="showMovieScene(2)"
              >
                11:30 AM • Delivery Bay
              </button>
              <button
                type="button"
                class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-white/10 bg-white/[0.04] text-slate-300 text-left hover:border-amber-400/50 transition-all cursor-pointer font-mono"
                data-scene="3"
                onclick="showMovieScene(3)"
              >
                03:15 PM • Site Office
              </button>
              <button
                type="button"
                class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-white/10 bg-white/[0.04] text-slate-300 text-left hover:border-amber-400/50 transition-all cursor-pointer font-mono"
                data-scene="4"
                onclick="showMovieScene(4)"
              >
                07:30 PM • Living Room
              </button>
            </div>

            <!-- Screenplay Subtitle Card -->
            <div class="rounded-3xl border border-white/[0.1] bg-[#0E162B] p-6 sm:p-7 space-y-4 shadow-xl">
