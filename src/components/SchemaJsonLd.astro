---
export interface Props {
  type?: 'home' | 'pricing' | 'default';
  faqItems?: Array<{ question: string; answer: string }>;
}

const { type = 'default', faqItems = [] } = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://getbrift.com';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullBaseUrl = `${siteUrl}${base}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Brift',
  url: fullBaseUrl,
  logo: `${fullBaseUrl}/logo.png`,
  image: `${fullBaseUrl}/og-image.png`,
  description: 'Construction-operations software platform replacing spreadsheets, WhatsApp groups and memory with one reliable hub.',
  telephone: '+919037532036',
  email: 'brift.official@gmail.com',
  sameAs: [
    'https://getbrift.com',
  ],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Brift — Construction Operations Software',
  image: `${fullBaseUrl}/og-image.png`,
  '@id': `${fullBaseUrl}/#organization`,
  url: fullBaseUrl,
  telephone: '+919037532036',
  email: 'brift.official@gmail.com',
  priceRange: 'Custom Quote via Demo',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'IN',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '19:00',
  },
  areaServed: {
    '@type': 'Country',
    name: 'India',
  },
  description: 'Enterprise ERP and site-management operations software for multi-site construction firms and general contractors.',
};

const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Brift Construction Operations OS',
  operatingSystem: 'Web, iOS, Android (PWA)',
  applicationCategory: 'BusinessApplication',
  image: `${fullBaseUrl}/og-image.png`,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'INR',
    offerCount: '3',
    description: 'Custom scoped plans based on active site count. Unlocked via live demo walkthrough.',
    url: `${fullBaseUrl}/#demo`,
  },
};

const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

{type === 'home' && (
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
)}

{type === 'pricing' && (
  <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
)}

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
