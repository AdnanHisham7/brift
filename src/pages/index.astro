  <!-- INTERACTIVE CLIENT-SIDE ENGINE -->
  <script is:inline>
    // 1. Reality Switcher (Chaos vs Brift)
    function switchReality(mode) {
      const panelChaos = document.getElementById('panel-chaos');
      const panelBrift = document.getElementById('panel-brift');
      const btnChaos = document.getElementById('btn-chaos');
      const btnBrift = document.getElementById('btn-brift');

      if (!panelChaos || !panelBrift || !btnChaos || !btnBrift) return;

      if (mode === 'chaos') {
        panelChaos.classList.remove('hidden');
        panelBrift.classList.add('hidden');
        btnChaos.className = 'px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-red-600 text-white shadow-sm';
        btnBrift.className = 'px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-ink-2 hover:text-blue';
      } else {
        panelChaos.classList.add('hidden');
        panelBrift.classList.remove('hidden');
        btnChaos.className = 'px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all text-ink-2 hover:text-red-600';
        btnBrift.className = 'px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-blue text-white shadow-sm';
      }
    }

    // 2. Story Mode Jump
    function jumpToChapter(chapId) {
      const target = document.getElementById('chapter-' + chapId);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      // Update screens directly
      const stages = document.querySelectorAll('.story-stage-screen');
      stages.forEach(stage => {
        if (stage.getAttribute('data-for-chapter') === chapId) {
          stage.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
          stage.classList.add('opacity-100', 'scale-100');
        } else {
          stage.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          stage.classList.remove('opacity-100', 'scale-100');
        }
      });

      // Update button highlights
      document.querySelectorAll('.story-tab-btn').forEach(btn => {
        if (btn.getAttribute('data-target-chapter') === chapId) {
          btn.className = 'story-tab-btn px-4 py-2 rounded-xl text-xs font-bold border border-blue bg-blue text-white shadow-xs transition-all cursor-pointer';
        } else {
          btn.className = 'story-tab-btn px-4 py-2 rounded-xl text-xs font-bold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer';
        }
      });
    }

    // 3. Interactive Tour Tabs
    function switchTourTab(tabId) {
      const panels = document.querySelectorAll('.tour-panel');
      panels.forEach(p => p.classList.add('hidden'));

      const activePanel = document.getElementById('tour-panel-' + tabId);
      if (activePanel) {
        activePanel.classList.remove('hidden');
      }

      document.querySelectorAll('.tour-btn').forEach(btn => {
        if (btn.getAttribute('data-tab') === tabId) {
          btn.className = 'tour-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border-2 border-blue bg-blue text-white shadow-xs transition-all cursor-pointer';
        } else {
          btn.className = 'tour-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer';
        }
      });
    }

    // 4. Interactive Leakage Calculator
    function setCalculatorSites(numSites) {
      const siteButtons = document.querySelectorAll('.calc-site-btn');
      siteButtons.forEach(btn => {
        if (parseInt(btn.getAttribute('data-sites'), 10) === numSites) {
          btn.className = 'calc-site-btn px-4 py-2 rounded-xl text-xs font-bold border-2 border-yellow bg-yellow text-ink shadow-sm transition-all cursor-pointer';
        } else {
          btn.className = 'calc-site-btn px-4 py-2 rounded-xl text-xs font-bold border border-navy-line bg-navy-surface text-white hover:border-yellow transition-all cursor-pointer';
        }
      });

      const label = document.getElementById('calc-site-label');
      if (label) label.textContent = numSites + ' Active Sites';

      // Base rates per site:
      // Advances: ₹17,500/site/mo
      // Muster: ₹10,000/site/mo
      // Materials: ₹20,000/site/mo
      // Retail markups: ₹12,500/site/mo
      const adv = numSites * 17500;
      const muster = numSites * 10000;
      const mat = numSites * 20000;
      const retail = numSites * 12500;
      const monthlyTotal = adv + muster + mat + retail;
      const annualTotal = monthlyTotal * 12;

      const advEl = document.getElementById('loss-advances');
      const musterEl = document.getElementById('loss-muster');
      const matEl = document.getElementById('loss-materials');
      const retailEl = document.getElementById('loss-retail');
      const monthlyEl = document.getElementById('calc-monthly-total');
      const annualEl = document.getElementById('calc-annual-total');

      if (advEl) advEl.textContent = '₹' + adv.toLocaleString('en-IN') + ' / mo';
      if (musterEl) musterEl.textContent = '₹' + muster.toLocaleString('en-IN') + ' / mo';
      if (matEl) matEl.textContent = '₹' + mat.toLocaleString('en-IN') + ' / mo';
      if (retailEl) retailEl.textContent = '₹' + retail.toLocaleString('en-IN') + ' / mo';
      if (monthlyEl) monthlyEl.textContent = '₹' + monthlyTotal.toLocaleString('en-IN') + ' / mo';
      if (annualEl) {
        const lakhs = (annualTotal / 100000).toFixed(1);
        annualEl.textContent = '₹' + lakhs + ' Lakhs every year';
      }
    }

    // 5. Demo Form Submission Simulation
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('lead-demo-form');
      const successBox = document.getElementById('demo-success-box');
      if (form && successBox) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
        });
      }
    });
  </script>
</Layout>
