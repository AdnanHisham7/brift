      ];

      const today = new Date();
      let browseYear = today.getFullYear();
      let browseMonth = today.getMonth(); // 0-indexed

      // Default selected date: tomorrow (or Monday if tomorrow is Sunday)
      let selectedDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
      if (selectedDate.getDay() === 0) {
        selectedDate.setDate(selectedDate.getDate() + 1);
      }
      let selectedSlot = '11:30 AM';

      const monthNames = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'
      ];
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

      function formatDateDisplay(d) {
        return dayNames[d.getDay()] + ', ' + monthNames[d.getMonth()].slice(0, 3) + ' ' + d.getDate() + ', ' + d.getFullYear();
      }

      function formatShortDate(d) {
        return dayNames[d.getDay()] + ', ' + monthNames[d.getMonth()].slice(0, 3) + ' ' + d.getDate();
      }

      function updateSlotDisplay() {
        if (selectedDayLabel) {
          selectedDayLabel.textContent = formatShortDate(selectedDate);
        }
        if (selectedSlotText) {
          selectedSlotText.textContent = formatShortDate(selectedDate) + ', ' + selectedDate.getFullYear() + ' @ ' + selectedSlot + ' IST';
        }
        if (bookingDateInput) {
          const y = selectedDate.getFullYear();
          const m = String(selectedDate.getMonth() + 1).padStart(2, '0');
          const d = String(selectedDate.getDate()).padStart(2, '0');
          bookingDateInput.value = y + '-' + m + '-' + d;
        }
        if (bookingTimeInput) {
          bookingTimeInput.value = selectedSlot;
        }
      }

      function renderSlots() {
        slotsGrid.innerHTML = '';
        timeSlots.forEach(function(slot) {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSelected = slot === selectedSlot;
          btn.className = 'slot-btn px-2 sm:px-3 py-2 rounded-xl text-xs font-mono font-bold transition-all cursor-pointer text-center ' +
