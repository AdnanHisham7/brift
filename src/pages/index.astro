                  class="w-full rounded-xl bg-blue hover:bg-blue-hover text-white font-bold text-sm py-3.5 px-6 shadow-sm transition-all cursor-pointer active:scale-98 flex items-center justify-center gap-2 group"
                >
                  <Calendar class="w-4 h-4" />
                  <span id="submit-demo-btn-text">Confirm Demo Booking</span>
                  <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                </button>
              </div>

              <div class="flex items-center justify-between text-[11px] text-muted pt-0.5">
                <span>Direct 1-on-1 • Google Meet Video Invite</span>
                <span>Dispatched to brift.official@gmail.com</span>
              </div>
            </form>

            <!-- Success State -->
            <div id="demo-success-box" class="hidden py-6 space-y-5 text-center">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mx-auto">
                <CheckCircle2 class="w-7 h-7" />
              </div>
              <div class="space-y-1">
                <h4 class="text-2xl font-bold text-ink">Demo Scheduled Successfully</h4>
                <p class="text-xs sm:text-sm text-muted max-w-md mx-auto leading-relaxed">
                  Your appointment slot has been confirmed and notification dispatched to <strong>brift.official@gmail.com</strong>.
                </p>
              </div>

              <!-- Summary Card -->
              <div class="rounded-xl border border-line bg-slate-50 p-4 space-y-3 text-left">
                <div class="flex items-center justify-between border-b border-line pb-2">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-ink">Appointment Pass</span>
                  <span class="text-[10px] font-mono text-emerald-800 bg-emerald-100 border border-emerald-300 px-2 py-0.5 rounded font-bold">
                    CONFIRMED
                  </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs sm:text-sm">
                  <div>
                    <span class="text-muted block text-[11px]">Date & Time:</span>
                    <strong id="conf-slot-time" class="text-ink"></strong>
                  </div>
                  <div>
                    <span class="text-muted block text-[11px]">Format:</span>
                    <strong class="text-ink">30-Min Google Meet</strong>
                  </div>
                  <div>
                    <span class="text-muted block text-[11px]">Attendee:</span>
                    <span id="conf-attendee" class="text-ink font-medium"></span>
                  </div>
                  <div>
                    <span class="text-muted block text-[11px]">Contact:</span>
                    <span id="conf-phone" class="text-ink font-mono"></span>
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <div class="space-y-2 pt-1">
                <a
                  id="btn-google-cal"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-blue hover:bg-blue-hover text-white py-3 px-4 text-xs sm:text-sm font-bold transition-all shadow-xs"
                >
                  <Calendar class="w-4 h-4" />
                  <span>Add to Google Calendar</span>
                </a>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <button
                    type="button"
                    id="btn-download-ics"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-white hover:bg-slate-50 text-ink border border-line py-2.5 px-3 text-xs font-semibold shadow-2xs transition-all cursor-pointer"
                  >
                    <Calendar class="w-3.5 h-3.5 text-muted" />
                    <span>Download .ics Calendar</span>
                  </button>

                  <a
                    id="btn-whatsapp-conf"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white py-2.5 px-3 text-xs font-bold transition-all shadow-2xs"
                  >
                    <MessageSquare class="w-3.5 h-3.5" />
                    <span>Confirm on WhatsApp</span>
                  </a>
                </div>
              </div>

              <p class="text-center text-xs text-muted pt-1">
                Need to reschedule? WhatsApp us directly at <span class="font-medium text-ink">+91 9037532036</span>.
              </p>
            </div>

          </div>
        </div>

      </div>
    </section>

  </div>

  <!-- SCRIPT ENGINE: LENIS SMOOTH SCROLL, GSAP REVEALS & CALENDAR ENGINE -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger);

    // 1. LENIS SMOOTH SCROLLING
    let lenis: Lenis | null = null;
    try {
      lenis = new Lenis({
        lerp: 0.08,
        wheelMultiplier: 1.05,
        touchMultiplier: 1.2,
        smoothWheel: true,
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis?.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Smooth Anchor Navigation
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href !== '#' && href.startsWith('#')) {
            const target = document.querySelector(href);
            if (target && lenis) {
              e.preventDefault();
              lenis.scrollTo(target as HTMLElement, { offset: -60, duration: 1.2 });
            }
          }
        });
      });
    } catch (e) {
      console.warn('Lenis smooth scroll initialized with fallback', e);
    }

    // 2. CLEAN EDITORIAL MOTION REVEALS
    function initMotionAnimations() {
      const elements = document.querySelectorAll('[data-motion]');
      if (!elements.length) return;

      document.body.classList.add('motion-js-ready');

      elements.forEach((el) => {
        const delay = (parseInt(el.getAttribute('data-delay') || '0', 10)) / 1000;
        gsap.fromTo(
          el,
          {
            opacity: 0,
            y: el.getAttribute('data-motion') === 'zoom-in' ? 18 : 30,
            scale: el.getAttribute('data-motion') === 'zoom-in' ? 0.96 : 1,
          },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.75,
            delay: delay,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            },
          }
        );
      });
    }

    // 3. INTERACTIVE CALENDAR & BOOKING SUBMISSION ENGINE
    function initEmbeddedBookingCalendar() {
      const form = document.getElementById('lead-demo-form') as HTMLFormElement | null;
      const successBox = document.getElementById('demo-success-box');
      const daysGrid = document.getElementById('cal-days-grid');
      const monthTitle = document.getElementById('cal-month-title');
      const prevMonthBtn = document.getElementById('cal-prev-month-btn') as HTMLButtonElement | null;
      const nextMonthBtn = document.getElementById('cal-next-month-btn') as HTMLButtonElement | null;
      const slotsGrid = document.getElementById('time-slots-grid');
      const selectedDayLabel = document.getElementById('cal-selected-day-label');
      const selectedSlotText = document.getElementById('selected-slot-text');
      const bookingDateInput = document.getElementById('booking-date') as HTMLInputElement | null;
      const bookingTimeInput = document.getElementById('booking-time') as HTMLInputElement | null;
      const submitBtn = document.getElementById('submit-demo-btn') as HTMLButtonElement | null;
      const submitBtnText = document.getElementById('submit-demo-btn-text');
      const errorBox = document.getElementById('demo-error-box');

      if (!form || !daysGrid || !slotsGrid) return;

      const timeSlots = [
        '10:00 AM',
        '11:30 AM',
        '02:00 PM',
        '03:30 PM',
        '05:00 PM',
        '06:30 PM',
      ];

      const today = new Date();
      let browseYear = today.getFullYear();
      let browseMonth = today.getMonth();

      let selectedDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
      if (selectedDate.getDay() === 0) {
        selectedDate.setDate(selectedDate.getDate() + 1);
      }
      let selectedSlot = '11:30 AM';

      const monthNames = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December',
      ];
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

      function formatDateDisplay(d: Date) {
        return dayNames[d.getDay()] + ', ' + monthNames[d.getMonth()].slice(0, 3) + ' ' + d.getDate() + ', ' + d.getFullYear();
      }

      function formatShortDate(d: Date) {
        return dayNames[d.getDay()] + ', ' + monthNames[d.getMonth()].slice(0, 3) + ' ' + d.getDate();
      }

      function updateSlotDisplay() {
        if (selectedDayLabel) {
          selectedDayLabel.textContent = formatShortDate(selectedDate);
        }
        if (selectedSlotText) {
          selectedSlotText.textContent = formatDateDisplay(selectedDate) + ' @ ' + selectedSlot + ' IST';
        }
        if (bookingDateInput) {
          bookingDateInput.value = selectedDate.toISOString().split('T')[0];
        }
        if (bookingTimeInput) {
          bookingTimeInput.value = selectedSlot + ' IST';
        }
      }

      function renderTimeSlots() {
        if (!slotsGrid) return;
        slotsGrid.innerHTML = '';
        timeSlots.forEach((slot) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = (slot === selectedSlot)
            ? 'py-2 px-1 text-center rounded-lg text-xs font-mono font-bold bg-blue text-white shadow-xs transition-all cursor-pointer'
            : 'py-2 px-1 text-center rounded-lg text-xs font-mono font-medium bg-white hover:bg-slate-50 border border-line text-ink transition-all cursor-pointer';
          btn.textContent = slot;

          btn.addEventListener('click', () => {
            selectedSlot = slot;
            renderTimeSlots();
            updateSlotDisplay();
          });

          slotsGrid.appendChild(btn);
        });
      }

      function renderCalendar() {
        if (!daysGrid) return;
        if (monthTitle) {
          monthTitle.textContent = monthNames[browseMonth] + ' ' + browseYear;
        }

        const isCurrentMonth = (browseYear === today.getFullYear() && browseMonth === today.getMonth());
        if (prevMonthBtn) {
          prevMonthBtn.disabled = isCurrentMonth;
        }

        daysGrid.innerHTML = '';

        const firstDayIndex = new Date(browseYear, browseMonth, 1).getDay();
        const mondayOffset = (firstDayIndex === 0 ? 6 : firstDayIndex - 1);
        const daysInMonth = new Date(browseYear, browseMonth + 1, 0).getDate();

        for (let i = 0; i < mondayOffset; i++) {
          const empty = document.createElement('div');
          empty.className = 'py-1.5';
          daysGrid.appendChild(empty);
        }

        const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

        for (let day = 1; day <= daysInMonth; day++) {
          const thisDate = new Date(browseYear, browseMonth, day);
          const isSunday = (thisDate.getDay() === 0);
          const isPast = (thisDate < todayStart);
          const isToday = (thisDate.getTime() === todayStart.getTime());
          const isSelected = (
            selectedDate &&
            thisDate.getFullYear() === selectedDate.getFullYear() &&
            thisDate.getMonth() === selectedDate.getMonth() &&
            thisDate.getDate() === selectedDate.getDate()
          );

          const cell = document.createElement('button');
          cell.type = 'button';
          cell.textContent = String(day);

          if (isSunday || isPast) {
            cell.disabled = true;
            cell.className = 'py-1.5 text-xs font-mono rounded-lg text-slate-300 cursor-not-allowed';
            if (isSunday) cell.classList.add('bg-rose-50/30', 'text-rose-300');
          } else if (isSelected) {
            cell.className = 'py-1.5 text-xs font-mono font-bold rounded-lg bg-blue text-white shadow-xs cursor-pointer';
          } else if (isToday) {
            cell.className = 'py-1.5 text-xs font-mono font-bold rounded-lg border border-blue text-blue hover:bg-blue/5 cursor-pointer';
          } else {
            cell.className = 'py-1.5 text-xs font-mono rounded-lg text-ink hover:bg-slate-200/80 cursor-pointer';
          }

          if (!isSunday && !isPast) {
            cell.addEventListener('click', () => {
              selectedDate = thisDate;
              renderCalendar();
              updateSlotDisplay();
            });
          }

          daysGrid.appendChild(cell);
        }
      }

      if (prevMonthBtn) {
        prevMonthBtn.addEventListener('click', () => {
          if (browseMonth === 0) {
            browseMonth = 11;
            browseYear--;
          } else {
            browseMonth--;
          }
          renderCalendar();
        });
      }

      if (nextMonthBtn) {
        nextMonthBtn.addEventListener('click', () => {
          if (browseMonth === 11) {
            browseMonth = 0;
            browseYear++;
          } else {
            browseMonth++;
          }
          renderCalendar();
        });
      }

      renderCalendar();
      renderTimeSlots();
      updateSlotDisplay();

      // Form Submission
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorBox) errorBox.classList.add('hidden');

        const name = (document.getElementById('demo-name') as HTMLInputElement)?.value.trim();
        const phone = (document.getElementById('demo-phone') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById('demo-email') as HTMLInputElement)?.value.trim();
        const company = (document.getElementById('demo-company') as HTMLInputElement)?.value.trim();
        const activeSites = (document.getElementById('demo-sites') as HTMLSelectElement)?.value;
        const scheduledDate = bookingDateInput?.value;
        const scheduledTime = bookingTimeInput?.value;

        if (!name || !phone || !email || !company || !scheduledDate || !scheduledTime) {
          if (errorBox) {
            errorBox.textContent = 'Please fill out all required fields and select a date & slot.';
            errorBox.classList.remove('hidden');
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = 'Securing Your Slot...';

        const payload = {
          name: name,
          email: email,
          phone: phone,
          company: company,
          active_sites: activeSites,
          scheduled_date: scheduledDate,
          scheduled_time: scheduledTime,
          _subject: `New Demo Scheduled: ${name} (${company}) — ${scheduledDate} @ ${scheduledTime}`,
          _captcha: "false",
          _template: "table"
        };

        try {
          const res = await fetch("https://formsubmit.co/ajax/brift.official@gmail.com", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify(payload)
          });

          const data = await res.json().catch(() => ({}));

          if (res.ok || data.success === "true" || data.success === true) {
            form.classList.add('hidden');
            if (successBox) successBox.classList.remove('hidden');

            const confSlotTime = document.getElementById('conf-slot-time');
            const confAttendee = document.getElementById('conf-attendee');
            const confPhone = document.getElementById('conf-phone');
            if (confSlotTime) confSlotTime.textContent = formatDateDisplay(selectedDate) + ' @ ' + selectedSlot + ' IST';
            if (confAttendee) confAttendee.textContent = name + ' • ' + company;
            if (confPhone) confPhone.textContent = phone + ' (' + email + ')';

            setupConfirmationCalendarLinks({
              name,
              company,
              email,
              phone,
              activeSites,
              dateObj: selectedDate,
              timeStr: selectedSlot
            });

            if (lenis && successBox) {
              lenis.scrollTo(successBox, { offset: -60, duration: 1 });
            } else if (successBox) {
              successBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          } else {
            throw new Error(data.message || 'Unable to schedule slot. Please try again.');
          }
        } catch (err) {
          console.error(err);
          if (errorBox) {
            errorBox.textContent = 'We encountered an issue submitting your request. You can directly WhatsApp our desk at +91 9037532036 to confirm your slot.';
            errorBox.classList.remove('hidden');
          }
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = 'Confirm Demo Booking';
        }
      });
    }

    function setupConfirmationCalendarLinks(data: {
      name: string;
      company: string;
      email: string;
      phone: string;
      activeSites: string;
      dateObj: Date;
      timeStr: string;
    }) {
      const { name, company, email, phone, dateObj, timeStr } = data;

      const [timePart, meridiem] = timeStr.split(' ');
      let [hours, minutes] = timePart.split(':').map(Number);
      if (meridiem === 'PM' && hours !== 12) hours += 12;
      if (meridiem === 'AM' && hours === 12) hours = 0;

      const startLocal = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate(), hours, minutes, 0);
      const endLocal = new Date(startLocal.getTime() + 30 * 60 * 1000);

      function toIsoUtc(d: Date) {
        return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      }

      const startUtc = toIsoUtc(startLocal);
      const endUtc = toIsoUtc(endLocal);

      const title = encodeURIComponent(`Brift 1-on-1 Product Walkthrough — ${company}`);
      const details = encodeURIComponent(
        `Brift Construction OS 1-on-1 Demo & Walkthrough\n\nAttendee: ${name} (${company})\nEmail: ${email}\nPhone: ${phone}\nHost: Brift Operations Team\nMeeting: Google Meet link will be provided\nSupport: +91 9037532036 / brift.official@gmail.com`
      );
      const location = encodeURIComponent('Google Meet (Link will be sent to email)');

      const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${startUtc}/${endUtc}&details=${details}&location=${location}&add=brift.official@gmail.com,${encodeURIComponent(email)}`;
      const gcalBtn = document.getElementById('btn-google-cal');
      if (gcalBtn) gcalBtn.setAttribute('href', gcalUrl);

      const icsBtn = document.getElementById('btn-download-ics');
      if (icsBtn) {
        icsBtn.onclick = () => {
          const icsContent = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//Brift Technologies//Construction OS//EN',
            'CALSCALE:GREGORIAN',
            'METHOD:REQUEST',
            'BEGIN:VEVENT',
            `UID:brift-demo-${Date.now()}@brift.in`,
            `DTSTAMP:${toIsoUtc(new Date())}`,
            `DTSTART:${startUtc}`,
            `DTEND:${endUtc}`,
            `SUMMARY:Brift 1-on-1 Product Walkthrough — ${company}`,
            `DESCRIPTION:Brift Construction OS Walkthrough with ${name}. Host: Brift Operations. Phone: +91 9037532036.`,
            'LOCATION:Google Meet',
            'STATUS:CONFIRMED',
            'END:VEVENT',
            'END:VCALENDAR'
          ].join('\r\n');

          const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `brift-demo-${dateObj.toISOString().split('T')[0]}.ics`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        };
      }

      const waBtn = document.getElementById('btn-whatsapp-conf');
      if (waBtn) {
        const waText = encodeURIComponent(
          `Hi Brift team, I just scheduled a product walkthrough for ${company} on ${dateObj.toLocaleDateString('en-IN', { weekday: 'short', month: 'short', day: 'numeric' })} at ${timeStr} IST. Attendee: ${name} (${phone}).`
        );
        waBtn.setAttribute('href', `https://wa.me/919037532036?text=${waText}`);
      }
    }

    function initPage() {
      initMotionAnimations();
      initEmbeddedBookingCalendar();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage);
    } else {
      initPage();
    }
  </script>
</Layout>
