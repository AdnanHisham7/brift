---
export interface Props {
  type?: 'home' | 'pricing' | 'default';
  faqItems?: Array<{ question: string; answer: string }>;
}

const { type = 'default', faqItems = [] } = Astro.props;

const siteUrl = 'https://getbrift.com';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Brift',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Construction-operations software platform replacing spreadsheets, WhatsApp groups and memory with one reliable hub.',
  telephone: '+919037532036',
  email: 'brift.official@gmail.com',
  sameAs: [
    'https://www.getbrift.com',
  ],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Brift — Construction Operations Software',
  image: `${siteUrl}/logo-icon.png`,
  '@id': `${siteUrl}/#organization`,
  url: siteUrl,
  telephone: '+919037532036',
  email: 'brift.official@gmail.com',
  priceRange: '₹32,000 - ₹60,000',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'IN',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '19:00',
  },
  areaServed: {
    '@type': 'Country',
    name: 'India',
  },
  description: 'Enterprise ERP and site-management operations software for multi-site construction firms and general contractors.',
};

const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Brift Construction Operations OS',
  operatingSystem: 'Web, iOS, Android (PWA)',
  applicationCategory: 'BusinessApplication',
  offers: [
    {
      '@type': 'Offer',
      name: 'Core Plan',
      price: '32000',
      priceCurrency: 'INR',
      description: 'Your operational core — purchases, stock, attendance, contractors, vendors and funds, built around how you work.',
      url: `${siteUrl}/pricing`,
    },
    {
      '@type': 'Offer',
      name: 'Growth Plan',
      price: '45000',
      priceCurrency: 'INR',
      description: 'Everything in Core, plus deeper reporting, document versions, e-signatures, and 24h site updates.',
      url: `${siteUrl}/pricing`,
    },
    {
      '@type': 'Offer',
      name: 'Partner Plan',
      price: '60000',
      priceCurrency: 'INR',
      description: 'Everything in Growth, plus company portfolio, public landing page, and enquiry lead inbox.',
      url: `${siteUrl}/pricing`,
    },
  ],
};

const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

{type === 'home' && (
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
)}

{type === 'pricing' && (
  <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
)}

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
