---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import heroTransparentImg from '../assets/hero-phone-transparent.png';
import spendImg from '../assets/spend-analytics.png';
import materialsImg from '../assets/materials-stock.png';
import contractorImg from '../assets/contractor-report.png';
import reportsImg from '../assets/reports-overview.png';
import adminDashboardImg from '../assets/admin-dashboard.png';
import storiesImg from '../assets/stories-site-updates.png';
---

<Layout
  title="Brift — A Single Hub for Every Site"
  description="A cinematic operating system for construction companies ready to replace spreadsheets, WhatsApp groups and guesswork with one reliable view of every site, rupee and worker."
  schemaType="home"
>
  <!-- SCENE 01 // THE OVERTURE (CINEMATIC HERO) -->
  <section class="relative overflow-hidden pt-12 pb-24 sm:pt-20 sm:pb-32 bg-[#0B1020] text-on-dark border-b border-navy-line">
    <!-- Atmospheric Stage Lighting -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[850px] h-[550px] bg-gradient-to-tr from-blue/25 via-indigo-600/15 to-transparent blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/2 -right-20 w-[500px] h-[500px] bg-yellow/10 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 scanline-overlay pointer-events-none opacity-20" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Timecode Telemetry Header -->
      <div class="flex items-center justify-between border-b border-navy-line/80 pb-3 mb-10 text-[11px] font-mono tracking-widest text-on-dark-muted">
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-red-500 animate-ping"></span>
          <span class="text-white font-bold">REC ● LIVE FIELD FEED</span>
        </div>
        <div>FIELD OS // V2.4</div>
        <div class="hidden sm:block">SYSTEM INTEGRITY: 100% VERIFIED</div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Hero Story Text -->
        <div class="lg:col-span-7 space-y-6 text-left reveal">
          <div class="inline-flex items-center gap-2 rounded-full border border-navy-line bg-navy-surface px-3.5 py-1.5 text-xs font-semibold text-yellow backdrop-blur-md">
            <span>SCENE 01 // THE STAKES</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.06]">
            A single hub <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue via-indigo-400 to-yellow">for every site.</span>
          </h1>

          <p class="text-lg sm:text-xl text-on-dark-muted max-w-2xl leading-relaxed">
            You started a construction company to shape skylines and build wealth. Instead, you're trapped in 45 phone calls a day while ₹2.4 Lakhs quietly leaks every month through WhatsApp groups, uncounted bags, and unrecorded cash advances.
          </p>

          <!-- Primary Cinematic Triggers -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="#demo"
              class="inline-flex items-center justify-center rounded-xl bg-yellow text-ink px-8 py-4 text-base font-bold shadow-lg hover:bg-yellow-subtle focus-visible:outline-none transition-all active:scale-[0.98] group"
            >
              <span>Take Command — Book Demo</span>
              <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <a
              href="#story"
              class="inline-flex items-center justify-center rounded-xl bg-navy-surface border border-navy-line px-6 py-4 text-sm font-semibold text-white hover:border-yellow/50 transition-all gap-2"
            >
              <svg class="w-4 h-4 text-yellow" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
              <span>Watch The 24h Field Story</span>
            </a>
          </div>

          <!-- Telemetry Teleprompter Tickers -->
          <div class="pt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-xl">
            <div class="rounded-xl border border-navy-line bg-navy-surface p-3.5 shadow-sm">
              <span class="text-xl font-black text-white block">~₹29.5L</span>
              <span class="text-[11px] text-on-dark-muted block leading-tight">Monthly volume tracked per firm</span>
            </div>
            <div class="rounded-xl border border-navy-line bg-navy-surface p-3.5 shadow-sm">
              <span class="text-xl font-black text-emerald-400 block">100%</span>
              <span class="text-[11px] text-on-dark-muted block leading-tight">Offline basement sync</span>
            </div>
            <div class="col-span-2 sm:col-span-1 rounded-xl border border-navy-line bg-navy-surface p-3.5 shadow-sm">
              <span class="text-xl font-black text-yellow block">0 Leaks</span>
              <span class="text-[11px] text-on-dark-muted block leading-tight">No unverified cash movements</span>
            </div>
          </div>
        </div>

        <!-- 3D Centerpiece Floating Terminal -->
        <div class="lg:col-span-5 relative flex justify-center perspective-container reveal delay-100">
          <div class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[420px] animate-float">
            <!-- Holographic Halo -->
            <div class="absolute inset-4 bg-gradient-to-tr from-blue/30 via-indigo-500/20 to-yellow/20 blur-3xl rounded-full -z-10" aria-hidden="true"></div>

            <Image
              src={heroTransparentImg}
              alt="Brift Mobile Interface floating cutout with live project cards"
              class="w-full h-auto drop-shadow-[0_25px_35px_rgba(0,0,0,0.6)] select-none"
              loading="eager"
              fetchpriority="high"
              format="webp"
            />

            <!-- Holographic Telemetry Badge (Top Left) -->
            <div class="absolute -top-3 -left-4 sm:-left-6 rounded-2xl border border-navy-line bg-navy-surface/95 p-3.5 shadow-2xl backdrop-blur-md max-w-[200px] hidden sm:block animate-pulse-subtle">
              <div class="flex items-center gap-2.5">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
                <div>
                  <span class="text-[10px] uppercase font-mono tracking-wider text-on-dark-muted block">Verified Funds</span>
                  <span class="text-xs font-black text-white block">₹62,00,000 Locked</span>
                </div>
              </div>
            </div>

            <!-- Holographic Telemetry Badge (Bottom Right) -->
            <div class="absolute -bottom-4 -right-4 sm:-right-6 rounded-2xl border border-navy-line bg-navy-surface/95 p-3.5 shadow-2xl backdrop-blur-md max-w-[210px]">
              <div class="flex items-center gap-2.5">
                <div class="h-2.5 w-2.5 rounded-full bg-emerald-400 animate-ping"></div>
                <div>
                  <span class="text-[10px] uppercase font-mono tracking-wider text-yellow block">Site Gate 0 Bars</span>
                  <span class="text-xs font-bold text-white block">30 Workers Synced</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCENE 02 // THE CRIME SCENE (FORENSIC LEAK INSPECTION) -->
  <section id="evidence" class="py-20 sm:py-28 border-b border-line bg-white relative">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3 reveal">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-red-600 bg-red-50 border border-red-200 px-3 py-1 rounded-full">
          SCENE 02 // THE CRIME SCENE
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-ink">
          Where does ₹2.4 Lakhs quietly vanish every single month?
        </h2>
        <p class="text-base sm:text-lg text-muted">
          Click on any evidence tag to inspect how lack of records creates silent financial bleeding across your sites.
        </p>
      </div>

      <!-- Interactive Crime Scene Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Evidence Item 1 -->
        <div
          class="evidence-card rounded-2xl border-2 border-line bg-bg p-6 hover:border-red-500 hover:shadow-elevated transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(1)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-600 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #01
            </span>
            <span class="text-xs font-bold text-red-600">-₹40,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-ink group-hover:text-red-600 transition-colors">
            The Ghost Labor Register
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            Attendance taken on crumpled paper notebooks. By Saturday evening, 4 to 6 extra phantom workers have been added to the payout tally.
          </p>
          <div class="pt-2 border-t border-line text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span>&rarr;</span>
          </div>
        </div>

        <!-- Evidence Item 2 -->
        <div
          class="evidence-card rounded-2xl border-2 border-line bg-bg p-6 hover:border-red-500 hover:shadow-elevated transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(2)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-600 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #02
            </span>
            <span class="text-xs font-bold text-red-600">-₹80,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-ink group-hover:text-red-600 transition-colors">
            The Vanishing Cement Challan
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            200 bags billed by the supplier. 170 bags actually unloaded. Delivery challan signed in pencil and lost under a windshield.
          </p>
          <div class="pt-2 border-t border-line text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span>&rarr;</span>
          </div>
        </div>

        <!-- Evidence Item 3 -->
        <div
          class="evidence-card rounded-2xl border-2 border-line bg-bg p-6 hover:border-red-500 hover:shadow-elevated transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(3)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-600 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #03
            </span>
            <span class="text-xs font-bold text-red-600">-₹70,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-ink group-hover:text-red-600 transition-colors">
            The Pocket Diary Advance
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            Site manager hands out ₹35,000 cash advance to electrical contractor. Written in a diary, forgotten by final settlement time.
          </p>
          <div class="pt-2 border-t border-line text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span>&rarr;</span>
          </div>
        </div>

        <!-- Evidence Item 4 -->
        <div
          class="evidence-card rounded-2xl border-2 border-line bg-bg p-6 hover:border-red-500 hover:shadow-elevated transition-all duration-300 cursor-pointer group space-y-3"
          onclick="inspectEvidence(4)"
        >
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase text-red-600 bg-red-100 px-2.5 py-0.5 rounded-md">
              Evidence #04
            </span>
            <span class="text-xs font-bold text-red-600">-₹50,000 / mo</span>
          </div>
          <h3 class="text-lg font-bold text-ink group-hover:text-red-600 transition-colors">
            Emergency Retail Markups
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            Site runs out of steel on Thursday afternoon. Supervisor buys from local retail dealer at an 18% markup so work doesn't stall.
          </p>
          <div class="pt-2 border-t border-line text-[11px] font-bold text-blue flex items-center justify-between">
            <span>Inspect Brift Fix</span>
            <span>&rarr;</span>
          </div>
        </div>
      </div>

      <!-- Dynamic Forensic Spotlight Box -->
      <div id="forensic-spotlight" class="mt-8 rounded-3xl border border-blue/30 bg-blue-soft/30 p-6 sm:p-8 transition-all duration-300">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-blue/20 pb-4 mb-4">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-blue animate-pulse"></span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue" id="spotlight-title">
              CASE FILE #01 // GHOST LABOR RESOLUTION
            </span>
          </div>
          <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full">
            Status: Fully Plugged by Brift
          </span>
        </div>
        <p class="text-sm text-ink leading-relaxed" id="spotlight-desc">
          <strong>The Brift Closed-Loop:</strong> The site supervisor opens the app at the site gate. Even in a basement with 0 cellular signal, attendance is logged and timestamped with worker categorization (skilled/unskilled). The record locks permanently and syncs to central payroll the second the phone connects to signal. Zero paper registers, zero phantom workers.
        </p>
      </div>
    </div>
  </section>

  <!-- SCENE 03 // THE 24-HOUR MOVIE SEQUENCE (AUTO-ADVANCE THEATER) -->
  <section id="story" class="py-20 sm:py-28 border-b border-line bg-[#0B1020] text-on-dark relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Section Title & Movie Controls -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-navy-line pb-8 reveal">
        <div class="space-y-3 max-w-2xl">
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-yellow bg-navy-surface border border-navy-line px-3 py-1 rounded-full">
            SCENE 03 // THE 24-HOUR DAY
          </span>
          <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
            Watch a day on your sites unfold.
          </h2>
          <p class="text-sm sm:text-base text-on-dark-muted">
            See how chaotic phone calls and unverified receipts transform into automated, synchronized records.
          </p>
        </div>

        <!-- Movie Controls Bar -->
        <div class="flex items-center gap-3">
          <button
            id="movie-autoplay-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-xl bg-yellow text-ink px-5 py-3 text-xs font-black shadow-md hover:bg-yellow-subtle transition-all cursor-pointer"
            onclick="toggleMovieAutoPlay()"
          >
            <span id="play-icon">▶</span>
            <span id="play-text">Auto-Play Movie Mode</span>
          </button>
        </div>
      </div>

      <!-- Theater Stage: Screen + Storyboard -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Left: Storyboard Narration Card -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Time Buttons -->
          <div class="grid grid-cols-2 gap-2" id="movie-scene-buttons">
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border-2 border-yellow bg-yellow text-ink text-left transition-all cursor-pointer"
              data-scene="1"
              onclick="showMovieScene(1)"
            >
              07:00 AM • Site Gate
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-navy-line bg-navy-surface text-on-dark text-left hover:border-yellow transition-all cursor-pointer"
              data-scene="2"
              onclick="showMovieScene(2)"
            >
              11:30 AM • Delivery Bay
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-navy-line bg-navy-surface text-on-dark text-left hover:border-yellow transition-all cursor-pointer"
              data-scene="3"
              onclick="showMovieScene(3)"
            >
              03:15 PM • Site Office
            </button>
            <button
              type="button"
              class="movie-tab px-4 py-2.5 rounded-xl text-xs font-bold border border-navy-line bg-navy-surface text-on-dark text-left hover:border-yellow transition-all cursor-pointer"
              data-scene="4"
              onclick="showMovieScene(4)"
            >
              07:30 PM • Living Room
            </button>
          </div>

          <!-- Movie Screenplay Subtitle Card -->
          <div class="rounded-3xl border border-navy-line bg-navy-surface p-6 sm:p-8 space-y-4 shadow-xl">
            <div class="flex items-center justify-between text-xs font-mono text-yellow border-b border-navy-line/80 pb-3">
              <span id="scene-timecode">TIMECODE: 07:00:00 AM</span>
              <span id="scene-location">LOCATION: SITE GATE</span>
            </div>

            <h3 class="text-2xl font-bold text-white leading-tight" id="scene-headline">
              Muster roll logged without network or ghost labor.
            </h3>

            <p class="text-sm text-on-dark-muted leading-relaxed" id="scene-narration">
              Thirty workers arrive at the gate. Even in a basement with zero cellular bars, the supervisor taps each worker in Brift. Attendance is locked to prevent week-end muster inflation.
            </p>

            <div class="pt-3 border-t border-navy-line/80 flex items-center justify-between text-xs">
              <span class="text-on-dark-muted">Money Leak Status:</span>
              <span class="font-bold text-emerald-400" id="scene-leak-status">✓ Zero Ghost Labor Paid</span>
            </div>
          </div>
        </div>

        <!-- Right: Screen Projector Frame -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl border-2 border-navy-line bg-navy p-3 sm:p-4 shadow-[0_0_60px_rgba(58,70,225,0.25)] relative overflow-hidden">
            <!-- Screen Ticker HUD -->
            <div class="flex items-center justify-between px-3 py-2 border-b border-navy-line text-[10px] font-mono text-on-dark-muted mb-3">
              <span class="flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>PROJECTOR FEED</span>
              </span>
              <span id="projector-id">FEED // 01 • MUSTER SYNC</span>
            </div>

            <!-- Slide 1 -->
            <div id="movie-screen-1" class="movie-screen transition-all duration-500 ease-out">
              <Image
                src={storiesImg}
                alt="Site attendance and daily photo update feed"
                class="w-full h-auto rounded-xl object-cover max-h-[460px]"
                format="webp"
              />
            </div>

            <!-- Slide 2 -->
            <div id="movie-screen-2" class="movie-screen hidden transition-all duration-500 ease-out">
              <Image
                src={materialsImg}
                alt="Materials stock ledger and delivery intake"
                class="w-full h-auto rounded-xl object-cover max-h-[460px]"
                format="webp"
              />
            </div>

            <!-- Slide 3 -->
            <div id="movie-screen-3" class="movie-screen hidden transition-all duration-500 ease-out">
              <Image
                src={contractorImg}
                alt="Contractor ledger and advance settlement"
                class="w-full h-auto rounded-xl object-cover max-h-[460px]"
                format="webp"
              />
            </div>

            <!-- Slide 4 -->
            <div id="movie-screen-4" class="movie-screen hidden transition-all duration-500 ease-out">
              <Image
                src={spendImg}
                alt="Owner executive overview showing live funds"
                class="w-full h-auto rounded-xl object-cover max-h-[460px]"
                format="webp"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCENE 04 // THE OWNER'S COCKPIT (INTERACTIVE CONSOLE) -->
  <section id="tour" class="py-20 sm:py-28 border-b border-line bg-white relative">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10 space-y-3 reveal">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full">
          SCENE 04 // THE CONTROL ROOM
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-ink">
          Five operational channels. One unified cockpit.
        </h2>
        <p class="text-base text-muted">
          Click any channel to test-drive how Brift displays your live finances, inventory, and field progress without picking up the phone.
        </p>

        <!-- Channel Selectors -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-2">
          <button
            type="button"
            class="cockpit-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border-2 border-blue bg-blue text-white shadow-xs transition-all cursor-pointer"
            data-channel="money"
            onclick="switchCockpit('money')"
          >
            💰 Money Stream
          </button>
          <button
            type="button"
            class="cockpit-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer"
            data-channel="materials"
            onclick="switchCockpit('materials')"
          >
            📦 Cement & Steel
          </button>
          <button
            type="button"
            class="cockpit-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer"
            data-channel="workforce"
            onclick="switchCockpit('workforce')"
          >
            👷 Labor & Contractors
          </button>
          <button
            type="button"
            class="cockpit-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer"
            data-channel="reports"
            onclick="switchCockpit('reports')"
          >
            📊 7 Audit Reports
          </button>
          <button
            type="button"
            class="cockpit-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border border-line bg-white text-ink hover:border-blue transition-all cursor-pointer"
            data-channel="roles"
            onclick="switchCockpit('roles')"
          >
            🔒 Four Role Vaults
          </button>
        </div>
      </div>

      <!-- Cockpit Viewport -->
      <div class="rounded-3xl border border-line bg-bg p-6 sm:p-10 shadow-elevated">
        <!-- CHANNEL 1: MONEY -->
        <div id="cockpit-panel-money" class="cockpit-panel grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5 space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-blue bg-blue-soft px-3 py-1 rounded-full">
              Channel 01 // Financial Control
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-ink">
              Know where every single rupee is going in real-time.
            </h3>
            <p class="text-sm text-ink-2 leading-relaxed">
              Track project burn rate against initial budgets. Assigned site cash only reduces when real photographed bills are approved. Client receivables are mapped directly to project milestones.
            </p>
            <ul class="space-y-2.5 text-xs text-ink-2 pt-2">
              <li class="flex items-center gap-2">
                <span class="h-5 w-5 rounded-full bg-blue text-white flex items-center justify-center text-[10px] font-bold">✓</span>
                <span>Stage budget tracking with overrun early warnings</span>
